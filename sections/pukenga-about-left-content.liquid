<section
  class="pukenga-section section--full-width pukenga-about-left pukenga-about"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="section">

    <div class="pukenga-about-left__grid">

      <div class="pukenga-about-left__media">

        {%- if section.settings.image != blank -%}
          <img
            class="pukenga-about-left__image pukenga-about-left__image--desktop"
            src="{{ section.settings.image | image_url: width: 1800 }}"
            srcset="
              {{ section.settings.image | image_url: width: 800 }} 800w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1600 }} 1600w,
              {{ section.settings.image | image_url: width: 1800 }} 1800w
            "
            sizes="50vw"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.mobile_image != blank -%}
          <img
            class="pukenga-about-left__image pukenga-about-left__image--mobile"
            src="{{ section.settings.mobile_image | image_url: width: 1200 }}"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 500 }} 500w,
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w,
              {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
            width="{{ section.settings.mobile_image.width }}"
            height="{{ section.settings.mobile_image.height }}"
            alt="{{ section.settings.mobile_image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >
        {%- elsif section.settings.image != blank -%}
          <img
            class="pukenga-about-left__image pukenga-about-left__image--mobile"
            src="{{ section.settings.image | image_url: width: 1200 }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >
        {%- endif -%}

      </div>

      <div class="pukenga-about-left__content">

        {%- if section.settings.eyebrow != blank -%}
          <p class="pukenga-eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="pukenga-heading pukenga-about-left__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="pukenga-body pukenga-about-left__text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <p class="pukenga-about-left__signature">
            {{ section.settings.signature | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="pukenga-link pukenga-about-left__link"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}

      </div>

    </div>

  </div>
</section>


<style>

  .pukenga-about-left {
    width: 100%;
    background: {{ section.settings.background_color }};
    overflow: hidden;
  }


  .pukenga-about-left__grid {
    display: grid;
    grid-template-columns:
      {{ section.settings.desktop_image_width }}
      {{ section.settings.desktop_content_width }};
    gap: {{ section.settings.desktop_gap }}px;
    align-items: {{ section.settings.vertical_alignment }};
    width: 100%;
  }


  .pukenga-about-left__media {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    grid-column: 1;
    grid-row: 1;
    border-radius: {{ section.settings.image_border_radius }}px;
  }


  .pukenga-about-left__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .pukenga-about-left__image--desktop {
    display: block;
    aspect-ratio: {{ section.settings.desktop_image_ratio }};
    object-position:
      {{ section.settings.desktop_image_position_x }}%
      {{ section.settings.desktop_image_position_y }}%;
  }


  .pukenga-about-left__image--mobile {
    display: none;
  }


  .pukenga-about-left__content {
    width: 100%;
    min-width: 0;
    grid-column: 2;
    grid-row: 1;
  }


  .pukenga-about-left__heading {
    font-size: {{ section.settings.heading_max_size }}px;
    margin-top: 0;
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
  }


  .pukenga-about-left__text {
    font-size: 15.5px;
    line-height: 1.75;
    color: #ece5d4;
    opacity: 0.85;
    margin-bottom: {{ section.settings.text_margin_bottom }}px;
  }


  .pukenga-about-left__signature {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-style: italic;
    color: var(--pukenga-gold, #e0b784);
    margin: 0 0 {{ section.settings.signature_margin_bottom }}px;
  }


  .pukenga-about-left__link {
    display: inline-block;
  }


  @media screen and (max-width: 989px) {

    .pukenga-about-left__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }


    .pukenga-about-left__media {
      grid-column: 1;
      grid-row: 1;
      border-radius: {{ section.settings.mobile_image_border_radius }}px;
    }

    .pukenga-about-left__content {
        grid-column: 1;
        grid-row: 2;
        padding: 44px 26px 0;
        border-bottom: 1px solid      #313932;
    }


    .pukenga-about-left__image--desktop {
      display: none;
    }


    .pukenga-about-left__image--mobile {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: {{ section.settings.mobile_image_ratio }};
      object-fit: cover;
      object-position:
        {{ section.settings.mobile_image_position_x }}%
        {{ section.settings.mobile_image_position_y }}%;
    }

  }


  @media screen and (max-width: 749px) {

    .pukenga-about-left__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.12;
    }

  }

</style>


{% schema %}
