<div
  class="pukenga-announcement"
  style="
    --announcement-bg: {{ section.settings.background_color }};
    --announcement-text: {{ section.settings.text_color }};
  "
>
  <div class="pukenga-section section">
    <div class="pukenga-container pukenga-announcement__inner">

      {%- if section.settings.message != blank -%}
        <div class="pukenga-announcement__text">
          {{ section.settings.message }}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

<style>
  .pukenga-announcement {
    width: 100%;
    background-color: var(--announcement-bg) !important;
    color: var(--announcement-text) !important;
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
  }

  .pukenga-announcement .pukenga-section {
    width: 100%;
    background-color: transparent !important;
    color: inherit !important;
  }

  .pukenga-announcement__inner {
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.text_alignment }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .pukenga-announcement__text {
    margin: 0;
    padding: 0;
    color: var(--announcement-text) !important;
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    line-height: 1.4;
    letter-spacing: {{ section.settings.letter_spacing }}px;
    text-align: {{ section.settings.text_alignment }};
  }

  .pukenga-announcement__text * {
    color: inherit !important;
  }

  @media screen and (max-width: 749px) {

    .pukenga-announcement__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .pukenga-announcement__text {
      font-size: {{ section.settings.mobile_font_size }}px;
      line-height: 1.35;
    }

  }
</style>

{% schema %}
{
  "name": "Pukenga Announcement Bar",
  "tag": "section",
  "class": "section-pukenga-announcement",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "inline_richtext",
      "id": "message",
      "label": "Announcement text",
      "default": "He koha ki a koe. Use code KAHA10 for 10% off your first order."
    },

    {
      "type": "header",
      "content": "Colours"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#E0B784"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#16281B"
    },

    {
      "type": "header",
      "content": "Alignment"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },

    {
      "type": "header",
      "content": "Desktop"
    },


    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },

    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "px",
      "default": 0.2
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 6
    },

    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 5
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 5
    }

  ],

  "presets": [
    {
      "name": "Pukenga Announcement Bar"
    }
  ]
}
{% endschema %}