{{ 'pukenga-theme.css' | asset_url | stylesheet_tag }}

<div class="pukenga-announcement" style="background:{{ section.settings.background_color }};color:{{ section.settings.text_color }};">
  <div class="pukenga-container pukenga-announcement__inner">
    <p class="pukenga-announcement__text">
      {{ section.settings.message }}
      {%- if section.settings.code != blank -%}
        <span class="pukenga-announcement__code">{{ section.settings.code }}</span>
      {%- endif -%}
    </p>
  </div>
</div>

{% stylesheet %}
  .pukenga-announcement {
    font-family: var(--pukenga-font-body);
  }
  .pukenga-announcement__inner {
    padding: 10px 24px;
    text-align: center;
  }
  .pukenga-announcement__text {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.02em;
  }
  .pukenga-announcement__code {
    display: inline-block;
    margin-left: 8px;
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 40px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pukenga Announcement Bar",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Message",
      "default": "He koha ki a koe. Use code for 10% off your first order."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount code",
      "default": "KAHA10"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#16281b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f2ecdc"
    }
  ],
  "presets": [
    {
      "name": "Pukenga Announcement Bar"
    }
  ]
}
{% endschema %}
