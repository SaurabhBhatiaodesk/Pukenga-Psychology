{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .section-content-wrapper {
    font-family: var(--pukenga-font-heading, "Spectral", serif);
    font-weight: 300;
    line-height: 1.35;
  }

  /* Main headings — matches Pūkenga Hero */
  .section-content-wrapper h1 {
    font-family: var(--pukenga-font-heading, "Spectral", serif);
    font-weight: 300;
    font-size: 60px;
    line-height: 1.04;
    margin: 0 0 12px;
  }

  /* Secondary headings */
  .section-content-wrapper h2,
  .section-content-wrapper h3 {
    font-family: var(--pukenga-font-heading, "Spectral", serif);
    font-weight: 300;
    line-height: 1.05;
  }

  .section-content-wrapper h2 {
    font-size: 38px;
    margin: 0 0 12px;
  }

  .section-content-wrapper h3 {
    font-size: 30px;
    margin: 0 0 12px;
  }

  /* Body / supporting text — matches Hero subheading */
  .section-content-wrapper p {
    font-family: var(--pukenga-font-heading, "Spectral", serif);
    font-size: 26px;
    font-weight: 300;
    line-height: 1.35;
    margin: 0 0 30px;
  }

  /* Italic text — matches Hero subheading */
  .section-content-wrapper em,
  .section-content-wrapper i {
    font-style: italic;
  }

  /* Buttons — matches Pūkenga Hero */
  .section-content-wrapper .pukenga-btn,
  .section-content-wrapper a.button,
  .section-content-wrapper button {
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
  }

  /* Keep the section content spacing consistent with the Hero */
  .section-content-wrapper > * {
    margin-bottom: 12px;
  }

  .section-content-wrapper > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .section-content-wrapper {
      line-height: 1.35;
    }

    .section-content-wrapper h1 {
      font-size: 38px;
      line-height: 1.05;
      margin-bottom: 10px;
    }

    .section-content-wrapper h2 {
      font-size: 30px;
      line-height: 1.05;
      margin-bottom: 10px;
    }

    .section-content-wrapper h3 {
      font-size: 24px;
      line-height: 1.1;
      margin-bottom: 10px;
    }

    .section-content-wrapper p {
      font-size: 18px;
      line-height: 1.35;
      margin-bottom: 24px;
    }

    .section-content-wrapper > * {
      margin-bottom: 10px;
    }

    .section-content-wrapper > *:last-child {
      margin-bottom: 0;
    }

    .section-content-wrapper .pukenga-btn,
    .section-content-wrapper a.button,
    .section-content-wrapper button {
      font-size: 14px;
      font-weight: 600;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
