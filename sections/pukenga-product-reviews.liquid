{{ 'pukenga-theme.css' | asset_url | stylesheet_tag }}

<div class="pukenga-product-reviews pukenga-section section" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="pukenga-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="pukenga-heading pukenga-product-reviews__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pukenga-product-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="pukenga-product-reviews__item" {{ block.shopify_attributes }}>
          {%- if block.settings.rating > 0 -%}
            <div class="pukenga-product-reviews__stars" aria-hidden="true">
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}★{%- else -%}☆{%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.quote != blank -%}
            <p class="pukenga-product-reviews__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <p class="pukenga-product-reviews__name">{{ block.settings.name | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pukenga-product-reviews__heading {
    font-size: clamp(1.75rem, 3vw, 2.125rem);
    margin-bottom: 40px;
  }

  .pukenga-product-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .pukenga-product-reviews__item {
    border: 1px solid rgba(236, 229, 212, 0.14);
    border-radius: 12px;
    padding: 32px 28px;
  }

  .pukenga-product-reviews__stars {
    color: var(--pukenga-gold);
    font-size: 15px;
    margin-bottom: 14px;
  }

  .pukenga-product-reviews__quote {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-style: italic;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--pukenga-cream-soft);
    margin: 0 0 20px;
  }

  .pukenga-product-reviews__name {
    font-size: 13.5px;
    color: var(--pukenga-muted);
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .pukenga-product-reviews__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pūkenga Product Reviews",
  "tag": "section",
  "class": "section-pukenga-product-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Arotakenga · Reviews"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "I keep the smaller cards in my bag to use on the go and the larger ones on my desk. Thoroughly recommend."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name",
          "default": "Julie C."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pūkenga Product Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "I keep the smaller cards in my bag to use on the go and the larger ones on my desk. Thoroughly recommend.",
            "name": "Julie C."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "Utilise them with whānau and mahi when I get stumped for the right karakia. Ngā mihi maioha.",
            "name": "Rauweti S."
          }
        },
        {
          "type": "review",
          "settings": {
            "rating": 5,
            "quote": "Reconnecting me back to tikanga. I'm rediscovering my heritage. A true testament to relearn what was lost.",
            "name": "Vanessa P."
          }
        }
      ]
    }
  ]
}
{% endschema %}
