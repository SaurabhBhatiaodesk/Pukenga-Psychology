      "default": "50"
    },

    {
      "type": "select",
      "id": "image_position_y",
      "label": "Desktop image vertical position",
      "options": [
        { "value": "0", "label": "Top" },
        { "value": "25", "label": "Top centre" },
        { "value": "50", "label": "Centre" },
        { "value": "75", "label": "Bottom centre" },
        { "value": "100", "label": "Bottom" }
