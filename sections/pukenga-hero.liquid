{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
%}

<section class="pukenga-hero color-{{ section.settings.color_scheme }}">

  <div class="pukenga-hero__media">

    {% if section.settings.image != blank %}

      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 1800, 2200, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'pukenga-hero__image'
      }}

    {% else %}

      <img
        class="pukenga-hero__image"
        src="{{ 'pukenga-hero.jpg' | asset_url }}"
        alt="{{ heading | escape }}"
        loading="eager"
        fetchpriority="high"
        width="2400"
        height="1200"
      >

    {% endif %}

    <div class="pukenga-hero__overlay"></div>

  </div>


  <div class="pukenga-hero__content pukenga-container">

    {% if section.settings.eyebrow != blank %}
      <p class="pukenga-eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {% endif %}


    {% if heading != blank %}
      <h1 class="pukenga-hero__heading">
        {{ heading }}
      </h1>
    {% endif %}


    {% if subheading != blank %}
      <div class="pukenga-hero__subheading">
        {{ subheading }}
      </div>
    {% endif %}


    {% if section.settings.button_label != blank or section.settings.button_label_2 != blank %}

      <div class="pukenga-hero__actions">

        {% if section.settings.button_label != blank %}

          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="pukenga-btn pukenga-btn--primary"
          >
            {{ section.settings.button_label | escape }}
          </a>

        {% endif %}


        {% if section.settings.button_label_2 != blank %}

          <a
            href="{{ section.settings.button_link_2 | default: '#' }}"
            class="pukenga-btn pukenga-btn--outline"
          >
            {{ section.settings.button_label_2 | escape }}
          </a>

        {% endif %}

      </div>

    {% endif %}

  </div>

</section>


{% stylesheet %}

/* =========================================================
   PŪKENGA HERO
========================================================= */

.pukenga-hero {

  position: relative;

  width: 100%;

  min-height: {{ section.settings.hero_height }}px;

  overflow: hidden;

  background: {{ section.settings.fallback_background }};

}


/* =========================================================
   HERO IMAGE
========================================================= */

.pukenga-hero__media {

  position: absolute;

  inset: 0;

  width: 100%;

  height: 100%;

}


.pukenga-hero__image {

  display: block;

  width: 100%;

  height: 100%;

  object-fit: cover;

  object-position:
    {{ section.settings.image_position_x }}%
    {{ section.settings.image_position_y }}%;

}


/* =========================================================
   OVERLAY
========================================================= */

.pukenga-hero__overlay {

  position: absolute;

  inset: 0;

  background:
    {{ section.settings.overlay_color }};

  opacity:
    {{ section.settings.overlay_opacity | divided_by: 100.0 }};

}


/* =========================================================
   CONTENT
========================================================= */

.pukenga-hero__content {

  position: relative;

  z-index: 2;

  min-height: {{ section.settings.hero_height }}px;

  display: flex;

  flex-direction: column;

  align-items: {{ section.settings.content_alignment }};

  justify-content: {{ section.settings.content_vertical_alignment }};

  text-align: {{ section.settings.text_alignment }};

  max-width: {{ section.settings.content_max_width }}px;

  margin-left: auto;

  margin-right: auto;

  padding-top: {{ section.settings.content_padding_top }}px;

  padding-bottom: {{ section.settings.content_padding_bottom }}px;

  padding-left: 24px;

  padding-right: 24px;

}


/* =========================================================
   EYEBROW
========================================================= */

.pukenga-hero .pukenga-eyebrow {

  margin:

    0

    0

    {{ section.settings.eyebrow_spacing }}px;

  font-family:
    {{ section.settings.eyebrow_font }};

  font-size:
    {{ section.settings.eyebrow_size }}px;

  font-weight:
    {{ section.settings.eyebrow_weight }};

  line-height: 1.3;

  letter-spacing:
    {{ section.settings.eyebrow_letter_spacing }}em;

  text-transform:
    {{ section.settings.eyebrow_transform }};

  color:
    {{ section.settings.eyebrow_color }};

}


/* =========================================================
   HEADING
========================================================= */

.pukenga-hero__heading {

  margin:

    0

    0

    {{ section.settings.heading_spacing }}px;

  max-width:
    {{ section.settings.heading_max_width }}px;

  font-family:
    {{ section.settings.heading_font }};

  font-size:
    clamp(
      {{ section.settings.heading_mobile_size }}px,
      {{ section.settings.heading_responsive_size }}vw,
      {{ section.settings.heading_desktop_size }}px
    );

  font-weight:
    {{ section.settings.heading_weight }};

  line-height:
    {{ section.settings.heading_line_height }};

  letter-spacing:
    {{ section.settings.heading_letter_spacing }}em;

  text-transform:
    {{ section.settings.heading_transform }};

  color:
    {{ section.settings.heading_color }};

}


/* =========================================================
   SUBHEADING
========================================================= */

.pukenga-hero__subheading {

  max-width:
    {{ section.settings.subheading_max_width }}px;

  margin:

    0

    0

    {{ section.settings.subheading_spacing }}px;

  font-family:
    {{ section.settings.subheading_font }};

  font-size:
    {{ section.settings.subheading_size }}px;

  font-weight:
    {{ section.settings.subheading_weight }};

  font-style:
    {{ section.settings.subheading_style }};

  line-height:
    {{ section.settings.subheading_line_height }};

  letter-spacing:
    {{ section.settings.subheading_letter_spacing }}em;

  color:
    {{ section.settings.subheading_color }};

}


/* =========================================================
   BUTTON WRAPPER
========================================================= */

.pukenga-hero__actions {

  display: flex;

  align-items: center;

  justify-content: {{ section.settings.button_alignment }};

  flex-wrap: wrap;

  gap: {{ section.settings.button_gap }}px;

}


/* =========================================================
   BUTTONS
========================================================= */

.pukenga-hero .pukenga-btn {

  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-height:
    {{ section.settings.button_height }}px;

  padding:

    0

    {{ section.settings.button_padding }}px;

  border-radius:
    {{ section.settings.button_radius }}px;

  font-family:
    {{ section.settings.button_font }};

  font-size:
    {{ section.settings.button_font_size }}px;

  font-weight:
    {{ section.settings.button_font_weight }};

  letter-spacing:
    {{ section.settings.button_letter_spacing }}em;

  text-decoration: none;

  transition:

    background-color .25s ease,

    color .25s ease,

    border-color .25s ease,

    transform .25s ease;

}


/* PRIMARY */

.pukenga-hero .pukenga-btn--primary {

  background:
    {{ section.settings.primary_button_background }};

  color:
    {{ section.settings.primary_button_text }};

  border:
    {{ section.settings.primary_button_border_width }}px
    solid
    {{ section.settings.primary_button_border }};

}


.pukenga-hero .pukenga-btn--primary:hover {

  background:
    {{ section.settings.primary_button_hover_background }};

  color:
    {{ section.settings.primary_button_hover_text }};

  border-color:
    {{ section.settings.primary_button_hover_border }};

  transform: translateY(-2px);

}


/* OUTLINE */

.pukenga-hero .pukenga-btn--outline {

  background:
    {{ section.settings.secondary_button_background }};

  color:
    {{ section.settings.secondary_button_text }};

  border:
    {{ section.settings.secondary_button_border_width }}px
    solid
    {{ section.settings.secondary_button_border }};

}


.pukenga-hero .pukenga-btn--outline:hover {

  background:
    {{ section.settings.secondary_button_hover_background }};

  color:
    {{ section.settings.secondary_button_hover_text }};

  border-color:
    {{ section.settings.secondary_button_hover_border }};

  transform: translateY(-2px);

}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 749px) {

  .pukenga-hero {

    min-height:
      {{ section.settings.mobile_hero_height }}px;

  }


  .pukenga-hero__content {

    min-height:
      {{ section.settings.mobile_hero_height }}px;

    padding-top:
      {{ section.settings.mobile_content_padding_top }}px;

    padding-bottom:
      {{ section.settings.mobile_content_padding_bottom }}px;

    padding-left:
      {{ section.settings.mobile_content_padding_horizontal }}px;

    padding-right:
      {{ section.settings.mobile_content_padding_horizontal }}px;

  }


  .pukenga-hero__image {

    object-position:
      {{ section.settings.mobile_image_position_x }}%
      {{ section.settings.mobile_image_position_y }}%;

  }


  .pukenga-hero .pukenga-eyebrow {

    font-size:
      {{ section.settings.mobile_eyebrow_size }}px;

  }


  .pukenga-hero__heading {

    font-size:
      {{ section.settings.mobile_heading_size }}px;

    line-height:
      {{ section.settings.mobile_heading_line_height }};

    max-width:
      {{ section.settings.mobile_heading_max_width }}px;

  }


  .pukenga-hero__subheading {

    font-size:
      {{ section.settings.mobile_subheading_size }}px;

    line-height:
      {{ section.settings.mobile_subheading_line_height }};

    max-width:
      {{ section.settings.mobile_subheading_max_width }}px;

  }


  .pukenga-hero__actions {

    width: 100%;

    flex-direction:
      {{ section.settings.mobile_button_direction }};

    gap:
      {{ section.settings.mobile_button_gap }}px;

  }


  .pukenga-hero .pukenga-btn {

    width:
      {{ section.settings.mobile_button_width }};

    min-height:
      {{ section.settings.mobile_button_height }}px;

    font-size:
      {{ section.settings.mobile_button_font_size }}px;

  }

}

{% endstylesheet %}


{% schema %}
