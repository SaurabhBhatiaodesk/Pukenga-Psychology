{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign width_class = 'section--page-width'
  if section.settings.section_width == 'full-width'
    assign width_class = 'section--full-width'
  endif
%}

<section class="pukenga-hero section {{ width_class }} color-{{ section.settings.color_scheme }}" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="pukenga-hero__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image.alt | default: heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <img width="" height=""
        src="{{ 'pukenga-hero.jpg' | asset_url }}"
        alt="{{ heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="pukenga-hero__overlay pukenga-hero__overlay--vertical"></div>
    <div class="pukenga-hero__overlay pukenga-hero__overlay--diagonal"></div>
  </div>

  <div class="pukenga-hero__content section pukenga-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pukenga-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if heading != blank -%}
      <h1 class="pukenga-hero__heading">{{ heading }}</h1>
    {%- endif -%}
    {%- if subheading != blank -%}
      <div class="pukenga-hero__subheading">{{ subheading }}</div>
    {%- endif -%}
    <div class="pukenga-hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="pukenga-btn pukenga-btn--primary"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a
          href="{{ section.settings.button_link_2 | default: '#' }}"
          class="pukenga-btn pukenga-btn--outline"
        >
          {{ section.settings.button_label_2 | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pukenga-hero {
    position: relative;
    overflow: hidden;
    background: var(--pukenga-bg, #16281b);
    min-height: 780px;
  }

  .pukenga-hero__media {
    position: absolute;
    inset: 0;
  }

  .pukenga-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .pukenga-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .pukenga-hero__overlay--vertical {
    background: linear-gradient(
      rgba(10, 22, 15, 0.44) 0%,
      rgba(10, 22, 15, 0.34) 42%,
      rgba(10, 22, 15, 0.76) 100%
    );
  }

  .pukenga-hero__overlay--diagonal {
    background: rgba(8, 16, 11, 0.24);
  }

  .pukenga-hero__content {
    position: relative;
    z-index: 1;
    min-height: 780px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding-top: 120px;
    padding-bottom: 50px;
  }

  .pukenga-hero__heading {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-weight: 300;
    font-size: clamp(3.75rem, 5.2vw, 5.25rem);
    line-height: 1.02;
    color: var(--pukenga-cream, #f2ecdc);
    margin: 0 0 18px;
    max-width: 980px;
  }

  .pukenga-hero__subheading {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-size: 27px;
    font-style: italic;
    line-height: 1.35;
    color: var(--pukenga-cream-soft, #ece5d4);
    margin: 0 0 32px;
    max-width: 720px;
  }

  .pukenga-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
  }

  .pukenga-hero__actions .pukenga-btn {
    min-width: 148px;
    padding: 17px 38px;
  }

  @media screen and (max-width: 749px) {
    .pukenga-hero {
      height: 500px;
      min-height: 0;
    }

    .pukenga-hero__media img {
      object-position: 50% 25%;
    }

    .pukenga-hero__overlay--diagonal {
      display: none;
    }

    .pukenga-hero__overlay--vertical {
      background: linear-gradient(rgba(15, 25, 15, 0.5) 0%, rgba(15, 25, 15, 0.1) 30%, rgba(15, 25, 15, 0.82) 100%);
    }

    .pukenga-hero__content {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 34px;
      min-height: 0;
      display: block;
      text-align: center;
      padding: 0 26px;
    }

    .pukenga-hero__heading {
      font-size: 38px;
      line-height: 1.05;
      margin-bottom: 10px;
    }

    .pukenga-hero__subheading {
      font-style: italic;
      font-size: 18px;
      opacity: 0.85;
      margin: 0 auto 24px;
    }

    .pukenga-hero__actions {
      flex-direction: column;
      gap: 11px;
    }

    .pukenga-hero__actions .pukenga-btn {
      width: 100%;
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pūkenga Hero",
  "tag": "section",
  "class": "section-pukenga-hero",
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" }
      ],
      "default": "full-width"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Oranga Ngākau"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Whakatōngia te karakia"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Plant karakia into the rhythm of your day</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Hokona · Shop packs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Mauri Tau"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Pūkenga Hero"
    }
  ]
}
{% endschema %}
