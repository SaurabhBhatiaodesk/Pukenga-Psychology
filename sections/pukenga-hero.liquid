{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
%}

<section class="pukenga-hero section section--full-width color-{{ section.settings.color_scheme }}" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="pukenga-hero__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image.alt | default: heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <img width="" height=""
        src="{{ 'pukenga-hero.jpg' | asset_url }}"
        alt="{{ heading | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
    <div class="pukenga-hero__overlay pukenga-hero__overlay--vertical"></div>
    <div class="pukenga-hero__overlay pukenga-hero__overlay--diagonal"></div>
  </div>

  <div class="pukenga-hero__content section pukenga-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pukenga-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if heading != blank -%}
      <h1 class="pukenga-hero__heading">{{ heading }}</h1>
    {%- endif -%}
    {%- if subheading != blank -%}
      <div class="pukenga-hero__subheading">{{ subheading }}</div>
    {%- endif -%}
    <div class="pukenga-hero__actions">
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="pukenga-btn pukenga-btn--primary"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a
          href="{{ section.settings.button_link_2 | default: '#' }}"
          class="pukenga-btn pukenga-btn--outline"
        >
          {{ section.settings.button_label_2 | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pukenga-hero {
    position: relative;
    overflow: hidden;
    background: var(--pukenga-bg, #16281b);
  }

  .pukenga-hero__media {
    position: absolute;
    inset: 0;
  }

  .pukenga-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pukenga-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .pukenga-hero__overlay--vertical {
    background: linear-gradient(rgba(15, 25, 15, 0.5) 0%, rgba(15, 25, 15, 0.1) 35%, rgba(15, 25, 15, 0.75) 100%);
  }

  .pukenga-hero__overlay--diagonal {
    background: linear-gradient(90deg, rgba(15, 25, 15, 0.85) 0%, rgba(15, 25, 15, 0.5) 60%, rgba(15, 25, 15, 0.2) 100%);
  }

  .pukenga-hero__content {
    position: relative;
    z-index: 1;
    padding-top: 120px;
    padding-bottom: 72px;
  }

  .pukenga-hero__heading {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-weight: 300;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    color: var(--pukenga-cream, #f2ecdc);
    margin: 0 0 20px;
  }

  .pukenga-hero__subheading {
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
    font-size: 17px;
    line-height: 1.6;
    color: var(--pukenga-cream-soft, #ece5d4);
    margin: 0 0 32px;
    max-width: 480px;
  }

  .pukenga-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  @media screen and (max-width: 749px) {
    .pukenga-hero {
      min-height: 520px;
    }

    .pukenga-hero__content {
      padding-top: 90px;
      padding-bottom: 48px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pūkenga Hero",
  "tag": "section",
  "class": "section-pukenga-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Oranga Ngākau"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Whakatōngia te karakia"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Plant karakia into the rhythm of your day</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "Hokona · Shop packs"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary button label",
      "default": "Mauri Tau"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Pūkenga Hero"
    }
  ]
}
{% endschema %}
