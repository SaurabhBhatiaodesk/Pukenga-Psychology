<div class="pukenga-product-accordion pukenga-section section">
  <div class="pukenga-container pukenga-product-accordion__inner">
    {%- for block in section.blocks -%}
      {%- if block.type == 'item' -%}
        <details class="pukenga-accordion__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary class="pukenga-accordion__trigger">
            {{ block.settings.heading }}
            <span class="pukenga-accordion__icon" aria-hidden="true">
              <span class="pukenga-accordion__icon-open">−</span>
              <span class="pukenga-accordion__icon-closed">+</span>
            </span>
          </summary>
          <div class="pukenga-accordion__panel">
            <div class="pukenga-accordion__panel-inner">
              <div class="pukenga-accordion__body">{{ block.settings.body }}</div>
            </div>
          </div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .pukenga-product-accordion {
    padding-block: 0 56px;
  }

  .pukenga-product-accordion__inner {
    max-width: 620px;
  }

  .pukenga-accordion__item summary {
    list-style: none;
  }

  .pukenga-accordion__item summary::-webkit-details-marker {
    display: none;
  }

  .pukenga-accordion__icon-open {
    display: none;
  }

  .pukenga-accordion__item[open] .pukenga-accordion__icon-open {
    display: inline;
  }

  .pukenga-accordion__item[open] .pukenga-accordion__icon-closed {
    display: none;
  }
{% endstylesheet %}

