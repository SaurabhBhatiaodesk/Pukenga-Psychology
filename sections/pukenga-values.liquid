<section class="pukenga-values" id="pukenga-values-{{ section.id }}">
  <div class="pukenga-values__inner" data-pukenga-values-slider>
    {%- for block in section.blocks -%}
      <div class="pukenga-values__item" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="pukenga-values__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <div class="pukenga-values__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="pukenga-values__dots" data-pukenga-values-dots aria-label="Pukenga values navigation">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="pukenga-values__dot{% if forloop.first %} is-active{% endif %}"
          data-pukenga-values-dot
          aria-label="Go to value {{ forloop.index }}"
          {% if forloop.first %}
            aria-current="true"
          {% endif %}
        ></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  #pukenga-values-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
  }

  #pukenga-values-{{ section.id }} .pukenga-values__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1440px;
    margin: 0 auto;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__item {
    min-width: 0;
    padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
    text-align: center;
    border-right: 1px solid {{ section.settings.divider_color }};
  }

  #pukenga-values-{{ section.id }} .pukenga-values__item:last-child {
    border-right: 0;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__heading {
    margin: 0 0 12px;
    color: {{ section.settings.heading_color }};
    font-family: Marcellus, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__text {
    max-width: 360px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.75;
    font-family: 'Instrument Sans', system-ui, sans-serif;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__text p {
    margin: 0;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__dots {
    display: none;
  }

  @media screen and (max-width: 749px) {
    #pukenga-values-{{ section.id }} .pukenga-values__inner {
      display: flex;
      max-width: none;
      margin: 0;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }

    #pukenga-values-{{ section.id }} .pukenga-values__inner::-webkit-scrollbar {
      display: none;
    }

    #pukenga-values-{{ section.id }} .pukenga-values__item {
      flex: 0 0 100%;
      padding: {{ section.settings.mobile_padding_y }}px 24px;
      border-right: 0;
      border-bottom: 0;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    #pukenga-values-{{ section.id }} .pukenga-values__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      padding: 0 0 18px;
    }

    #pukenga-values-{{ section.id }} .pukenga-values__dot {
      width: 7px;
      height: 7px;
      padding: 0;
      border: 0;
      border-radius: 999px;
      background: rgba(216, 211, 197, 0.35);
      cursor: pointer;
    }

    #pukenga-values-{{ section.id }} .pukenga-values__dot.is-active {
      width: 18px;
      background: {{ section.settings.heading_color }};
    }
  }
</style>

<script>
  (function () {
    const section = document.getElementById('pukenga-values-{{ section.id }}');
    if (!section) return;

    const slider = section.querySelector('[data-pukenga-values-slider]');
    const dots = Array.from(section.querySelectorAll('[data-pukenga-values-dot]'));
    const items = Array.from(section.querySelectorAll('.pukenga-values__item'));

    if (!slider || dots.length < 2 || items.length < 2) return;

    let ticking = false;

    function setActiveDot(index) {
      dots.forEach(function (dot, dotIndex) {
        const isActive = dotIndex === index;
        dot.classList.toggle('is-active', isActive);

        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    }

    function updateActiveDot() {
      let activeIndex = 0;
      let closestDistance = Infinity;

      items.forEach(function (item, index) {
        const distance = Math.abs(item.offsetLeft - slider.scrollLeft);

        if (distance < closestDistance) {
          closestDistance = distance;
          activeIndex = index;
        }
      });

      setActiveDot(activeIndex);
    }

    dots.forEach(function (dot, index) {
      dot.addEventListener('click', function () {
        slider.scrollTo({
          left: items[index].offsetLeft,
          behavior: 'smooth'
        });
      });
    });

    slider.addEventListener('scroll', function () {
      if (ticking) return;

      ticking = true;

      window.requestAnimationFrame(function () {
        updateActiveDot();
        ticking = false;
      });
    });

    window.addEventListener('resize', updateActiveDot);
    updateActiveDot();
  })();
</script>

{% schema %}
{
  "name": "Pukenga Values",
  "tag": "section",
  "class": "section-pukenga-values",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#10291B"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#E5B76D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#D8D3C5"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#304637"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_y",
      "label": "Mobile vertical padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Matauranga"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Bring Te Ao Maori into everyday life.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pukenga Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Matauranga",
            "text": "<p>Bring Te Ao Maori into everyday life.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Mo te katoa",
            "text": "<p>Taonga made for ages 5+, can be used anywhere, anytime.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Hauora",
            "text": "<p>Settle and nourish your mauri.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
