<section class="pukenga-values" id="pukenga-values-{{ section.id }}">
  <div class="pukenga-values__inner">
    {%- for block in section.blocks -%}
      <div class="pukenga-values__item" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="pukenga-values__heading">{{ block.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if block.settings.text != blank -%}
          <div class="pukenga-values__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  #pukenga-values-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
  }

  #pukenga-values-{{ section.id }} .pukenga-values__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1440px;
    margin: 0 auto;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__item {
    min-width: 0;
    padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
    text-align: center;
    border-right: 1px solid {{ section.settings.divider_color }};
  }

  #pukenga-values-{{ section.id }} .pukenga-values__item:last-child {
    border-right: 0;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__heading {
    margin: 0 0 12px;
    color: {{ section.settings.heading_color }};
    font-family: Marcellus, serif;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__text {
    max-width: 360px;
    margin: 0 auto;
    font-size: 14px;
    line-height: 1.6;
    opacity: 0.75;
    font-family: 'Instrument Sans', system-ui, sans-serif;
  }

  #pukenga-values-{{ section.id }} .pukenga-values__text p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    #pukenga-values-{{ section.id }} .pukenga-values__inner {
      grid-template-columns: 1fr;
    }

    #pukenga-values-{{ section.id }} .pukenga-values__item {
      padding: {{ section.settings.mobile_padding_y }}px 24px;
      border-right: 0;
      border-bottom: 1px solid {{ section.settings.divider_color }};
    }

    #pukenga-values-{{ section.id }} .pukenga-values__item:last-child {
      border-bottom: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Pukenga Values",
  "tag": "section",
  "class": "section-pukenga-values",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#10291B"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#E5B76D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#D8D3C5"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#304637"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal padding",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_y",
      "label": "Mobile vertical padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 35
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Matauranga"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Bring Te Ao Maori into everyday life.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pukenga Values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Matauranga",
            "text": "<p>Bring Te Ao Maori into everyday life.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Mo te katoa",
            "text": "<p>Taonga made for ages 5+, can be used anywhere, anytime.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "heading": "Hauora",
            "text": "<p>Settle and nourish your mauri.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
