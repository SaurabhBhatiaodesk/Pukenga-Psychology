<section
  id="pukenga-values-{{ section.id }}"
  class="pukenga-values-section"
>
  <div class="section pukenga-container">
    <div class="pukenga-values">

      {% for block in section.blocks %}
        <div
          class="pukenga-value"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.heading != blank %}
            <h3 class="pukenga-value__heading">
              {{ block.settings.heading | escape }}
            </h3>
          {% endif %}

          {% if block.settings.text != blank %}
            <div class="pukenga-value__text">
              {{ block.settings.text }}
            </div>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>
</section>


<style>
  #pukenga-values-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #pukenga-values-{{ section.id }} .pukenga-values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  #pukenga-values-{{ section.id }} .pukenga-value {
    min-width: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.column_padding }}px;
    padding-right: {{ section.settings.column_padding }}px;

    border-right: 1px solid {{ section.settings.divider_color }};
  }

  #pukenga-values-{{ section.id }} .pukenga-value:last-child {
    border-right: none;
  }

  #pukenga-values-{{ section.id }} .pukenga-value__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;

    font-family: {{ section.settings.heading_font }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.2;

    color: {{ section.settings.heading_color }};
  }

  #pukenga-values-{{ section.id }} .pukenga-value__text {
    max-width: {{ section.settings.text_max_width }}px;

    font-family: {{ section.settings.body_font }};
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight }};
    line-height: {{ section.settings.text_line_height }};

    color: {{ section.settings.text_color }};
  }

  #pukenga-values-{{ section.id }} .pukenga-value__text p {
    margin: 0;
  }


  @media screen and (max-width: 749px) {

    #pukenga-values-{{ section.id }} .pukenga-values {
      grid-template-columns: 1fr;
    }

    #pukenga-values-{{ section.id }} .pukenga-value {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_column_padding }}px;
      padding-right: {{ section.settings.mobile_column_padding }}px;

      border-right: none;
      border-bottom: 1px solid {{ section.settings.divider_color }};
    }

    #pukenga-values-{{ section.id }} .pukenga-value:last-child {
      border-bottom: none;
    }

    #pukenga-values-{{ section.id }} .pukenga-value__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #pukenga-values-{{ section.id }} .pukenga-value__text {
      font-size: {{ section.settings.mobile_text_size }}px;
    }
  }
</style>


{% schema %}
{
  "name": "Pūkenga Values",
  "tag": "section",
  "class": "section-pukenga-values",

  "settings": [

    {
      "type": "header",
      "content": "Colours"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#10291B"
    },

    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#E5B76D"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#D8D3C5"
    },

    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider colour",
      "default": "#304637"
    },


    {
      "type": "header",
      "content": "Desktop spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },

    {
      "type": "range",
      "id": "column_padding",
      "label": "Column horizontal spacing",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },


    {
      "type": "header",
      "content": "Heading"
    },

    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 25
    },

    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },

    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading bottom spacing",
      "min": 4,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },

    {
      "type": "select",
      "id": "heading_font",
      "label": "Heading font",
      "options": [
        {
          "value": "var(--pukenga-font-heading, 'Spectral', serif)",
          "label": "Heading font"
        },
        {
          "value": "var(--pukenga-font-body, 'Instrument Sans', sans-serif)",
          "label": "Body font"
        }
      ],
      "default": "var(--pukenga-font-heading, 'Spectral', serif)"
    },


    {
      "type": "header",
      "content": "Text"
    },

    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        }
      ],
      "default": "400"
    },

    {
      "type": "range",
      "id": "text_line_height",
      "label": "Text line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "unit": "x",
      "default": 1.5
    },

    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text maximum width",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 360
    },

    {
      "type": "select",
      "id": "body_font",
      "label": "Text font",
      "options": [
        {
          "value": "var(--pukenga-font-body, 'Instrument Sans', sans-serif)",
          "label": "Body font"
        },
        {
          "value": "var(--pukenga-font-heading, 'Spectral', serif)",
          "label": "Heading font"
        }
      ],
      "default": "var(--pukenga-font-body, 'Instrument Sans', sans-serif)"
    },


    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 35
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 35
    },

    {
      "type": "range",
      "id": "mobile_column_padding",
      "label": "Mobile horizontal spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 23
    },

    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Mobile text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    }

  ],

  "blocks": [

    {
      "type": "value",
      "name": "Value",

      "settings": [

        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Mātauranga"
        },

        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Bring Te Ao Māori into everyday life.</p>"
        }

      ]
    }

  ],

  "presets": [
    {
      "name": "Pūkenga Values",

      "blocks": [
        {
          "type": "value",
          "settings": {
            "heading": "Mātauranga",
            "text": "<p>Bring Te Ao Māori into everyday life.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
