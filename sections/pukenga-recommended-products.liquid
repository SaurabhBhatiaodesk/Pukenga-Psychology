{{ 'pukenga-theme.css' | asset_url | stylesheet_tag }}

<section
  class="pukenga-best-sellers pukenga-recommended"
  id="recommended-products-{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="section">
    <div class="pukenga-best-sellers__header">
      <div class="pukenga-best-sellers__title-wrap">
        {%- if section.settings.heading != blank -%}
          <h2 class="pukenga-heading pukenga-best-sellers__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if section.settings.eyebrow != blank -%}
          <span class="pukenga-best-sellers__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </span>
        {%- endif -%}
      </div>
    </div>

    <div
      class="pukenga-recommended__content"
      data-recommendations-content
      {% if product != blank %}
        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.recommendation_type }}"
      {% endif %}
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="pukenga-best-sellers__grid">
          {%- for product in recommendations.products limit: section.settings.products_to_show -%}
            {%- assign current_variant = product.selected_or_first_available_variant -%}

            <article class="pukenga-product-card">
              <div class="pukenga-product-card__media">
                <a
                  href="{{ product.url }}"
                  class="pukenga-product-card__image-link"
                  aria-label="{{ product.title | escape }}"
                >
                 {%- if product.featured_image != blank -%}

                    {{
                    product.featured_image
                    | image_url: width: 1200
                    | image_tag:
                        loading: 'lazy',
                        class: 'pukenga-product-card__image',
                        widths: '500, 700, 900, 1200',
                        sizes: '(min-width: 990px) 33vw, (min-width: 550px) 50vw, 100vw'
                    }}

                    {%- if product.images.size > 1 -%}

                    {{
                    product.images[1]
                    | image_url: width: 1200
                    | image_tag:
                        loading: 'lazy',
                        class: 'pukenga-product-card__image pukenga-product-card__image--hover',
                        widths: '500, 700, 900, 1200',
                        sizes: '(min-width: 990px) 33vw, (min-width: 550px) 50vw, 100vw'
                    }}

                    {%- endif -%}

                    {%- endif -%}
                </a>

                {%- if product.compare_at_price > product.price -%}
                  <span class="pukenga-product-card__badge">
                    {{ section.settings.sale_label | escape }}
                  </span>
                {%- endif -%}
              </div>

              <div class="pukenga-product-card__info">
                <h3 class="pukenga-product-card__title">
                  <a href="{{ product.url }}">
                    {{ product.title }}
                  </a>
                </h3>

                <div class="pukenga-product-card__bottom">
                  <div class="pukenga-product-card__price">
                    <span class="pukenga-product-card__price-current">
                      {{ product.price | money }}
                    </span>

                    {%- if product.compare_at_price > product.price -%}
                      <s class="pukenga-product-card__compare">
                        {{ product.compare_at_price | money }}
                      </s>
                    {%- endif -%}
                  </div>

                  {%- if current_variant.available -%}
                    <button
                      type="button"
                      class="pukenga-product-card__add"
                      data-pukenga-recommended-add
                      data-variant-id="{{ current_variant.id }}"
                      aria-label="Add {{ product.title | escape }} to cart"
                    >
                      {{ section.settings.add_button_label | escape }}
                    </button>
                  {%- else -%}
                    <button
                      type="button"
                      class="pukenga-product-card__add pukenga-product-card__add--disabled"
                      disabled
                    >
                      {{ section.settings.sold_out_label | escape }}
                    </button>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- elsif recommendations.performed -%}
        <div class="pukenga-best-sellers__empty">
          <p>{{ section.settings.empty_text | escape }}</p>
        </div>
      {%- endif -%}
    </div>

    <div
      class="pukenga-recommended__dots"
      aria-label="Recommended products navigation"
      data-recommended-dots
    ></div>
  </div>
</section>

<style>
  .pukenga-recommended {
    width: 100%;
    background: var(--pukenga-bg, #0f2116);
    color: var(--pukenga-cream, #f2ecdc);
  }
    .pukenga-recommended .pukenga-best-sellers__header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
    }
  .pukenga-recommended .pukenga-best-sellers__title-wrap {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pukenga-recommended .pukenga-best-sellers__heading {
    margin: 0;
    color: var(--pukenga-cream, #f2ecdc);
    font-size: 30px;
    line-height: 1.1;
    font-weight: 300;
  }

  .pukenga-recommended .pukenga-best-sellers__eyebrow {
    color: var(--pukenga-muted, #a8a087);
    font-family: var(--pukenga-font-heading, 'Spectral', Georgia, serif);
    font-size: 28px;
    font-style: italic;
    font-weight: 300;
    line-height: 1.1;
  }

    .pukenga-recommended .pukenga-best-sellers__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 25px;
    }

  .pukenga-recommended .pukenga-product-card {
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
    background: #1d3826;
  }

  .pukenga-recommended .pukenga-product-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #17291d;
  }

  .pukenga-recommended .pukenga-product-card__image-link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .pukenga-recommended .pukenga-product-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.35s ease, transform 0.45s ease;
  }

  .pukenga-recommended .pukenga-product-card__image--hover {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
  }

@media (hover: hover) and (pointer: fine) {

  .pukenga-product-card:has(.pukenga-product-card__image--hover):hover 
  .pukenga-product-card__image--hover {
    opacity: 1;
  }

  .pukenga-product-card:has(.pukenga-product-card__image--hover):hover 
  .pukenga-product-card__image:not(.pukenga-product-card__image--hover) {
    opacity: 0;
  }

}

  .pukenga-recommended .pukenga-product-card__placeholder {
    width: 100%;
    height: 100%;
  }

    .pukenga-recommended .pukenga-product-card__badge {
        position: absolute;
        top: 16px;
        left: 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
        font-weight: 400;
        line-height: 1;
        background: rgb(192, 84, 55);
        color: rgb(255, 255, 255);
        font-size: 11px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 5px 12px;
        border-radius: 40px;
        z-index: 2;
    }

  .pukenga-recommended .pukenga-product-card__info {
    padding: 25px 25px 26px;
  }

  .pukenga-recommended .pukenga-product-card__title {
    margin: 0 0 14px;
    font-family: var(--pukenga-font-heading, 'Spectral', Georgia, serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--pukenga-cream, #f2ecdc);
  }

  .pukenga-recommended .pukenga-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .pukenga-recommended .pukenga-product-card__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .pukenga-recommended .pukenga-product-card__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 7px;
    min-width: 0;
  }

  .pukenga-recommended .pukenga-product-card__price-current {
    color: var(--pukenga-gold, #e0b784);
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
    font-size: 17px;
    line-height: 1.3;
  }

  .pukenga-recommended .pukenga-product-card__compare {
    color: rgba(168, 160, 135, 0.7);
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
    font-size: 13px;
    line-height: 1.3;
  }

  .pukenga-recommended .pukenga-product-card__add {
    flex-shrink: 0;
    min-width: 72px;
    min-height: 40px;
    padding: 8px 17px;
    border: 1px solid rgba(224, 183, 132, 0.65);
    border-radius: 40px;
    background: transparent;
    color: var(--pukenga-gold, #e0b784);
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .pukenga-recommended .pukenga-product-card__add:hover {
    background: var(--pukenga-gold, #e0b784);
    border-color: var(--pukenga-gold, #e0b784);
    color: #16281b;
  }

  .pukenga-recommended .pukenga-product-card__add--disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .pukenga-recommended .pukenga-product-card__add--loading {
    opacity: 0.6;
    pointer-events: none;
  }

  .pukenga-recommended .pukenga-best-sellers__empty {
    padding: 40px 0;
    color: var(--pukenga-cream-soft, #ece5d4);
  }

  .pukenga-recommended__dots {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .pukenga-recommended .pukenga-best-sellers__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .pukenga-recommended .pukenga-best-sellers__heading {
      font-size: 36px;
    }
  }

  @media screen and (max-width: 749px) {
    .pukenga-recommended {
      padding-top: {{ section.settings.mobile_padding_top }}px !important;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px !important;
    }

    .pukenga-recommended .pukenga-best-sellers__header {
      align-items: flex-start;
      margin-bottom: 30px;
    }

    .pukenga-recommended .pukenga-best-sellers__title-wrap {
      gap: 8px;
    }

    .pukenga-recommended .pukenga-best-sellers__heading {
      font-size: 30px;
    }

    .pukenga-recommended .pukenga-best-sellers__eyebrow {
      font-size: 21px;
    }

    .pukenga-recommended .pukenga-recommended__content {
      margin-right: -20px;
    }

    .pukenga-recommended .pukenga-best-sellers__grid {
      display: flex;
      width: 100%;
      gap: {{ section.settings.mobile_grid_gap }}px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
      overscroll-behavior-x: contain;
      padding-right: 20px;
    }

    .pukenga-recommended .pukenga-best-sellers__grid::-webkit-scrollbar {
      display: none;
    }

    .pukenga-recommended .pukenga-product-card {
      flex: 0 0 calc(
        (
          100% -
          (
            {{ section.settings.mobile_columns }} - 1
          ) *
          {{ section.settings.mobile_grid_gap }}px
        ) /
        {{ section.settings.mobile_columns }}
      );

      width: calc(
        (
          100% -
          (
            {{ section.settings.mobile_columns }} - 1
          ) *
          {{ section.settings.mobile_grid_gap }}px
        ) /
        {{ section.settings.mobile_columns }}
      );

      min-width: calc(
        (
          100% -
          (
            {{ section.settings.mobile_columns }} - 1
          ) *
          {{ section.settings.mobile_grid_gap }}px
        ) /
        {{ section.settings.mobile_columns }}
      );

      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    .pukenga-recommended .pukenga-product-card__media {
      aspect-ratio: 4 / 5;
    }

    .pukenga-recommended .pukenga-product-card__info {
      padding: 20px;
    }

    .pukenga-recommended .pukenga-product-card__price-current {
      font-size: 15px;
    }

    .pukenga-recommended .pukenga-product-card__title {
      font-size: 19px;
      margin-bottom: 8px;
    }

    .pukenga-recommended__dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      margin-top: 24px;
    }

    .pukenga-recommended__dot {
      display: block;
      width: 10px;
      height: 10px;
      padding: 0;
      margin: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(242, 236, 220, 0.28);
      cursor: pointer;
      appearance: none;
      -webkit-appearance: none;
      transition:
        width 0.25s ease,
        background 0.25s ease,
        border-radius 0.25s ease;
    }

    .pukenga-recommended__dot.is-active {
      width: 26px;
      border-radius: 10px;
      background: var(--pukenga-gold, #e0b784);
    }
  }

  @media screen and (max-width: 480px) {
    .pukenga-recommended .pukenga-best-sellers__header {
      display: block;
    }

    .pukenga-recommended .pukenga-product-card__bottom {
      gap: 12px;
    }
  }
</style>

<script>
  (function () {
    const section = document.getElementById('recommended-products-{{ section.id }}');
    if (!section) return;

    const content = section.querySelector('[data-recommendations-content]');
    const url = content && content.dataset.url;
    const dotsContainer = section.querySelector('[data-recommended-dots]');
    let dotCleanup;

    function setupMobileDots() {
      const slider = section.querySelector('.pukenga-best-sellers__grid');
      const cards = slider ? Array.from(slider.querySelectorAll('.pukenga-product-card')) : [];

      if (!slider || !dotsContainer || cards.length <= 1) {
        if (dotsContainer) dotsContainer.innerHTML = '';
        return;
      }

      if (dotCleanup) dotCleanup();

      dotsContainer.innerHTML = '';

      cards.forEach(function (card, index) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'pukenga-recommended__dot' + (index === 0 ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Go to recommended product ' + (index + 1));

        dot.addEventListener('click', function () {
          slider.scrollTo({
            left: card.offsetLeft,
            behavior: 'smooth'
          });
        });

        dotsContainer.appendChild(dot);
      });

      const dots = Array.from(dotsContainer.querySelectorAll('.pukenga-recommended__dot'));
      let ticking = false;

      function updateActiveDot() {
        let closestIndex = 0;
        let closestDistance = Infinity;

        cards.forEach(function (card, index) {
          const distance = Math.abs(card.offsetLeft - slider.scrollLeft);

          if (distance < closestDistance) {
            closestDistance = distance;
            closestIndex = index;
          }
        });

        dots.forEach(function (dot, index) {
          dot.classList.toggle('is-active', index === closestIndex);
        });
      }

      function handleScroll() {
        if (ticking) return;

        window.requestAnimationFrame(function () {
          updateActiveDot();
          ticking = false;
        });

        ticking = true;
      }

      slider.addEventListener('scroll', handleScroll);
      window.addEventListener('resize', updateActiveDot);
      updateActiveDot();

      dotCleanup = function () {
        slider.removeEventListener('scroll', handleScroll);
        window.removeEventListener('resize', updateActiveDot);
      };
    }

    if (url && !content.querySelector('.pukenga-product-card')) {
      fetch(url)
        .then(function (response) {
          return response.text();
        })
        .then(function (text) {
          const html = document.createElement('div');
          html.innerHTML = text;
          const updatedContent = html.querySelector('#recommended-products-{{ section.id }} [data-recommendations-content]');

          if (updatedContent && updatedContent.innerHTML.trim().length) {
            content.innerHTML = updatedContent.innerHTML;
            setupMobileDots();
          }
        })
        .catch(function (error) {
          console.error(error);
        });
    } else {
      setupMobileDots();
    }

    section.addEventListener('click', function (event) {
      const button = event.target.closest('[data-pukenga-recommended-add]');
      if (!button || button.disabled) return;

      const variantId = button.getAttribute('data-variant-id');
      if (!variantId) return;

      button.classList.add('pukenga-product-card__add--loading');
      button.textContent = 'ADDING';

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          items: [
            {
              id: Number(variantId),
              quantity: 1
            }
          ]
        })
      })
        .then(function (response) {
          if (!response.ok) {
            throw new Error('Unable to add product to cart.');
          }

          return response.json();
        })
        .then(function () {
          window.location.href = '/cart';
        })
        .catch(function (error) {
          console.error(error);
          button.textContent = 'ERROR';
          button.classList.remove('pukenga-product-card__add--loading');

          setTimeout(function () {
            button.textContent = '{{ section.settings.add_button_label | escape }}';
          }, 1500);
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Recommended Pukenga",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Recommendation type",
      "options": [
        {
          "value": "related",
          "label": "Related"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recommended For You"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "/ you may also like"
    },
    {
      "type": "text",
      "id": "add_button_label",
      "label": "Add button label",
      "default": "ADD"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold out label",
      "default": "SOLD OUT"
    },
    {
      "type": "text",
      "id": "sale_label",
      "label": "Sale badge label",
      "default": "SALE"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty text",
      "default": "No recommendations found."
    },
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Mobile slider"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Visible cards",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.35
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "label": "Card gap",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Recommended Pukenga"
    }
  ]
}
{% endschema %}
