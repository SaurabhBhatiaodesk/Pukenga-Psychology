{%- comment -%}
  Pūkenga Psychology — Online course sales page (Mauri Tau), Forest Deep look
  Template: templates/product.mauritau-course.json  (assigned to the Mauri Tau Program product)
  Price, compare-at price and the Enrol button come from the product itself.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign price = current_variant.price | money_without_trailing_zeros
  assign was = current_variant.compare_at_price | money_without_trailing_zeros
  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif
-%}

{%- if section.settings.load_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Marcellus&family=Spectral:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  .pkc{--pk-bg:#16281b;--pk-panel:#1d3323;--pk-deep:#0f1d13;--pk-text:#ece5d4;--pk-muted:#cfd8cc;--pk-gold:#e0b784;--pk-line:rgba(236,229,212,.16);--pk-sale:#c05437;
    background:var(--pk-bg);color:var(--pk-text);font-family:'Instrument Sans',system-ui,sans-serif;font-size:16px;line-height:1.5}
  .pkc *{box-sizing:border-box}
  .pkc h1,.pkc h2,.pkc h3,.pkc p{margin:0}
  .pkc a{color:inherit;text-decoration:none}
  .pkc a:hover{opacity:.82}
  .pkc-serif{font-family:'Spectral',Georgia,serif;font-weight:300}
  .pkc-mar{font-family:'Marcellus',Georgia,serif}
  .pkc-eyebrow{font-size:12px;letter-spacing:.28em;text-transform:uppercase;color:var(--pk-gold)}
  .pkc-wrap{max-width:1280px;margin:0 auto;padding-left:clamp(20px,4vw,44px);padding-right:clamp(20px,4vw,44px)}
  .pkc-pad{padding-top:clamp(64px,8vw,104px);padding-bottom:clamp(64px,8vw,104px)}
  .pkc-panel{background:var(--pk-panel)}
  .pkc-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:17px 32px;border-radius:40px;font-weight:600;font-size:15px;background:var(--pk-gold);color:var(--pk-bg)!important;border:1px solid var(--pk-gold);cursor:pointer;font-family:inherit}
  .pkc-btn--ghost{background:transparent;color:var(--pk-text)!important;border-color:rgba(236,229,212,.5);font-weight:400}
  .pkc-btn[disabled]{opacity:.5;cursor:not-allowed}
  .pkc-row{display:flex;flex-wrap:wrap;gap:14px}
  .pkc-img{position:relative;overflow:hidden;min-height:520px}
  .pkc-img img,.pkc-img svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .pkc-split{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,480px),1fr))}
  .pkc-split__text{padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px);display:flex;flex-direction:column;justify-content:center;gap:22px}
  .pkc-h2{font-size:clamp(32px,3.8vw,46px);line-height:1.1}
  .pkc-body{font-size:16px;line-height:1.75;opacity:.86}
  .pkc-body p+p{margin-top:14px}
  .pkc-what__text,
  .pkc-what__text *{font-family:'Instrument Sans',system-ui,sans-serif;font-size:16px!important;font-style:normal;font-weight:400;line-height:1.65!important}
  .pkc-center{text-align:center;margin-bottom:44px;display:flex;flex-direction:column;align-items:center;gap:14px}
  .pkc-sale{font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;padding:6px 12px;border-radius:40px;background:var(--pk-sale);color:#fff}

  /* hero */
  .pkc-hero .pkc-split__text{gap:24px;padding-top:clamp(44px,6vw,88px)}
  .pkc-tag{font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;padding:7px 13px;border-radius:40px;background:var(--pk-gold);color:var(--pk-bg);font-weight:600}
  .pkc-stars{color:var(--pk-gold);font-size:13px}
  .pkc-hero h1{font-size:clamp(48px,6.4vw,84px);line-height:1}
  .pkc-hero__sub{font-style:italic;font-size:clamp(22px,2.2vw,28px);line-height:1.35;color:var(--pk-gold)}
  .pkc-hero__desc,
  .pkc-hero__desc *{font-family:'Instrument Sans',system-ui,sans-serif;font-size:16px!important;font-style:normal;font-weight:400;line-height:1.65!important}
  .pkc-hero__desc{opacity:.86;max-width:540px}
  .pkc-price{display:flex;flex-wrap:wrap;align-items:baseline;gap:14px}
  .pkc-price__now{font-family:'Spectral',Georgia,serif;font-size:44px}
  .pkc-price__was{font-size:18px;opacity:.55;text-decoration:line-through}
  .pkc-trust{display:flex;flex-wrap:wrap;gap:12px 26px;padding-top:20px;border-top:1px solid rgba(236,229,212,.14);font-size:13.5px;opacity:.85}
  .pkc-trust span::before{content:'✦ ';color:var(--pk-gold)}
  .pkc-hero .pkc-img{min-height:560px}

  /* in-page nav */
  .pkc-nav{background:var(--pk-deep);border-top:1px solid rgba(236,229,212,.08);border-bottom:1px solid rgba(236,229,212,.08);padding:16px clamp(20px,4vw,44px);display:flex;flex-wrap:wrap;justify-content:center;gap:10px 30px;font-size:13.5px;color:var(--pk-muted)}
  .pkc-nav a:last-child{color:var(--pk-gold);border-bottom:1px solid var(--pk-gold);padding-bottom:2px}
  .pkc [id^="pkc-"]{scroll-margin-top:90px}

  /* for you */
  .pkc-foryou{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:56px;align-items:center;max-width:1200px;margin:0 auto}
  .pkc-checks{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:14px}
  .pkc-checks li{display:flex;gap:16px;align-items:flex-start;background:var(--pk-panel);border-radius:14px;padding:20px 22px;font-size:15.5px;line-height:1.6}
  .pkc-tick{flex:none;width:28px;height:28px;border-radius:50%;background:var(--pk-gold);color:var(--pk-bg);display:flex;align-items:center;justify-content:center}
  .pkc-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:8px}
  .pkc-stat{border:1px solid var(--pk-line);border-radius:12px;padding:16px;text-align:center}
  .pkc-stat b{display:block;font-family:'Spectral',Georgia,serif;font-weight:400;font-size:32px;color:var(--pk-gold)}
  .pkc-stat span{font-size:12.5px;opacity:.75}

  /* includes */
  .pkc-includes{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:18px}
  .pkc-inc{background:var(--pk-panel);border-radius:16px;padding:28px 26px;display:flex;flex-direction:column;gap:12px}
  .pkc-inc h3{font-family:'Spectral',Georgia,serif;font-weight:400;font-size:21px}
  .pkc-inc p{font-size:14.5px;line-height:1.65;opacity:.78}

  /* accordions */
  .pkc details summary{list-style:none;cursor:pointer}
  .pkc details summary::-webkit-details-marker{display:none}
  .pkc details .pm-minus{display:none}
  .pkc details[open] .pm-minus{display:inline}
  .pkc details[open] .pm-plus{display:none}
  .pkc summary:focus-visible{outline:2px solid var(--pk-gold);outline-offset:4px;border-radius:6px}
  .pkc-mod{background:var(--pk-bg);border-radius:14px;padding:4px 26px;margin-bottom:12px}
  .pkc-mod summary{display:flex;align-items:center;gap:20px;padding:22px 0}
  .pkc-mod__n{font-family:'Marcellus',Georgia,serif;font-size:15px;color:var(--pk-gold);flex:none;width:84px}
  .pkc-mod__t{flex:1;font-family:'Spectral',Georgia,serif;font-size:22px}
  .pkc-pm{color:var(--pk-gold);font-size:24px;line-height:1}
  .pkc-mod__body{font-size:15px;line-height:1.75;opacity:.82;padding:0 0 24px 104px}
  .pkc-faq{border-bottom:1px solid var(--pk-line)}
  .pkc-faq summary{display:flex;justify-content:space-between;gap:20px;padding:22px 0;font-family:'Spectral',Georgia,serif;font-size:20px}
  .pkc-faq__body{font-size:15px;line-height:1.75;opacity:.82;padding:0 0 22px}
  .pkc-faq__body a{color:var(--pk-gold);text-decoration:underline}
  @media (max-width:640px){.pkc-mod__n{width:auto}.pkc-mod summary{flex-wrap:wrap;gap:6px 14px}.pkc-mod__body{padding-left:0}}

  /* fit */
  .pkc-fit{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:22px;max-width:1200px;margin:0 auto}
  .pkc-fit__card{border:1px solid var(--pk-line);border-radius:18px;padding:34px 32px;display:flex;flex-direction:column;gap:16px}
  .pkc-fit__card--yes{border-color:rgba(224,183,132,.45)}
  .pkc-fit__card--yes h3{color:var(--pk-gold)}
  .pkc-fit__card h3{font-family:'Spectral',Georgia,serif;font-weight:400;font-size:24px}
  .pkc-fit__card ul{margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:12px;font-size:15.5px;line-height:1.6}

  /* reviews */
  .pkc-rev-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:36px}
  .pkc-reviews{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:22px}
  .pkc-rev{border:1px solid rgba(236,229,212,.14);padding:32px 28px;border-radius:14px;display:flex;flex-direction:column;gap:16px}
  .pkc-rev p{font-family:'Spectral',Georgia,serif;font-style:italic;font-size:17px;line-height:1.6}
  .pkc-rev cite{font-style:normal;font-size:13px;color:var(--pk-gold)}

  /* enrol */
  .pkc-enrol{position:relative;overflow:hidden;padding:clamp(64px,8vw,110px) clamp(20px,4vw,44px)}
  .pkc-enrol>img,.pkc-enrol>svg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .pkc-enrol::before{content:'';position:absolute;inset:0;z-index:1;background:rgba(15,29,19,.82)}
  .pkc-enrol__grid{position:relative;z-index:2;max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));gap:40px;align-items:center}
  .pkc-enrol h2{font-size:clamp(36px,4.4vw,56px);line-height:1.05}
  .pkc-card{background:var(--pk-text);color:var(--pk-bg);border-radius:22px;padding:clamp(28px,3vw,40px);display:flex;flex-direction:column;gap:20px}
  .pkc-card h3{font-family:'Spectral',Georgia,serif;font-weight:400;font-size:26px}
  .pkc-card__top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}
  .pkc-card__price{display:flex;align-items:baseline;gap:12px}
  .pkc-card__price b{font-family:'Spectral',Georgia,serif;font-weight:400;font-size:52px;line-height:1}
  .pkc-card ul{margin:0;padding:18px 0;list-style:none;display:flex;flex-direction:column;gap:10px;font-size:15px;border-top:1px solid rgba(22,40,27,.15);border-bottom:1px solid rgba(22,40,27,.15)}
  .pkc-card ul li::before{content:'✓  '}
  .pkc-card .pkc-btn{width:100%;background:var(--pk-bg);color:var(--pk-text)!important;border-color:var(--pk-bg)}
  .pkc-card__note{font-size:13px;opacity:.75;text-align:center}
  .pkc-card__note a{text-decoration:underline}

  /* timeline */
  .pkc-time{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:20px;max-width:1200px;margin:0 auto}
  .pkc-time div{display:flex;flex-direction:column;gap:12px;padding-top:20px;border-top:2px solid var(--pk-gold)}
  .pkc-time div:nth-child(2){border-top-color:rgba(224,183,132,.55)}
  .pkc-time div:nth-child(3){border-top-color:rgba(224,183,132,.35)}
  .pkc-time div:nth-child(n+4){border-top-color:rgba(224,183,132,.2)}
  .pkc-time span{font-family:'Marcellus',Georgia,serif;color:var(--pk-gold);font-size:15px}
  .pkc-time p{font-size:15px;line-height:1.65;opacity:.85}

  .pkc-final{text-align:center}
  .pkc-final p{font-size:clamp(28px,3.4vw,42px);line-height:1.2;margin-bottom:22px}
  .pkc-final p em{color:var(--pk-gold)}

  @media screen and (max-width:749px){
    .pkc-hero{display:flex;flex-direction:column}
    .pkc-hero .pkc-img{order:1;min-height:460px}
    .pkc-hero .pkc-split__text{order:2;padding:44px 20px 52px}
    .pkc-hero .pkc-img img,
    .pkc-hero .pkc-img svg{object-position:center}
  }
</style>

{%- capture enrol_form -%}
  {%- form 'product', product, class: 'pkc-enrol-form' -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}">
    <input type="hidden" name="return_to" value="/checkout">
    <button type="submit" name="add" class="pkc-btn"{% unless current_variant.available %} disabled{% endunless %}>
      {%- if current_variant.available -%}{{ section.settings.enrol_label }} · {{ price }} {{ cart.currency.iso_code }}{%- else -%}Enrolments closed{%- endif -%}
    </button>
  {%- endform -%}
{%- endcapture -%}

<div class="pkc">

  {%- comment -%} HERO {%- endcomment -%}
  <section class="pkc-split pkc-hero">
    <div class="pkc-split__text">
      <div class="pkc-row" style="align-items:center;gap:10px">
        <span class="pkc-tag">{{ section.settings.hero_tag }}</span>
        {%- if section.settings.rating_text != blank -%}<span class="pkc-stars" aria-hidden="true">★★★★★</span><span style="font-size:13px;opacity:.75">{{ section.settings.rating_text }}</span>{%- endif -%}
      </div>
      <h1 class="pkc-serif">{{ section.settings.hero_title | default: product.title }}</h1>
      <p class="pkc-serif pkc-hero__sub">{{ section.settings.hero_sub }}</p>
      <div class="pkc-hero__desc">{{ section.settings.hero_desc }}</div>
      <div class="pkc-price">
        <span class="pkc-price__now">{{ price }}</span>
        {%- if on_sale -%}<span class="pkc-price__was">{{ was }}</span><span class="pkc-sale">{{ section.settings.sale_label }}</span>{%- endif -%}
      </div>
      <div class="pkc-row">
        <a class="pkc-btn" href="#pkc-enrol">{{ section.settings.enrol_label }} · {{ price }} {{ cart.currency.iso_code }}</a>
        <a class="pkc-btn pkc-btn--ghost" href="#pkc-inside">See what's inside</a>
      </div>
      <div class="pkc-trust">
        {%- assign tr = section.settings.trust | split: ',' -%}
        {%- for t in tr -%}<span>{{ t | strip }}</span>{%- endfor -%}
      </div>
    </div>
    <div class="pkc-img">
      {%- assign hero_img = section.settings.hero_image | default: product.featured_image -%}
      {%- if hero_img -%}
        {{ hero_img | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '(min-width: 1040px) 50vw, 100vw', alt: hero_img.alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </section>

  <nav class="pkc-nav" aria-label="On this page">
    <a href="#pkc-for-you">Is it for you?</a><a href="#pkc-inside">What you get</a><a href="#pkc-curriculum">Curriculum</a><a href="#pkc-about">About Dr Jessica</a><a href="#pkc-faq">FAQ</a><a href="#pkc-enrol">Enrol · {{ price }}</a>
  </nav>

  {%- comment -%} IS IT FOR YOU {%- endcomment -%}
  <section id="pkc-for-you" class="pkc-wrap pkc-pad">
    <div class="pkc-foryou">
      <div style="display:flex;flex-direction:column;gap:22px">
        <div class="pkc-eyebrow">{{ section.settings.foryou_eyebrow }}</div>
        <h2 class="pkc-serif pkc-h2">{{ section.settings.foryou_heading }}</h2>
        <div class="pkc-body">{{ section.settings.foryou_text }}</div>
      </div>
      <ul class="pkc-checks">
        {%- for block in section.blocks -%}{%- if block.type == 'for_you' -%}
          <li {{ block.shopify_attributes }}><span class="pkc-tick"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg></span>{{ block.settings.text }}</li>
        {%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </section>

  {%- comment -%} WHAT IS IT {%- endcomment -%}
  <section class="pkc-split pkc-panel">
    <div class="pkc-img">
      {%- if section.settings.about_course_image -%}
        {{ section.settings.about_course_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1040px) 50vw, 100vw', alt: section.settings.about_course_image.alt }}
      {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
    </div>
    <div class="pkc-split__text">
      <div class="pkc-eyebrow">{{ section.settings.what_eyebrow }}</div>
      <h2 class="pkc-serif pkc-h2">{{ section.settings.what_heading }}</h2>
      <div class="pkc-body pkc-what__text">{{ section.settings.what_text }}</div>
      <div class="pkc-stats">
        <div class="pkc-stat"><b>{{ section.settings.stat1_n }}</b><span>{{ section.settings.stat1_l }}</span></div>
        <div class="pkc-stat"><b>{{ section.settings.stat2_n }}</b><span>{{ section.settings.stat2_l }}</span></div>
        <div class="pkc-stat"><b>{{ section.settings.stat3_n }}</b><span>{{ section.settings.stat3_l }}</span></div>
      </div>
    </div>
  </section>

  {%- comment -%} WHAT YOU GET {%- endcomment -%}
  <section id="pkc-inside" class="pkc-wrap pkc-pad">
    <div class="pkc-center">
      <div class="pkc-eyebrow">{{ section.settings.inc_eyebrow }}</div>
      <h2 class="pkc-serif pkc-h2">{{ section.settings.inc_heading }}</h2>
    </div>
    <div class="pkc-includes">
      {%- for block in section.blocks -%}{%- if block.type == 'include' -%}
        <div class="pkc-inc" {{ block.shopify_attributes }}>
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#e0b784" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'video' -%}<rect x="3" y="5" width="18" height="13" rx="2"/><path d="M10 9.5l4 2.5-4 2.5z"/>
              {%- when 'workbook' -%}<path d="M4 4h11l5 5v11H4z"/><path d="M15 4v5h5M8 13h8M8 17h6"/>
              {%- when 'journal' -%}<path d="M5 4h12a2 2 0 012 2v14H7a2 2 0 01-2-2z"/><path d="M5 18a2 2 0 012-2h12"/>
              {%- when 'poster' -%}<path d="M4 18V6a2 2 0 012-2h12a2 2 0 012 2v12"/><path d="M3 18h18M8 9h8M8 13h5"/>
              {%- when 'audio' -%}<path d="M4 14v-2a8 8 0 0116 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/>
              {%- when 'sleep' -%}<path d="M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"/>
              {%- when 'community' -%}<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M3 19a6 6 0 0112 0M15 19a4.5 4.5 0 016 0"/>
              {%- else -%}<path d="M4 6l8 6 8-6"/><rect x="3" y="5" width="18" height="14" rx="2"/>
            {%- endcase -%}
          </svg>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endif -%}{%- endfor -%}
    </div>
  </section>

  {%- comment -%} CURRICULUM {%- endcomment -%}
  <section id="pkc-curriculum" class="pkc-panel pkc-pad" style="padding-left:clamp(20px,4vw,44px);padding-right:clamp(20px,4vw,44px)">
    <div style="max-width:960px;margin:0 auto">
      <div class="pkc-center">
        <div class="pkc-eyebrow">{{ section.settings.cur_eyebrow }}</div>
        <h2 class="pkc-serif pkc-h2">{{ section.settings.cur_heading }}</h2>
      </div>
      {%- assign m = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'module' -%}
        {%- assign m = m | plus: 1 -%}
        <details class="pkc-mod" {% if m == 1 %}open{% endif %} {{ block.shopify_attributes }}>
          <summary><span class="pkc-mod__n">Module {{ m }}</span><span class="pkc-mod__t">{{ block.settings.title }}</span><span class="pkc-pm" aria-hidden="true"><span class="pm-plus">+</span><span class="pm-minus">−</span></span></summary>
          <div class="pkc-mod__body">{{ block.settings.text }}</div>
        </details>
      {%- endif -%}{%- endfor -%}
      <div style="text-align:center;margin-top:40px"><a href="#pkc-enrol" class="pkc-btn">{{ section.settings.cur_cta }} · {{ price }}</a></div>
    </div>
  </section>

  {%- comment -%} RIGHT FIT {%- endcomment -%}
  <section class="pkc-wrap pkc-pad">
    <h2 class="pkc-serif pkc-h2" style="text-align:center;margin-bottom:44px">{{ section.settings.fit_heading }}</h2>
    <div class="pkc-fit">
      <div class="pkc-fit__card pkc-fit__card--yes">
        <h3>{{ section.settings.fit_yes_heading }}</h3>
        <ul>
          {%- assign ys = section.settings.fit_yes | newline_to_br | split: '<br />' -%}
          {%- for y in ys -%}{%- assign yt = y | strip -%}{%- if yt != blank -%}<li>✓ {{ yt }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
      <div class="pkc-fit__card">
        <h3>{{ section.settings.fit_no_heading }}</h3>
        <ul style="opacity:.85">
          {%- assign ns = section.settings.fit_no | newline_to_br | split: '<br />' -%}
          {%- for x in ns -%}{%- assign xt = x | strip -%}{%- if xt != blank -%}<li>✕ {{ xt }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
    </div>
  </section>

  {%- comment -%} ABOUT {%- endcomment -%}
  <section id="pkc-about" class="pkc-split pkc-panel">
    <div class="pkc-split__text">
      <div class="pkc-eyebrow">{{ section.settings.bio_eyebrow }}</div>
      <h2 class="pkc-serif pkc-h2">{{ section.settings.bio_heading }}</h2>
      <div class="pkc-body">{{ section.settings.bio_text }}</div>
      {%- if section.settings.bio_signoff != blank -%}<div class="pkc-serif" style="font-style:italic;font-size:22px;color:var(--pk-gold);margin-top:6px">{{ section.settings.bio_signoff }}</div>{%- endif -%}
    </div>
    <div class="pkc-img" style="min-height:560px">
      {%- if section.settings.bio_image -%}
        {{ section.settings.bio_image | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 1040px) 50vw, 100vw', alt: section.settings.bio_image.alt, style: 'object-position: 50% 22%' }}
      {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
    </div>
  </section>

  {%- comment -%} REVIEWS {%- endcomment -%}
  {%- assign has_reviews = false -%}
  {%- for block in section.blocks -%}{%- if block.type == 'review' -%}{%- assign has_reviews = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if has_reviews -%}
    <section class="pkc-wrap pkc-pad">
      <div class="pkc-rev-head">
        <h2 class="pkc-serif" style="font-size:clamp(30px,3.4vw,40px)">{{ section.settings.rev_heading }}</h2>
        {%- if section.settings.rating_text != blank -%}<div style="display:flex;align-items:center;gap:10px"><span class="pkc-stars" style="font-size:17px" aria-hidden="true">★★★★★</span><span style="font-size:14px;opacity:.8">{{ section.settings.rating_text }}</span></div>{%- endif -%}
      </div>
      <div class="pkc-reviews">
        {%- for block in section.blocks -%}{%- if block.type == 'review' -%}
          <div class="pkc-rev" {{ block.shopify_attributes }}><div class="pkc-stars" aria-hidden="true">★★★★★</div><p>"{{ block.settings.quote }}"</p><cite>{{ block.settings.name }}</cite></div>
        {%- endif -%}{%- endfor -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ENROL {%- endcomment -%}
  <section id="pkc-enrol" class="pkc-enrol">
    {%- if section.settings.enrol_image -%}
      {{ section.settings.enrol_image | image_url: width: 2400 | image_tag: loading: 'lazy', sizes: '100vw', alt: '' }}
    {%- endif -%}
    <div class="pkc-enrol__grid">
      <div style="display:flex;flex-direction:column;gap:20px">
        <div class="pkc-eyebrow">{{ section.settings.enrol_eyebrow }}</div>
        <h2 class="pkc-serif">{{ section.settings.enrol_heading }}</h2>
        <p class="pkc-body">{{ section.settings.enrol_text }}</p>
      </div>
      <div class="pkc-card">
        <div class="pkc-card__top">
          <h3>{{ product.title }}</h3>
          {%- if on_sale -%}<span class="pkc-sale">{{ section.settings.sale_label }}</span>{%- endif -%}
        </div>
        <div class="pkc-card__price"><b>{{ price }}</b>{%- if on_sale -%}<span style="font-size:18px;opacity:.6;text-decoration:line-through">{{ was }}</span>{%- endif -%}<span style="font-size:14px;opacity:.75">{{ cart.currency.iso_code }}</span></div>
        <ul>
          {%- assign ci = section.settings.card_includes | newline_to_br | split: '<br />' -%}
          {%- for c in ci -%}{%- assign ct = c | strip -%}{%- if ct != blank -%}<li>{{ ct }}</li>{%- endif -%}{%- endfor -%}
        </ul>
        {{ enrol_form }}
        <p class="pkc-card__note">{{ section.settings.card_note }}</p>
      </div>
    </div>
  </section>

  {%- comment -%} AFTER YOU ENROL {%- endcomment -%}
  <section class="pkc-wrap pkc-pad">
    <h2 class="pkc-serif" style="font-size:clamp(30px,3.4vw,40px);text-align:center;margin-bottom:44px">{{ section.settings.time_heading }}</h2>
    <div class="pkc-time">
      {%- for block in section.blocks -%}{%- if block.type == 'timeline' -%}
        <div {{ block.shopify_attributes }}><span>{{ block.settings.when }}</span><p>{{ block.settings.text }}</p></div>
      {%- endif -%}{%- endfor -%}
    </div>
  </section>

  {%- comment -%} FAQ {%- endcomment -%}
  <section id="pkc-faq" class="pkc-panel pkc-pad" style="padding-left:clamp(20px,4vw,44px);padding-right:clamp(20px,4vw,44px)">
    <div style="max-width:880px;margin:0 auto">
      <h2 class="pkc-serif pkc-h2" style="text-align:center;margin-bottom:40px">{{ section.settings.faq_heading }}</h2>
      {%- assign f = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}
        {%- assign f = f | plus: 1 -%}
        <details class="pkc-faq" {% if f == 1 %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="pkc-pm" style="font-size:20px" aria-hidden="true"><span class="pm-plus">+</span><span class="pm-minus">−</span></span></summary>
          <div class="pkc-faq__body">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}{%- endfor -%}
    </div>
  </section>

  {%- comment -%} FINAL CTA {%- endcomment -%}
  <section class="pkc-wrap pkc-pad pkc-final">
    <p class="pkc-serif">{{ section.settings.final_line1 }}<br><em>{{ section.settings.final_line2 }}</em></p>
    <a href="#pkc-enrol" class="pkc-btn">{{ section.settings.enrol_label }} · {{ price }} {{ cart.currency.iso_code }}</a>
  </section>
</div>

{% schema %}
{
  "name": "Course sales page",
  "tag": "div",
  "class": "pk-course-section",
  "settings": [
    { "type": "checkbox", "id": "load_fonts", "label": "Load Spectral / Marcellus / Instrument Sans from Google Fonts", "info": "Untick if the theme already loads these fonts.", "default": true },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_tag", "label": "Tag", "default": "Online course" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "5.0 · 4 reviews", "info": "Leave blank to hide stars" },
    { "type": "text", "id": "hero_title", "label": "Title", "info": "Defaults to product title", "default": "Mauri Tau" },
    { "type": "text", "id": "hero_sub", "label": "Sub-heading", "default": "Cultivate inner calm and balance, grounded in mātauranga Māori" },
    { "type": "richtext", "id": "hero_desc", "label": "Description", "default": "<p>A self-paced course that introduces mauri, the life force within all living things, and teaches you practical ways to return to a settled, balanced state. Think of it as Māori mindfulness, made easy to bring into everyday life.</p>" },
    { "type": "text", "id": "sale_label", "label": "Sale badge", "default": "Limited time" },
    { "type": "text", "id": "enrol_label", "label": "Enrol button", "default": "Enrol now" },
    { "type": "text", "id": "trust", "label": "Trust strip (comma separated)", "default": "Instant digital access, Self-paced · 6 months access, Created by a Registered Clinical Psychologist" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Defaults to product image. Landscape or 4:5, min 1600px wide" },
    { "type": "header", "content": "Is it for you" },
    { "type": "text", "id": "foryou_eyebrow", "label": "Eyebrow", "default": "Is this for you?" },
    { "type": "text", "id": "foryou_heading", "label": "Heading", "default": "If life feels loud and you're craving a steadier place to stand, Mauri Tau is for you." },
    { "type": "richtext", "id": "foryou_text", "label": "Text", "default": "<p>You don't need to be Māori or speak te reo. This course is for anyone looking for a more grounded approach to wellbeing, including tauiwi who are open to learning and honouring the kaupapa.</p>" },
    { "type": "header", "content": "What is Mauri Tau" },
    { "type": "image_picker", "id": "about_course_image", "label": "Image" },
    { "type": "text", "id": "what_eyebrow", "label": "Eyebrow", "default": "He aha te mauri tau?" },
    { "type": "text", "id": "what_heading", "label": "Heading", "default": "A settled mauri is a state you can return to" },
    { "type": "richtext", "id": "what_text", "label": "Text", "default": "<p>Mauri is the life force in all living things: people, whenua, wai. When our mauri is unsettled we feel it as stress, overwhelm or disconnection. Mauri tau is the state of calm and balance on the other side.</p><p>This course walks you through the mātauranga behind it, then gives you the tools, including breath, to get there on purpose.</p>" },
    { "type": "text", "id": "stat1_n", "label": "Stat 1 number", "default": "5" },
    { "type": "text", "id": "stat1_l", "label": "Stat 1 label", "default": "modules" },
    { "type": "text", "id": "stat2_n", "label": "Stat 2 number", "default": "6" },
    { "type": "text", "id": "stat2_l", "label": "Stat 2 label", "default": "months access" },
    { "type": "text", "id": "stat3_n", "label": "Stat 3 number", "default": "7" },
    { "type": "text", "id": "stat3_l", "label": "Stat 3 label", "default": "bonus resources" },
    { "type": "header", "content": "What you get" },
    { "type": "text", "id": "inc_eyebrow", "label": "Eyebrow", "default": "Kei roto · What you get" },
    { "type": "text", "id": "inc_heading", "label": "Heading", "default": "Everything you need to make it a practice" },
    { "type": "header", "content": "Curriculum" },
    { "type": "text", "id": "cur_eyebrow", "label": "Eyebrow", "default": "Course curriculum" },
    { "type": "text", "id": "cur_heading", "label": "Heading", "default": "Five modules, one steady practice" },
    { "type": "text", "id": "cur_cta", "label": "Button", "default": "Start the course" },
    { "type": "header", "content": "Right fit" },
    { "type": "text", "id": "fit_heading", "label": "Heading", "default": "Is this the right fit?" },
    { "type": "text", "id": "fit_yes_heading", "label": "For you heading", "default": "Mauri Tau is for you if" },
    { "type": "textarea", "id": "fit_yes", "label": "For you (one per line)", "default": "You're Māori or tauiwi and open to honouring the kaupapa\nYou're a beginner or have some experience with Te Ao Māori\nYou want to learn at your own pace, on your own schedule\nYou work in health, education or social services and want to build cultural competency" },
    { "type": "text", "id": "fit_no_heading", "label": "Not for you heading", "default": "It's not the right fit if" },
    { "type": "textarea", "id": "fit_no", "label": "Not for you (one per line)", "default": "You're looking for one-on-one therapy (this is an education course)\nYou need urgent support right now. Please contact your GP, or call or text 1737 any time" },
    { "type": "header", "content": "About" },
    { "type": "text", "id": "bio_eyebrow", "label": "Eyebrow", "default": "Ko wai au · Your guide" },
    { "type": "text", "id": "bio_heading", "label": "Heading", "default": "Kia ora, I'm Dr Jessica" },
    { "type": "richtext", "id": "bio_text", "label": "Bio", "default": "<p>I'm a Registered Clinical Psychologist of Ngāti Pūkenga and Ngāti Pikiao descent, based in Tāmaki Makaurau. I create Māori wellbeing resources for everyday people, to help you whakapiki your hauora.</p><p>Mauri Tau brings together my clinical training and mātauranga Māori, so the practices are both grounded and easy to use in real life.</p>" },
    { "type": "text", "id": "bio_signoff", "label": "Sign-off", "default": "Nā Jessica" },
    { "type": "image_picker", "id": "bio_image", "label": "Portrait", "info": "4:5, 1200 × 1500px" },
    { "type": "header", "content": "Reviews" },
    { "type": "text", "id": "rev_heading", "label": "Heading", "default": "What Mauri Tau students say" },
    { "type": "header", "content": "Enrol" },
    { "type": "image_picker", "id": "enrol_image", "label": "Background image" },
    { "type": "text", "id": "enrol_eyebrow", "label": "Eyebrow", "default": "Rēhita mai · Enrol" },
    { "type": "text", "id": "enrol_heading", "label": "Heading", "default": "Begin your Mauri Tau journey today" },
    { "type": "textarea", "id": "enrol_text", "label": "Text", "default": "Start straight away, move at your own pace and come back to the lessons whenever you need them over six months." },
    { "type": "textarea", "id": "card_includes", "label": "Card includes (one per line)", "default": "5 modules of interactive lessons\nWorkbook & digital hauora journal\nWhakataukī posters & audio karakia pack\nBonus sleep hygiene eBook\nPrivate community & 6 months of support" },
    { "type": "html", "id": "card_note", "label": "Card note", "default": "Instant access by email. Enrolling a team? <a href=\"/pages/services#pk-enquire\">Ask about group packages</a>" },
    { "type": "header", "content": "Timeline / FAQ / Final" },
    { "type": "text", "id": "time_heading", "label": "Timeline heading", "default": "What happens after you enrol" },
    { "type": "text", "id": "faq_heading", "label": "FAQ heading", "default": "Frequently asked questions" },
    { "type": "text", "id": "final_line1", "label": "Final line 1", "default": "Your mauri is worth tending." },
    { "type": "text", "id": "final_line2", "label": "Final line 2 (gold italic)", "default": "Start today." }
  ],
  "blocks": [
    { "type": "for_you", "name": "Is it for you item", "settings": [ { "type": "text", "id": "text", "label": "Text" } ] },
    { "type": "include", "name": "What you get item", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "video", "options": [
        { "value": "video", "label": "Video" }, { "value": "workbook", "label": "Workbook" }, { "value": "journal", "label": "Journal" }, { "value": "poster", "label": "Poster" },
        { "value": "audio", "label": "Audio" }, { "value": "sleep", "label": "Sleep" }, { "value": "community", "label": "Community" }, { "value": "email", "label": "Email" } ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" } ] },
    { "type": "module", "name": "Curriculum module", "settings": [
      { "type": "text", "id": "title", "label": "Title (English)" },
      { "type": "richtext", "id": "text", "label": "Description" } ] },
    { "type": "review", "name": "Review", "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote" },
      { "type": "text", "id": "name", "label": "Name" } ] },
    { "type": "timeline", "name": "After you enrol step", "settings": [
      { "type": "text", "id": "when", "label": "When" },
      { "type": "textarea", "id": "text", "label": "Text" } ] },
    { "type": "faq", "name": "FAQ", "settings": [
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" } ] }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Course sales page"
    }
  ]
}
{% endschema %}
