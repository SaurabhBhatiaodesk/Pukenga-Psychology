<section
  class="pukenga-footer"
  style="
    --pukenga-footer-bg: {{ section.settings.background_color }};
    --pukenga-footer-text: {{ section.settings.text_color }};
    --pukenga-footer-heading: {{ section.settings.heading_color }};
    --pukenga-footer-link: {{ section.settings.link_color }};
    --pukenga-footer-hover: {{ section.settings.link_hover_color }};
    --pukenga-footer-border: {{ section.settings.border_color }};
  "
>
  <div class="pukenga-section section">
    <div class="pukenga-container pukenga-footer__inner">

      <div class="pukenga-footer__top">

        <div class="pukenga-footer__brand">

          <a
            class="pukenga-footer__logo"
            href="{{ routes.root_url }}"
            aria-label="{{ shop.name | escape }}"
          >
            {%- if section.settings.logo != blank -%}
              <img
                src="{{ section.settings.logo | image_url: width: 440 }}"
                width="{{ section.settings.logo.width }}"
                height="{{ section.settings.logo.height }}"
                alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <img
                src="{{ 'pukenga-logo-mark.png' | asset_url }}"
                width="36"
                height="67"
                alt=""
                loading="lazy"
              >

              <span class="pukenga-footer__wordmark" aria-hidden="true">
                <span>Pūkenga</span>
                <span>Psychology</span>
              </span>
            {%- endif -%}
          </a>

          {%- if section.settings.description != blank -%}
            <div class="pukenga-footer__description">
              {{ section.settings.description }}
            </div>
          {%- endif -%}

        </div>


        <nav
          class="pukenga-footer__nav"
          aria-label="Footer navigation"
        >
          {%- for block in section.blocks -%}

            <div
              class="pukenga-footer__column"
              {{ block.shopify_attributes }}
            >

              {%- if block.settings.heading != blank -%}
                <h2>
                  {{ block.settings.heading | escape }}
                </h2>
              {%- endif -%}

              <ul>

                {%- if block.settings.link_label_1 != blank -%}
                  <li>
                    <a href="{{ block.settings.link_url_1 | default: '#' }}">
                      {{ block.settings.link_label_1 | escape }}
                    </a>
                  </li>
                {%- endif -%}

                {%- if block.settings.link_label_2 != blank -%}
                  <li>
                    <a href="{{ block.settings.link_url_2 | default: '#' }}">
                      {{ block.settings.link_label_2 | escape }}
                    </a>
                  </li>
                {%- endif -%}

                {%- if block.settings.link_label_3 != blank -%}
                  <li>
                    <a href="{{ block.settings.link_url_3 | default: '#' }}">
                      {{ block.settings.link_label_3 | escape }}
                    </a>
                  </li>
                {%- endif -%}

              </ul>

            </div>

          {%- endfor -%}
        </nav>

      </div>


      <div class="pukenga-footer__bottom">
        {%- if section.settings.copyright_text != blank -%}
          <p>{{ section.settings.copyright_text }}</p>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>


<style>

  .pukenga-footer {
    width: 100%;
    background: var(--pukenga-footer-bg);
    color: var(--pukenga-footer-text);
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
  }


  .pukenga-footer__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }


  .pukenga-footer__top {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) auto;
    gap: {{ section.settings.column_gap }}px;
    align-items: start;
    padding-bottom: {{ section.settings.top_section_spacing }}px;
    border-bottom: 1px solid var(--pukenga-footer-border);
  }


  .pukenga-footer__brand {
    max-width: {{ section.settings.brand_max_width }}px;
  }


  .pukenga-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: {{ section.settings.logo_gap }}px;
    color: var(--pukenga-footer-heading);
    text-decoration: none;
  }


  .pukenga-footer__logo img {
    display: block;
    width: auto;
    max-width: {{ section.settings.logo_max_width }}px;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
  }


  .pukenga-footer__wordmark {
    display: grid;
    gap: 2px;
    color: var(--pukenga-footer-heading);
    line-height: 1;
    text-transform: uppercase;
  }

  .pukenga-footer__wordmark span:first-child {
      font-family: var(--pukenga-font-heading, 'Spectral', serif);
      font-size: 26px;
      font-weight: 400;
      letter-spacing: 0.12em;
  }

  .pukenga-footer__wordmark span:last-child {
      font-family: var(--pukenga-font-heading, 'Spectral', serif);
      font-size: 15px;
      letter-spacing: 0.34em;
      opacity: 0.85;
  }


  .pukenga-footer__description {
    margin-top: {{ section.settings.description_spacing }}px;
    color: var(--pukenga-footer-text);
    opacity: 0.82;
    font-size: {{ section.settings.description_font_size }}px;
    line-height: 1.62;
  }


  .pukenga-footer__description p {
    margin: 0;
  }


  .pukenga-footer__nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(116px, 1fr));
    gap: {{ section.settings.navigation_gap }}px;
    min-width: 382px;
  }


  .pukenga-footer__column h2 {
    margin: 0 0 16px;
    color: var(--pukenga-footer-heading);
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 700;
    line-height: 1.2;
  }


  .pukenga-footer__column ul {
    display: grid;
    gap: {{ section.settings.link_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }


  .pukenga-footer__column a {
    color: var(--pukenga-footer-link);
    font-size: {{ section.settings.link_font_size }}px;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }


  .pukenga-footer__column a:hover {
    color: var(--pukenga-footer-hover);
  }


  .pukenga-footer__bottom {
    padding-top: {{ section.settings.copyright_spacing }}px;
  }


  .pukenga-footer__bottom p {
    margin: 0;
    color: var(--pukenga-footer-text);
    opacity: 0.42;
    font-size: {{ section.settings.copyright_font_size }}px;
    line-height: 1.5;
  }


  @media screen and (max-width: 749px) {

    .pukenga-footer__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    .pukenga-footer__top {
      display: block;
      padding-bottom: {{ section.settings.mobile_top_section_spacing }}px;
    }


    .pukenga-footer__brand {
      max-width: none;
    }


    .pukenga-footer__logo {
      gap: {{ section.settings.mobile_logo_gap }}px;
    }


    .pukenga-footer__logo img {
      height: {{ section.settings.mobile_logo_height }}px;
      max-width: {{ section.settings.mobile_logo_max_width }}px;
    }


    .pukenga-footer__wordmark span:first-child {
        font-size: 19px;
    }


    .pukenga-footer__wordmark span:last-child {
      font-size:11px;
    }


    .pukenga-footer__description {
      margin-top: {{ section.settings.mobile_description_spacing }}px;
      font-size: {{ section.settings.mobile_description_font_size }}px;
      line-height: 1.55;
    }


    .pukenga-footer__nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: {{ section.settings.mobile_navigation_gap }}px;
      min-width: 0;
      margin-top: {{ section.settings.mobile_navigation_spacing }}px;
    }


    .pukenga-footer__column h2 {
      margin-bottom: 14px;
      font-size: {{ section.settings.mobile_heading_font_size }}px;
    }


    .pukenga-footer__column ul {
      gap: {{ section.settings.mobile_link_gap }}px;
    }


    .pukenga-footer__column a {
      font-size: {{ section.settings.mobile_link_font_size }}px;
    }


    .pukenga-footer__bottom {
      padding-top: {{ section.settings.mobile_copyright_spacing }}px;
    }


    .pukenga-footer__bottom p {
      font-size: {{ section.settings.mobile_copyright_font_size }}px;
    }

  }

</style>


