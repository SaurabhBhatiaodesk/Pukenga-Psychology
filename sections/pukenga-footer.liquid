<section
  id="pukenga-footer-{{ section.id }}"
  class="pukenga-footer"
>
  <div class="section pukenga-container">

    <div class="pukenga-footer__inner">

      <div class="pukenga-footer__top">

        <!-- BRAND -->
        <div class="pukenga-footer__brand">

          <a
            class="pukenga-footer__logo"
            href="{{ routes.root_url }}"
            aria-label="{{ shop.name | escape }}"
          >

            {% if section.settings.logo != blank %}

              <img
                src="{{ section.settings.logo | image_url: width: 500 }}"
                width="{{ section.settings.logo.width }}"
                height="{{ section.settings.logo.height }}"
                alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
                loading="lazy"
              >

            {% else %}

              <img
                src="{{ 'pukenga-logo-mark.png' | asset_url }}"
                width="36"
                height="67"
                alt=""
                loading="lazy"
              >

              <span
                class="pukenga-footer__wordmark"
                aria-hidden="true"
              >
                <span>Pūkenga</span>
                <span>Psychology</span>
              </span>

            {% endif %}

          </a>


          {% if section.settings.description != blank %}

            <div class="pukenga-footer__description">
              {{ section.settings.description }}
            </div>

          {% endif %}

        </div>


        <!-- NAVIGATION -->
        {% if section.blocks.size > 0 %}

          <nav
            class="pukenga-footer__nav"
            aria-label="Footer navigation"
          >

            {% for block in section.blocks %}

              <div
                class="pukenga-footer__column"
                {{ block.shopify_attributes }}
              >

                {% if block.settings.heading != blank %}

                  <h2>
                    {{ block.settings.heading | escape }}
                  </h2>

                {% endif %}


                <ul>

                  {% if block.settings.link_label_1 != blank %}

                    <li>
                      <a
                        href="{{ block.settings.link_url_1 | default: '#' }}"
                      >
                        {{ block.settings.link_label_1 | escape }}
                      </a>
                    </li>

                  {% endif %}


                  {% if block.settings.link_label_2 != blank %}

                    <li>
                      <a
                        href="{{ block.settings.link_url_2 | default: '#' }}"
                      >
                        {{ block.settings.link_label_2 | escape }}
                      </a>
                    </li>

                  {% endif %}


                  {% if block.settings.link_label_3 != blank %}

                    <li>
                      <a
                        href="{{ block.settings.link_url_3 | default: '#' }}"
                      >
                        {{ block.settings.link_label_3 | escape }}
                      </a>
                    </li>

                  {% endif %}

                </ul>

              </div>

            {% endfor %}

          </nav>

        {% endif %}

      </div>


      <!-- BOTTOM -->
      {% if section.settings.copyright_text != blank %}

        <div class="pukenga-footer__bottom">

          <p>
            {{ section.settings.copyright_text }}
          </p>

        </div>

      {% endif %}

    </div>

  </div>
</section>


<style>

  /* =========================================================
     PŪKENGA FOOTER
     ========================================================= */

  #pukenga-footer-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__inner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }


  /* =========================================================
     TOP
     ========================================================= */

  #pukenga-footer-{{ section.id }} .pukenga-footer__top {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) auto;
    gap: {{ section.settings.column_gap }}px;
    align-items: start;

    padding-bottom: {{ section.settings.top_bottom_spacing }}px;

    border-bottom: 1px solid {{ section.settings.divider_color }};
  }


  /* =========================================================
     BRAND
     ========================================================= */

  #pukenga-footer-{{ section.id }} .pukenga-footer__brand {
    max-width: {{ section.settings.description_width }}px;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 18px;

    color: {{ section.settings.heading_color }};
    text-decoration: none;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__logo img {
    display: block;

    width: auto;
    max-width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;

    object-fit: contain;
  }


  /* =========================================================
     FALLBACK WORDMARK
     ========================================================= */

  #pukenga-footer-{{ section.id }} .pukenga-footer__wordmark {
    display: grid;
    gap: 2px;

    color: {{ section.settings.heading_color }};

    line-height: 1;
    text-transform: uppercase;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__wordmark span:first-child {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-size: 31px;
    font-weight: 400;
    letter-spacing: 0.14em;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__wordmark span:last-child {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-size: 17px;
    letter-spacing: 0.34em;
  }


  /* =========================================================
     DESCRIPTION
     ========================================================= */

  #pukenga-footer-{{ section.id }} .pukenga-footer__description {
    max-width: {{ section.settings.description_width }}px;

    margin-top: {{ section.settings.description_spacing }}px;

    color: {{ section.settings.description_color }};

    font-size: {{ section.settings.description_font_size }}px;
    line-height: 1.62;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__description p {
    margin: 0;
  }


  /* =========================================================
     NAVIGATION
     ========================================================= */

  #pukenga-footer-{{ section.id }} .pukenga-footer__nav {
    display: grid;

    grid-template-columns:
      repeat({{ section.settings.columns_count }}, minmax(116px, 1fr));

    gap: {{ section.settings.nav_gap }}px;

    min-width: 382px;
  }


  /* =========================================================
     COLUMN
     ========================================================= */

  #pukenga-footer-{{ section.id }} .pukenga-footer__column h2 {
    margin: 0 0 {{ section.settings.heading_spacing }}px;

    color: {{ section.settings.heading_color }};

    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);

    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 700;
    line-height: 1.2;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__column ul {
    display: grid;

    gap: {{ section.settings.link_spacing }}px;

    margin: 0;
    padding: 0;

    list-style: none;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__column a {
    color: {{ section.settings.link_color }};

    font-size: {{ section.settings.link_font_size }}px;
    line-height: 1.35;

    text-decoration: none;

    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__column a:hover {
    color: {{ section.settings.link_hover_color }};
  }


  /* =========================================================
     BOTTOM
     ========================================================= */

  #pukenga-footer-{{ section.id }} .pukenga-footer__bottom {
    padding-top: {{ section.settings.bottom_spacing }}px;
  }


  #pukenga-footer-{{ section.id }} .pukenga-footer__bottom p {
    margin: 0;

    color: {{ section.settings.copyright_color }};

    font-size: {{ section.settings.copyright_font_size }}px;
    line-height: 1.5;
  }


  /* =========================================================
     MOBILE
     ========================================================= */

  @media screen and (max-width: 749px) {

    #pukenga-footer-{{ section.id }} .pukenga-footer__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__top {
      display: block;

      padding-bottom: {{ section.settings.mobile_top_bottom_spacing }}px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__brand {
      max-width: none;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__logo {
      gap: 13px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__logo img {
      height: {{ section.settings.mobile_logo_height }}px;
      max-width: {{ section.settings.mobile_logo_width }}px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__wordmark span:first-child {
      font-size: 23px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__wordmark span:last-child {
      font-size: 13px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__description {
      max-width: none;

      margin-top: {{ section.settings.mobile_description_spacing }}px;

      font-size: {{ section.settings.mobile_description_font_size }}px;
      line-height: 1.55;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__nav {

      grid-template-columns:
        repeat({{ section.settings.mobile_columns_count }}, minmax(0, 1fr));

      gap: {{ section.settings.mobile_nav_gap }}px;

      min-width: 0;

      margin-top: {{ section.settings.mobile_nav_spacing }}px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__column h2 {
      margin-bottom: {{ section.settings.mobile_heading_spacing }}px;

      font-size: {{ section.settings.mobile_heading_font_size }}px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__column ul {
      gap: {{ section.settings.mobile_link_spacing }}px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__column a {
      font-size: {{ section.settings.mobile_link_font_size }}px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__bottom {
      padding-top: {{ section.settings.mobile_bottom_spacing }}px;
    }


    #pukenga-footer-{{ section.id }} .pukenga-footer__bottom p {
      font-size: {{ section.settings.mobile_copyright_font_size }}px;
    }

  }

</style>


