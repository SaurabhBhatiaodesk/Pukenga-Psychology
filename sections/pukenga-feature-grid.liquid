<section class="pukenga-section section pukenga-features" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="pukenga-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pukenga-eyebrow pukenga-features__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="pukenga-heading pukenga-features__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pukenga-features__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'quote' -%}
          <div class="pukenga-features__item pukenga-features__item--quote" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'pukenga-features__quote-image' }}
            {%- else -%}
              <img src="{{ 'pukenga-feature-banner.jpg' | asset_url }}" alt="" loading="lazy" class="pukenga-features__quote-image">
            {%- endif -%}
            {%- if block.settings.quote != blank -%}
              <blockquote class="pukenga-features__quote-text">{{ block.settings.quote }}</blockquote>
            {%- endif -%}
            {%- if block.settings.attribution != blank -%}
              <cite class="pukenga-features__quote-cite">{{ block.settings.attribution | escape }}</cite>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="pukenga-features__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="pukenga-features__icon">{{ block.settings.icon }}</div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="pukenga-features__item-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="pukenga-features__item-text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .pukenga-features__eyebrow {
    text-align: center;
  }

  .pukenga-features__heading {
    text-align: center;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 48px;
  }

  .pukenga-features__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }

  .pukenga-features__item {
    text-align: center;
    padding: 32px 20px;
    border: 1px solid rgba(242, 236, 220, 0.12);
    border-radius: 12px;
  }

  .pukenga-features__icon {
    font-size: 32px;
    line-height: 1;
    margin-bottom: 18px;
  }

  .pukenga-features__item-title {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-weight: 400;
    font-size: 20px;
    color: var(--pukenga-cream-soft, #ece5d4);
    margin: 0 0 10px;
  }

  .pukenga-features__item-text {
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--pukenga-muted, #a8a087);
  }

  .pukenga-features__item--quote {
    position: relative;
    padding: 0;
    overflow: hidden;
    border: none;
    text-align: left;
    min-height: 220px;
    display: grid;
    align-items: end;
  }

  .pukenga-features__quote-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .pukenga-features__quote-text,
  .pukenga-features__quote-cite {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 20px;
    color: var(--pukenga-cream-soft, #ece5d4);
  }

  .pukenga-features__quote-text {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-style: italic;
    font-size: 17px;
    line-height: 1.5;
    padding-bottom: 6px;
  }

  .pukenga-features__quote-cite {
    padding-top: 0;
    font-size: 13px;
    font-style: normal;
    opacity: 0.75;
  }

  @media screen and (max-width: 989px) {
    .pukenga-features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .pukenga-features__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pūkenga Feature Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Why Pūkenga"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Care rooted in te ao Māori, shaped for everyday life</p>"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or symbol)",
          "default": "◈"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Rongoā Māori"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Traditional plant-based remedies woven into your wellbeing plan.</p>"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Quote card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>\"Papatūānuku welcomes your heaviness. Let it pour into her.\"</p>"
        },
        {
          "type": "text",
          "id": "attribution",
          "label": "Attribution",
          "default": "From the Hinātore set"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pūkenga Feature Grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "◈",
            "title": "Mātauranga",
            "text": "<p>Bring Te Ao Māori into everyday life.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "◎",
            "title": "Mō te katoa",
            "text": "<p>Taonga made for ages 5+, can be used anywhere, anytime.</p>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "△",
            "title": "Hauora",
            "text": "<p>Settle and nourish your mauri.</p>"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "<p>\"Papatūānuku welcomes your heaviness. Let it pour into her.\"</p>",
            "attribution": "From the Hinātore set"
          }
        }
      ]
    }
  ]
}
{% endschema %}
