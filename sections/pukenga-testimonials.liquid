<section class="pukenga-section pukenga-testimonials">
  <div class="section">

    {%- if section.settings.eyebrow != blank -%}
      <p class="pukenga-eyebrow pukenga-testimonials__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="pukenga-heading pukenga-testimonials__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    <div class="pukenga-testimonials__grid">

      {%- for block in section.blocks -%}

        <blockquote
          class="pukenga-testimonials__item"
          {{ block.shopify_attributes }}
        >

          {%- if block.settings.rating > 0 -%}
            <div
              class="pukenga-testimonials__stars"
              aria-label="{{ block.settings.rating }} out of 5 stars"
            >
              {%- for i in (1..5) -%}
                {%- if i <= block.settings.rating -%}
                  ★
                {%- else -%}
                  ☆
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.quote != blank -%}
            <div class="pukenga-testimonials__quote">
              {{ block.settings.quote }}
            </div>
          {%- endif -%}

          {%- if block.settings.name != blank or block.settings.role != blank -%}
            <footer class="pukenga-testimonials__author">

              {%- if block.settings.name != blank -%}
                <span class="pukenga-testimonials__name">
                  {{ block.settings.name | escape }}
                </span>
              {%- endif -%}

              {%- if block.settings.role != blank -%}
                <span class="pukenga-testimonials__role">
                  {{ block.settings.role | escape }}
                </span>
              {%- endif -%}

            </footer>
          {%- endif -%}

        </blockquote>

      {%- endfor -%}

    </div>

    <div
      class="pukenga-testimonials__dots"
      aria-label="Testimonials navigation"
    ></div>

  </div>
</section>


<style>

  /* =========================================
     MAIN SECTION
     ========================================= */

  .pukenga-testimonials {
    width: 100%;
    background: {{ section.settings.background_color }};

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }


  /* =========================================
     EYEBROW
     ========================================= */

  .pukenga-testimonials__eyebrow,
  .pukenga-testimonials__heading {
    text-align: {{ section.settings.text_alignment }};
  }


  /* =========================================
     HEADING
     ========================================= */

  .pukenga-testimonials__heading {
    font-size: clamp(
      {{ section.settings.heading_min_size }}px,
      3vw,
      {{ section.settings.heading_max_size }}px
    );

    max-width: {{ section.settings.heading_max_width }}px;

    margin-left: auto;
    margin-right: auto;

    margin-bottom: {{ section.settings.heading_bottom_spacing }}px;

    color: {{ section.settings.heading_color }};
  }


  /* =========================================
     DESKTOP GRID
     ========================================= */

  .pukenga-testimonials__grid {
    display: grid;

    grid-template-columns:
      repeat(
        {{ section.settings.columns }},
        minmax(0, 1fr)
      );

    gap: {{ section.settings.grid_gap }}px;
  }


  /* =========================================
     TESTIMONIAL CARD
     ========================================= */

  .pukenga-testimonials__item {
    margin: 0;

    padding-top: {{ section.settings.card_padding_top }}px;
    padding-bottom: {{ section.settings.card_padding_bottom }}px;
    padding-left: {{ section.settings.card_padding_horizontal }}px;
    padding-right: {{ section.settings.card_padding_horizontal }}px;

    border:
      {{ section.settings.card_border_width }}px solid
      {{ section.settings.card_border_color }};

    border-radius: {{ section.settings.card_border_radius }}px;

    box-sizing: border-box;
  }


  /* =========================================
     STARS
     ========================================= */

  .pukenga-testimonials__stars {
    color: {{ section.settings.star_color }};

    letter-spacing: {{ section.settings.star_spacing }}px;

    margin-bottom: {{ section.settings.star_bottom_spacing }}px;

    font-size: {{ section.settings.star_size }}px;
  }


  /* =========================================
     QUOTE
     ========================================= */

  .pukenga-testimonials__quote {
    font-family:
      var(
        --pukenga-font-heading,
        'Spectral',
        serif
      );

    font-weight: 300;

    font-style: italic;

    font-size: {{ section.settings.quote_font_size }}px;

    color: {{ section.settings.quote_color }};

    margin: 0 0 {{ section.settings.quote_bottom_spacing }}px;
  }


  .pukenga-testimonials__quote p {
    margin: 0;
  }


  /* =========================================
     AUTHOR
     ========================================= */

  .pukenga-testimonials__author {
    display: flex;

    gap: {{ section.settings.author_gap }}px;

    align-items: center;

    font-family:
      var(
        --pukenga-font-body,
        'Instrument Sans',
        sans-serif
      );
  }


  .pukenga-testimonials__name {
    font-size: {{ section.settings.name_font_size }}px;

    color: {{ section.settings.name_color }};
  }


  .pukenga-testimonials__role {
    font-size: {{ section.settings.role_font_size }}px;

    color: {{ section.settings.role_color }};
  }


  /* =========================================
     DOTS
     HIDDEN ON DESKTOP
     ========================================= */

  .pukenga-testimonials__dots {
    display: none;
  }


  /* =========================================
     MOBILE SLIDER
     ========================================= */

  @media screen and (max-width: 989px) {

    .pukenga-testimonials {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    /* -------------------------------
       MOBILE HEADING
       ------------------------------- */

    .pukenga-testimonials__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;

      margin-bottom: {{ section.settings.mobile_heading_bottom_spacing }}px;
    }


    /* -------------------------------
       MOBILE HORIZONTAL SLIDER
       ------------------------------- */

    .pukenga-testimonials__grid {
      display: flex;

      width: 100%;

      gap: {{ section.settings.mobile_grid_gap }}px;

      overflow-x: auto;
      overflow-y: hidden;

      scroll-snap-type: x mandatory;

      scroll-behavior: smooth;

      -webkit-overflow-scrolling: touch;

      scrollbar-width: none;
      -ms-overflow-style: none;

      overscroll-behavior-x: contain;
    }


    .pukenga-testimonials__grid::-webkit-scrollbar {
      display: none;
    }


    /* -------------------------------
       MOBILE CARD WIDTH
       Uses mobile_columns setting
       Example:
       1 = full card
       1.2 = 1 card + next card preview
       1.5 = smaller cards
       2 = two cards
       ------------------------------- */

    .pukenga-testimonials__item {

      flex: 0 0 calc(
        (
          100% -
          (
            {{ section.settings.mobile_columns }} - 1
          ) *
          {{ section.settings.mobile_grid_gap }}px
        ) /
        {{ section.settings.mobile_columns }}
      );

      width: calc(
        (
          100% -
          (
            {{ section.settings.mobile_columns }} - 1
          ) *
          {{ section.settings.mobile_grid_gap }}px
        ) /
        {{ section.settings.mobile_columns }}
      );

      min-width: calc(
        (
          100% -
          (
            {{ section.settings.mobile_columns }} - 1
          ) *
          {{ section.settings.mobile_grid_gap }}px
        ) /
        {{ section.settings.mobile_columns }}
      );

      box-sizing: border-box;

      padding-top: {{ section.settings.mobile_card_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_card_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_card_padding_horizontal }}px;
      padding-right: {{ section.settings.mobile_card_padding_horizontal }}px;

      scroll-snap-align: start;
      scroll-snap-stop: always;

      margin: 0;
    }


    /* -------------------------------
       MOBILE QUOTE
       ------------------------------- */

    .pukenga-testimonials__quote {
      font-size: {{ section.settings.mobile_quote_font_size }}px;
    }


    /* -------------------------------
       MOBILE DOTS
       ------------------------------- */

    .pukenga-testimonials__dots {
      display: flex;

      justify-content: center;
      align-items: center;

      gap: 10px;

      margin-top: 26px;
    }


    .pukenga-testimonials__dot {
      display: block;

      width: 10px;
      height: 10px;

      padding: 0;
      margin: 0;

      border: 0;

      border-radius: 50%;

      background: rgba(242, 236, 220, 0.28);

      cursor: pointer;

      appearance: none;
      -webkit-appearance: none;

      transition:
        width 0.25s ease,
        background 0.25s ease,
        border-radius 0.25s ease;
    }


    .pukenga-testimonials__dot.is-active {
      width: 26px;

      border-radius: 10px;

      background: {{ section.settings.star_color }};
    }

  }

</style>


<script>
  document.addEventListener('DOMContentLoaded', function () {

    const section = document.querySelector(
      '#shopify-section-{{ section.id }}'
    );

    if (!section) return;


    const slider = section.querySelector(
      '.pukenga-testimonials__grid'
    );

    const dotsContainer = section.querySelector(
      '.pukenga-testimonials__dots'
    );


    if (!slider || !dotsContainer) return;


    const cards = Array.from(
      slider.querySelectorAll(
        '.pukenga-testimonials__item'
      )
    );


    if (cards.length <= 1) {
      dotsContainer.style.display = 'none';
      return;
    }


    /* =========================================
       CREATE DOTS
       ========================================= */

    dotsContainer.innerHTML = '';


    cards.forEach(function (card, index) {

      const dot = document.createElement('button');

      dot.type = 'button';

      dot.className =
        'pukenga-testimonials__dot' +
        (index === 0 ? ' is-active' : '');

      dot.setAttribute(
        'aria-label',
        'Go to testimonial ' + (index + 1)
      );


      dot.addEventListener('click', function () {

        slider.scrollTo({
          left: card.offsetLeft,
          behavior: 'smooth'
        });

      });


      dotsContainer.appendChild(dot);

    });


    const dots = Array.from(
      dotsContainer.querySelectorAll(
        '.pukenga-testimonials__dot'
      )
    );


    /* =========================================
       FIND CURRENT SLIDE
       ========================================= */

    function updateActiveDot() {

      let closestIndex = 0;

      let closestDistance = Infinity;


      cards.forEach(function (card, index) {

        const distance = Math.abs(
          card.offsetLeft - slider.scrollLeft
        );


        if (distance < closestDistance) {

          closestDistance = distance;

          closestIndex = index;

        }

      });


      dots.forEach(function (dot, index) {

        dot.classList.toggle(
          'is-active',
          index === closestIndex
        );

      });

    }


    /* =========================================
       UPDATE DOTS WHILE SWIPING
       ========================================= */

    let ticking = false;


    slider.addEventListener('scroll', function () {

      if (ticking) return;


      window.requestAnimationFrame(function () {

        updateActiveDot();

        ticking = false;

      });


      ticking = true;

    });


    /* =========================================
       RESIZE
       ========================================= */

    window.addEventListener(
      'resize',
      function () {
        updateActiveDot();
      }
    );


    updateActiveDot();

  });
</script>


