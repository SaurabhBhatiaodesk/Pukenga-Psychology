<section class="pukenga-section section section--full-width pukenga-promo" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="pukenga-promo__media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1800 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 1800 }} 1800w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        loading="lazy"
      >
    {%- else -%}
      <img src="{{ 'pukenga-promo-banner.jpg' | asset_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
    {%- endif -%}
    <div class="pukenga-promo__overlay"></div>
  </div>

  <div class="pukenga-promo__content pukenga-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="pukenga-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="pukenga-promo__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="pukenga-promo__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="pukenga-btn pukenga-btn--primary">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .pukenga-promo {
    position: relative;
    min-height: 460px;
    display: grid;
    align-items: center;
    overflow: hidden;
  }

  .pukenga-promo__media {
    position: absolute;
    inset: 0;
  }

  .pukenga-promo__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pukenga-promo__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 25, 15, 0.85) 0%, rgba(15, 25, 15, 0.5) 60%, rgba(15, 25, 15, 0.2) 100%);
  }

  .pukenga-promo__content {
    position: relative;
    z-index: 1;
    max-width: 460px;
  }

  .pukenga-promo__heading {
    font-family: var(--pukenga-font-heading, 'Spectral', serif);
    font-weight: 300;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--pukenga-cream, #f2ecdc);
    margin: 0 0 18px;
    line-height: 1.15;
  }

  .pukenga-promo__text {
    font-family: var(--pukenga-font-body, 'Instrument Sans', sans-serif);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--pukenga-cream-soft, #ece5d4);
    margin: 0 0 28px;
  }

  @media screen and (max-width: 749px) {
    .pukenga-promo {
      min-height: 380px;
    }

    .pukenga-promo__overlay {
      background: linear-gradient(180deg, rgba(15, 25, 15, 0.5) 0%, rgba(15, 25, 15, 0.92) 70%);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pūkenga Promo Banner",
  "tag": "section",
  "class": "section-pukenga-promo",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "On-demand program"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Discover the power of Mauri Tau</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Grounded in mātauranga Māori. Learn to cultivate a state of inner calm and balance to support your wellbeing.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Pūkenga Promo Banner"
    }
  ]
}
{% endschema %}
