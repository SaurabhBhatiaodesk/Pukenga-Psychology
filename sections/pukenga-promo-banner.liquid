<section class="pukenga-section on-demand section--full-width pukenga-promo">
  <div class="pukenga-promo__overlay"></div>

  <div class="section">
    <div class="pukenga-promo__content">

      {% if section.settings.eyebrow != blank %}
        <p class="pukenga-eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="pukenga-promo__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="pukenga-promo__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="pukenga-btn pukenga-btn--primary"
        >
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}

    </div>
  </div>
</section>

<style>

  /* =========================================
     PROMO BANNER
  ========================================= */

  .pukenga-promo {
    position: relative;

    min-height: {{ section.settings.desktop_height }}px;

    display: flex;
    align-items: {{ section.settings.content_vertical_alignment }};

    overflow: hidden;

    background-color: {{ section.settings.background_color }};

    {% if section.settings.image != blank %}
      background-image: url('{{ section.settings.image | image_url: width: 2000 }}');
    {% endif %}

    background-size: {{ section.settings.background_size }};
    background-position:
      {{ section.settings.desktop_image_position_x }}%
      {{ section.settings.desktop_image_position_y }}%;
    background-repeat: no-repeat;
  }


  /* =========================================
     OVERLAY
  ========================================= */

  .pukenga-promo__overlay {
    position: absolute;
    inset: 0;

    background:
      {{ section.settings.overlay_color }};

    opacity:
      {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }


  /* =========================================
     CONTENT
  ========================================= */

  .pukenga-promo__content {
    position: relative;

    z-index: 2;

    width: 100%;

    max-width:
      {{ section.settings.content_max_width }}px;

    margin-left: 0;
    margin-right: auto;

    text-align:
      {{ section.settings.text_alignment }};
  }


  /* =========================================
     HEADING
  ========================================= */

  .pukenga-promo__heading {
    font-family:
      var(--pukenga-font-heading, 'Spectral', serif);

    font-weight: 300;

    font-size:
      {{ section.settings.heading_size }}px;

    color:
      {{ section.settings.heading_color }};

    margin:
      0 0 {{ section.settings.heading_margin_bottom }}px;

    line-height: 1.15;
  }


  /* =========================================
     TEXT
  ========================================= */

  .pukenga-promo__text {
    font-family:
      var(--pukenga-font-body, 'Instrument Sans', sans-serif);
    opacity: 0.86;
    font-size:
      {{ section.settings.text_size }}px;

    line-height: 1.6;

    color:
      {{ section.settings.text_color }};

    margin:
      0 0 {{ section.settings.text_margin_bottom }}px;

    max-width:
      {{ section.settings.text_max_width }}px;
  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    .pukenga-promo {
      min-height:
        {{ section.settings.mobile_height }}px;

      align-items:
        {{ section.settings.mobile_content_vertical_alignment }};

      background-position:
        {{ section.settings.mobile_image_position_x }}%
        {{ section.settings.mobile_image_position_y }}%;
    }


    {% if section.settings.mobile_image != blank %}

      .pukenga-promo {
        background-image:
          url('{{ section.settings.mobile_image | image_url: width: 1400 }}');
      }

    {% endif %}


    .pukenga-promo__content {
      max-width:
        {{ section.settings.mobile_content_max_width }}px;

      text-align:
        {{ section.settings.mobile_text_alignment }};
    }


    .pukenga-promo__heading {
      font-size:
        {{ section.settings.mobile_heading_size }}px;
    }


    .pukenga-promo__text {
      font-size:
        {{ section.settings.mobile_text_size }}px;

      max-width: 100%;
    }

  }

</style>


{% schema %}
