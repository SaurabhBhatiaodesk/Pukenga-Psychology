<section class="pukenga-section pukenga-newsletter">
  <div class="section pukenga-newsletter__inner">

    {%- if section.settings.eyebrow != blank -%}
      <p class="pukenga-eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="pukenga-heading pukenga-newsletter__heading">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="pukenga-body pukenga-newsletter__text">
        {{ section.settings.text }}
      </div>
    {%- endif -%}


    {%- form 'customer', class: 'pukenga-newsletter__form' -%}

      <input
        type="hidden"
        name="contact[tags]"
        value="newsletter"
      >

      {%- if form.posted_successfully? -%}

        <p
          class="pukenga-newsletter__success"
          role="status"
        >
          {{ section.settings.success_text | default: 'Thanks — you are on the list.' }}
        </p>

      {%- else -%}

        <div class="pukenga-newsletter__field-group">

          <label
            for="NewsletterEmail-{{ section.id }}"
            class="visually-hidden"
          >
            {{ 'blocks.email_signup.label' | t }}
          </label>

          <input
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="pukenga-newsletter__input"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ section.settings.input_placeholder }}"
            required

            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="NewsletterEmail-error-{{ section.id }}"
            {% endif %}
          >

          <button
            type="submit"
            class="pukenga-btn pukenga-btn--primary pukenga-newsletter__submit"
          >
            {{ section.settings.button_label | default: 'Subscribe' }}
          </button>

        </div>


        {%- if form.errors -%}

          <p
            id="NewsletterEmail-error-{{ section.id }}"
            class="pukenga-newsletter__error"
          >
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>

        {%- endif -%}

      {%- endif -%}

    {%- endform -%}

  </div>
</section>


<style>

  .pukenga-newsletter {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }


  .pukenga-newsletter__inner {
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;

    text-align: {{ section.settings.text_alignment }};
  }


  .pukenga-newsletter__heading {
    font-size: clamp(
      {{ section.settings.heading_min_size }}px,
      3vw,
      {{ section.settings.heading_max_size }}px
    );

    color: {{ section.settings.heading_color }};
  }


  .pukenga-newsletter__text {
    max-width: {{ section.settings.text_max_width }}px;
    margin-left: auto;
    margin-right: auto;
    color: {{ section.settings.text_color }};
  }


  .pukenga-newsletter__form {
    margin-top: {{ section.settings.form_top_spacing }}px;
  }


  .pukenga-newsletter__field-group {
    display: flex;
    gap: {{ section.settings.input_button_gap }}px;
    max-width: {{ section.settings.form_max_width }}px;
    margin: 0 auto;
  }


  .pukenga-newsletter__input {
    flex: 1;

    font-family: var(
      --pukenga-font-body,
      'Instrument Sans',
      sans-serif
    );

    font-size: {{ section.settings.input_font_size }}px;

    color: {{ section.settings.input_text_color }};

    background: {{ section.settings.input_background_color }};

    border: {{ section.settings.input_border_width }}px solid
      {{ section.settings.input_border_color }};

    border-radius: {{ section.settings.input_border_radius }}px;

    padding-top: {{ section.settings.input_padding_vertical }}px;
    padding-bottom: {{ section.settings.input_padding_vertical }}px;

    padding-left: {{ section.settings.input_padding_horizontal }}px;
    padding-right: {{ section.settings.input_padding_horizontal }}px;
  }


  .pukenga-newsletter__input::placeholder {
    color: {{ section.settings.placeholder_color }};
  }


  .pukenga-newsletter__submit {
    flex-shrink: 0;
  }


  .pukenga-newsletter__error {
    color: {{ section.settings.error_color }};
    font-size: {{ section.settings.error_font_size }}px;
    margin-top: 12px;
  }


  .pukenga-newsletter__success {
    font-family: var(
      --pukenga-font-body,
      'Instrument Sans',
      sans-serif
    );

    color: {{ section.settings.success_color }};
    font-size: {{ section.settings.success_font_size }}px;
  }


  @media screen and (max-width: 749px) {

    .pukenga-newsletter__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    .pukenga-newsletter__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }


    .pukenga-newsletter__text {
      max-width: {{ section.settings.mobile_text_max_width }}px;
    }


    .pukenga-newsletter__form {
      margin-top: {{ section.settings.mobile_form_top_spacing }}px;
    }


    .pukenga-newsletter__field-group {
      flex-direction: column;
      gap: {{ section.settings.mobile_input_button_gap }}px;
    }


    .pukenga-newsletter__input {
      font-size: {{ section.settings.mobile_input_font_size }}px;

      padding-top: {{ section.settings.mobile_input_padding_vertical }}px;
      padding-bottom: {{ section.settings.mobile_input_padding_vertical }}px;

      padding-left: {{ section.settings.mobile_input_padding_horizontal }}px;
      padding-right: {{ section.settings.mobile_input_padding_horizontal }}px;
    }

  }

</style>


