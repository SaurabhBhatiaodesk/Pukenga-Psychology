{{ 'pukenga-theme.css' | asset_url | stylesheet_tag }}

<div class="pukenga-best-sellers pukenga-section">
  <div class="pukenga-container">
    <div class="pukenga-best-sellers__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="pukenga-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pukenga-heading pukenga-best-sellers__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="pukenga-link">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </div>

    <div class="pukenga-best-sellers__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' -%}
          {%- assign product = block.settings.product -%}
          <div class="pukenga-product-card" {{ block.shopify_attributes }}>
            <div class="pukenga-product-card__media">
              {%- if block.settings.custom_image != blank -%}
                {{ block.settings.custom_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'pukenga-product-card__image', sizes: '(min-width: 750px) 33vw, 90vw', widths: '400, 600, 900' }}
              {%- elsif product != blank and product.featured_image -%}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'pukenga-product-card__image', sizes: '(min-width: 750px) 33vw, 90vw', widths: '400, 600, 900' }}
              {%- endif -%}
              {%- if block.settings.show_sale_badge -%}
                <span class="pukenga-product-card__badge">Sale</span>
              {%- endif -%}
            </div>
            <div class="pukenga-product-card__info">
              <h3 class="pukenga-product-card__title">
                {{ block.settings.title | default: product.title }}
              </h3>
              <div class="pukenga-product-card__price-row">
                <p class="pukenga-product-card__price">
                  {%- if product != blank -%}
                    {{ product.price | money }}
                    {%- if product.compare_at_price > product.price -%}
                      <s class="pukenga-product-card__compare">{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  {%- else -%}
                    {{ block.settings.price }}
                    {%- if block.settings.compare_at_price != blank -%}
                      <s class="pukenga-product-card__compare">{{ block.settings.compare_at_price }}</s>
                    {%- endif -%}
                  {%- endif -%}
                </p>
                {%- if product != blank -%}
                  {%- form 'product', product -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" class="pukenga-product-card__add">Add</button>
                  {%- endform -%}
                {%- else -%}
                  <a href="{{ block.settings.link | default: '#' }}" class="pukenga-product-card__add">Add</a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .pukenga-best-sellers {
    padding-block: 88px;
  }

  .pukenga-best-sellers__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 48px;
    gap: 24px;
  }

  .pukenga-best-sellers__heading {
    font-size: 40px;
    margin: 0;
  }

  .pukenga-best-sellers__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .pukenga-product-card__media {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--pukenga-bg-soft);
  }

  .pukenga-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pukenga-product-card__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: var(--pukenga-gold);
    color: var(--pukenga-bg);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 40px;
  }

  .pukenga-product-card__info {
    padding-top: 16px;
  }

  .pukenga-product-card__title {
    font-family: var(--pukenga-font-body);
    font-weight: 500;
    font-size: 16px;
    color: var(--pukenga-cream-soft);
    margin: 0 0 8px;
  }

  .pukenga-product-card__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .pukenga-product-card__price {
    margin: 0;
    font-size: 15px;
    color: var(--pukenga-cream-soft);
  }

  .pukenga-product-card__compare {
    color: var(--pukenga-muted);
    margin-left: 8px;
    font-size: 13px;
  }

  .pukenga-product-card__add {
    font-family: var(--pukenga-font-body);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--pukenga-gold);
    background: transparent;
    border: 1px solid rgba(224, 183, 132, 0.5);
    border-radius: 40px;
    padding: 9px 16px;
    cursor: pointer;
    text-decoration: none;
  }

  .pukenga-product-card__add:hover {
    background: rgba(224, 183, 132, 0.1);
  }

  @media screen and (max-width: 989px) {
    .pukenga-best-sellers__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 549px) {
    .pukenga-best-sellers__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .pukenga-best-sellers__grid {
      grid-template-columns: 1fr;
    }
    .pukenga-best-sellers__heading {
      font-size: 30px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pukenga Best Sellers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "best sellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ngā mea rongonui"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Toa katoa · View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Uses the product's live price/image. Leave blank to use manual fields below."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Manual title override"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Manual image override"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Manual price (used if no product selected)"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Manual compare-at price"
        },
        {
          "type": "checkbox",
          "id": "show_sale_badge",
          "label": "Show sale badge",
          "default": false
        },
        {
          "type": "url",
          "id": "link",
          "label": "Manual link (used if no product selected)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Pukenga Best Sellers",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "title": "Ngākau Karakia Set",
            "price": "$55"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Maha Oranga Bundle",
            "price": "$140",
            "compare_at_price": "$486",
            "show_sale_badge": true
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Audio Karakia Collection",
            "price": "$19.99"
          }
        }
      ]
    }
  ]
}
{% endschema %}
