<section
  class="pukenga-about"
  style="
    --about-bg: {{ section.settings.background_color }};
    --about-desktop-top: {{ section.settings.padding_top }}px;
    --about-desktop-bottom: {{ section.settings.padding_bottom }}px;
    --about-mobile-top: {{ section.settings.mobile_padding_top }}px;
    --about-mobile-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="pukenga-about__grid">

    <!-- CONTENT -->
    <div class="pukenga-about__content">
      <div class="section">

        {%- if section.settings.eyebrow != blank -%}
          <p class="pukenga-eyebrow pukenga-about__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="pukenga-heading pukenga-about__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="pukenga-body pukenga-about__text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <p class="pukenga-about__signature">
            {{ section.settings.signature | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="pukenga-link pukenga-about__link"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}

      </div>
    </div>


    <!-- IMAGE -->
    <div class="pukenga-about__media">

      {%- if section.settings.image != blank -%}

        <img
          class="pukenga-about__image pukenga-about__image--desktop"
          src="{{ section.settings.image | image_url: width: 1800 }}"
          srcset="
            {{ section.settings.image | image_url: width: 800 }} 800w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w,
            {{ section.settings.image | image_url: width: 1600 }} 1600w,
            {{ section.settings.image | image_url: width: 1800 }} 1800w
          "
          sizes="50vw"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
        >

      {%- endif -%}


      {%- if section.settings.mobile_image != blank -%}

        <img
          class="pukenga-about__image pukenga-about__image--mobile"
          src="{{ section.settings.mobile_image | image_url: width: 1200 }}"
          srcset="
            {{ section.settings.mobile_image | image_url: width: 500 }} 500w,
            {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
            {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w,
            {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
          width="{{ section.settings.mobile_image.width }}"
          height="{{ section.settings.mobile_image.height }}"
          alt="{{ section.settings.mobile_image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
        >

      {%- elsif section.settings.image != blank -%}

        <img
          class="pukenga-about__image pukenga-about__image--mobile"
          src="{{ section.settings.image | image_url: width: 1200 }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          loading="lazy"
        >

      {%- endif -%}

    </div>

  </div>
</section>


<style>

  /* =========================================
     MAIN SECTION
  ========================================= */

  .pukenga-about {
    width: 100%;
    background: var(--about-bg);

    padding-top: var(--about-desktop-top);
    padding-bottom: var(--about-desktop-bottom);

    overflow: hidden;
  }


  /* =========================================
     DESKTOP GRID
  ========================================= */

  .pukenga-about__grid {
    display: flex;
    flex-direction: row;

    width: 100%;
    max-width: none;

    margin: 0;
    padding: 0;

    align-items: stretch;

    gap: 0;
  }


  /* =========================================
     CONTENT
  ========================================= */

  .pukenga-about__content {
    width: 50%;
    flex: 0 0 50%;

    order: 1;

    display: flex;
    align-items: center;
  }


  .pukenga-about__content > .section {
    width: 100%;
  }


  /* =========================================
     IMAGE
  ========================================= */

  .pukenga-about__media {
    width: 50%;
    flex: 0 0 50%;

    order: 2;

    min-width: 0;

    overflow: hidden;

    border-radius: 0;
  }


  .pukenga-about__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* Desktop image */

  .pukenga-about__image--desktop {
    display: block;

    aspect-ratio: {{ section.settings.desktop_image_ratio }};

    object-position:
      {{ section.settings.desktop_image_position_x }}%
      {{ section.settings.desktop_image_position_y }}%;
  }


  /* Mobile image hidden on desktop */

  .pukenga-about__image--mobile {
    display: none;
  }


  /* =========================================
     REVERSE DESKTOP COLUMNS
  ========================================= */

  {% if section.settings.desktop_column_reverse %}

    .pukenga-about__content {
      order: 2;
    }

    .pukenga-about__media {
      order: 1;
    }

  {% endif %}


  /* =========================================
     CONTENT TYPOGRAPHY
  ========================================= */

  .pukenga-about__heading {
    font-size: {{ section.settings.heading_max_size }}px;

    margin-top: 0;

    margin-bottom:
      {{ section.settings.heading_margin_bottom }}px;
  }


  .pukenga-about__text {
    font-size: 15.5px;

    line-height: 1.75;

    color: #ece5d4;

    opacity: 0.85;

    margin-bottom:
      {{ section.settings.text_margin_bottom }}px;
  }


  .pukenga-about__signature {
    font-family:
      var(--pukenga-font-heading, 'Spectral', serif);

    font-style: italic;

    color:
      var(--pukenga-gold, #e0b784);

    margin:
      0 0 {{ section.settings.signature_margin_bottom }}px;
  }


  .pukenga-about__link {
    display: inline-block;
  }


  /* =========================================
     DESKTOP IMAGE RADIUS
  ========================================= */

  .pukenga-about__media {
    border-radius:
      {{ section.settings.image_border_radius }}px 0 0 0;
  }


  {% if section.settings.desktop_column_reverse %}

    .pukenga-about__media {
      border-radius:
        0 {{ section.settings.image_border_radius }}px 0 0;
    }

  {% endif %}


  /* =========================================
     TABLET / MOBILE
  ========================================= */

  @media screen and (max-width: 989px) {

    .pukenga-about {
      padding-top: var(--about-mobile-top);
      padding-bottom: var(--about-mobile-bottom);
    }


    .pukenga-about__grid {
      display: flex;

      flex-direction: column;

      width: 100%;

      gap: 0;
    }


    /* Image first on mobile */

    .pukenga-about__media {
      order: 1;

      width: 100%;
      flex: 0 0 100%;

      border-radius: 0;
    }


    /* Content second on mobile */

    .pukenga-about__content {
      order: 2;

      width: 100%;
      flex: 0 0 100%;

      display: block;
    }


    /* Never reverse mobile order */

    .pukenga-about__image--desktop {
      display: none;
    }


    .pukenga-about__image--mobile {
      display: block;

      width: 100%;
      height: auto;

      aspect-ratio:
        {{ section.settings.mobile_image_ratio }};

      object-fit: cover;

      object-position:
        {{ section.settings.mobile_image_position_x }}%
        {{ section.settings.mobile_image_position_y }}%;
    }


    .pukenga-about__media {
      border-radius:
        {{ section.settings.mobile_image_border_radius }}px;
    }

  }


  /* =========================================
     SMALL MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {

    .pukenga-about__content > .section {
      width: 100%;
    }


    .pukenga-about__heading {
      font-size:
        {{ section.settings.mobile_heading_size }}px;

      line-height: 1.12;
    }

  }

</style>


{% schema %}
{
  "name": "Pūkenga About",
  "tag": "section",
  "class": "section-pukenga-about",

  "settings": [

    {
      "type": "header",
      "content": "Images"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Use a separate image for mobile devices."
    },


    {
      "type": "header",
      "content": "Desktop layout"
    },

    {
      "type": "checkbox",
      "id": "desktop_column_reverse",
      "label": "Reverse desktop columns",
      "info": "Turn on to place the image on the left and content on the right.",
      "default": false
    },

    {
      "type": "select",
      "id": "desktop_image_ratio",
      "label": "Desktop image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1 Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5 Portrait"
        },
        {
          "value": "3 / 4",
          "label": "3:4 Portrait"
        },
        {
          "value": "4 / 3",
          "label": "4:3 Landscape"
        },
        {
          "value": "16 / 10",
          "label": "16:10 Landscape"
        },
        {
          "value": "16 / 9",
          "label": "16:9 Landscape"
        }
      ],
      "default": "4 / 5"
    },


    {
      "type": "header",
      "content": "Desktop image crop"
    },

    {
      "type": "range",
      "id": "desktop_image_position_x",
      "label": "Horizontal image position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "desktop_image_position_y",
      "label": "Vertical image position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Desktop image radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },


    {
      "type": "header",
      "content": "Mobile image"
    },

    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1 Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5 Portrait"
        },
        {
          "value": "3 / 4",
          "label": "3:4 Portrait"
        },
        {
          "value": "16 / 10",
          "label": "16:10 Landscape"
        },
        {
          "value": "16 / 9",
          "label": "16:9 Landscape"
        }
      ],
      "default": "16 / 10"
    },


    {
      "type": "header",
      "content": "Mobile image crop"
    },

    {
      "type": "range",
      "id": "mobile_image_position_x",
      "label": "Horizontal image position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "mobile_image_position_y",
      "label": "Vertical image position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 25
    },

    {
      "type": "range",
      "id": "mobile_image_border_radius",
      "label": "Mobile image radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },


    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Ko wai au"
    },

    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Kia ora, I'm Dr Jessica</p>"
    },

    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A Registered Clinical Psychologist committed to creating Māori wellbeing resources for everyday people, to help you whakapiki your hauora.</p><p>I make aspects of Te Ao Māori easily accessible for those who need it.</p>"
    },

    {
      "type": "text",
      "id": "signature",
      "label": "Signature line"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Pānui atu · Read more"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Link URL"
    },


    {
      "type": "header",
      "content": "Colours"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Section background colour",
      "default": "#1d3323"
    },


    {
      "type": "header",
      "content": "Heading"
    },

    {
      "type": "range",
      "id": "heading_max_size",
      "label": "Desktop heading size",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 38
    },

    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },

    {
      "type": "range",
      "id": "text_margin_bottom",
      "label": "Text bottom spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },


    {
      "type": "header",
      "content": "Signature"
    },

    {
      "type": "range",
      "id": "signature_margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },


    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 38
    },


    {
      "type": "header",
      "content": "Section spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }

  ],

  "presets": [
    {
      "name": "Pūkenga About"
    }
  ]
}
{% endschema %}