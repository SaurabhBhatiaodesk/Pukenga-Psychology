{%- liquid
  assign about_section_id = section.settings.section_id | strip

  if about_section_id == blank
    assign about_section_id = 'pukenga-about-' | append: section.id
  else
    assign about_section_id = about_section_id | handleize
  endif
-%}

<section
  id="{{ about_section_id }}"
  class="pukenga-section pukenga-about pukenga-about-{{ section.id }}"
  data-pukenga-about-section="{{ section.id }}"
  style="background: {{ section.settings.background_color }};"
>
  <div class="section">
    <div class="pukenga-container pukenga-about__grid">

      <!-- CONTENT -->
      <div class="pukenga-about__content">

        {%- if section.settings.eyebrow != blank -%}
          <p class="pukenga-eyebrow pukenga-about__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="pukenga-heading pukenga-about__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%} 

        {%- if section.settings.text != blank -%}
          <div class="pukenga-body pukenga-about__text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <p class="pukenga-about__signature">
            {{ section.settings.signature | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="pukenga-link pukenga-about__link"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}

      </div>

      <!-- IMAGE -->
      <div class="pukenga-about__media">

        <!-- Desktop Image -->
        {%- if section.settings.image != blank -%}
          <img
            class="pukenga-about__image pukenga-about__image--desktop"
            src="{{ section.settings.image | image_url: width: 1400 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1400 }} 1400w
            "
            sizes="(min-width: 990px) 50vw, 100vw"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >
        {%- endif -%}

        <!-- Mobile Image -->
        {%- if section.settings.mobile_image != blank -%}
          <img
            class="pukenga-about__image pukenga-about__image--mobile"
            src="{{ section.settings.mobile_image | image_url: width: 1000 }}"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 500 }} 500w,
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
            width="{{ section.settings.mobile_image.width }}"
            height="{{ section.settings.mobile_image.height }}"
            alt="{{ section.settings.mobile_image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >

        {%- elsif section.settings.image != blank -%}

          <!-- Desktop image fallback on mobile -->
          <img
            class="pukenga-about__image pukenga-about__image--mobile"
            src="{{ section.settings.image | image_url: width: 1000 }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >

        {%- endif -%}

      </div>

    </div>
  </div>
</section>


<style>

  /* =========================================
     MAIN SECTION
     All selectors below are scoped to
     .pukenga-about-{{ section.id }} because this
     section can appear more than once on a page
     (e.g. the bio block and the quote block both
     use it) and this is a plain style tag; unscoped
     rules here would leak and the LAST rendered instance's CSS
     would silently win for every instance on the
     page, regardless of each instance's own
     settings.
  ========================================= */

  .pukenga-about-{{ section.id }} {
    width: 100%;
    background: {{ section.settings.background_color }};

    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }


  /* =========================================
     CONTAINER
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-container {
    width: 100%;
  }

  /* =========================================
     DESKTOP GRID
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__grid {
    display: grid;
    gap: {{ section.settings.desktop_gap }}px;
    align-items: {{ section.settings.vertical_alignment }};

    {% if section.settings.desktop_image_position == 'left' %}
      grid-template-columns:
        {{ section.settings.desktop_image_width }}
        {{ section.settings.desktop_content_width }};
      grid-template-areas: "media content";
    {% else %}
      grid-template-columns:
        {{ section.settings.desktop_content_width }}
        {{ section.settings.desktop_image_width }};
      grid-template-areas: "content media";
    {% endif %}
  }


  /* =========================================
     CONTENT
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__content {
    grid-area: content;
    width: 100%;
  }


  /* =========================================
     IMAGE AREA PLACEMENT
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__media {
    grid-area: media;
  }


  /* =========================================
     IMAGE
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__media {
    width: 100%;
    overflow: hidden;

    border-radius:
      {{ section.settings.image_border_radius }}px;
  }


  .pukenga-about-{{ section.id }} .pukenga-about__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  /* =========================================
     DESKTOP IMAGE
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__image--desktop {
    display: block;

    aspect-ratio:
      {{ section.settings.desktop_image_ratio }};

    object-position:
      {{ section.settings.desktop_image_position_x }}%
      {{ section.settings.desktop_image_position_y }}%;
  }


  /* =========================================
     MOBILE IMAGE HIDDEN BY DEFAULT
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__image--mobile {
    display: none;
  }


  /* =========================================
     HEADING
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__heading {
    font-size: {{ section.settings.heading_max_size }}px;

    margin-bottom:
      {{ section.settings.heading_margin_bottom }}px;
  }


  /* =========================================
     TEXT
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__text {
    font-size: {{ section.settings.text_font_size | default: 16 }}px;
    line-height: 1.75;
    opacity: 0.85;
    letter-spacing: 0.14em;
    color: #ece5d4;

    margin-bottom:
      {{ section.settings.text_margin_bottom }}px;
  }


  /* =========================================
     SIGNATURE
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__signature {
    font-family:
      var(--pukenga-font-heading, 'Spectral', serif);

    font-style: italic;

    color:
      var(--pukenga-gold, #e0b784);

    margin:
      0 0 {{ section.settings.signature_margin_bottom }}px;
  }


  /* =========================================
     LINK
  ========================================= */

  .pukenga-about-{{ section.id }} .pukenga-about__link {
    display: inline-block;
  }


  /* =========================================
     TABLET
  ========================================= */

  @media screen and (max-width: 989px) {

    .pukenga-about-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }


    .pukenga-about-{{ section.id }} .pukenga-about__grid {
      grid-template-columns: 1fr;
      grid-template-areas: "media" "content";

      gap:
        {{ section.settings.mobile_gap }}px;
    }


    /* IMAGE FIRST */

    .pukenga-about-{{ section.id }} .pukenga-about__media {
      grid-column: 1;
      grid-row: 1;

      border-radius:
        {{ section.settings.mobile_image_border_radius }}px;
    }


    /* CONTENT SECOND */

    .pukenga-about-{{ section.id }} .pukenga-about__content {
      grid-column: 1;
      grid-row: 2;

      padding:
        {{ section.settings.mobile_content_padding_top | default: 22 }}px
        {{ section.settings.mobile_content_padding_horizontal | default: 16 }}px
        {{ section.settings.mobile_content_padding_bottom | default: 0 }}px;
    }


    /* DESKTOP IMAGE HIDDEN */

    .pukenga-about-{{ section.id }} .pukenga-about__image--desktop {
      display: none;
    }


    /* MOBILE IMAGE SHOWN */

    .pukenga-about-{{ section.id }} .pukenga-about__image--mobile {
      display: block;

      width: 100%;
      height: auto;

      aspect-ratio:
        {{ section.settings.mobile_image_ratio }};

      object-fit: cover;

      object-position:
        {{ section.settings.mobile_image_position_x }}%
        {{ section.settings.mobile_image_position_y }}%;
    }

  }


  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 749px) {
    .pukenga-about-{{ section.id }} .pukenga-about__text{
      font-size: {{ section.settings.mobile_text_font_size | default: 11 }}px;
    }
    .pukenga-about-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .pukenga-about-{{ section.id }} .section {
      display: block;
    }

    .pukenga-about-{{ section.id }} .pukenga-about__content {
      padding:
        {{ section.settings.mobile_content_padding_top | default: 22 }}px
        {{ section.settings.mobile_content_padding_horizontal | default: 16 }}px
        {{ section.settings.mobile_content_padding_bottom | default: 0 }}px;
    }

    .pukenga-about-{{ section.id }} .pukenga-about__grid {
      gap:
        {{ section.settings.small_mobile_gap }}px;
    }


    .pukenga-about-{{ section.id }} .pukenga-about__heading {
      font-size:
        {{ section.settings.mobile_heading_size }}px;

      line-height: 1.12;
    }

  }

</style>


{% schema %}
{
  "name": "Pūkenga About",
  "tag": "section",
  "class": "section-pukenga-about",

  "settings": [

    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID",
      "info": "Optional anchor ID. Leave blank to use this section's unique Shopify ID."
    },

    {
      "type": "header",
      "content": "Images"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },

    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Use a separate image for mobile devices."
    },

    {
      "type": "select",
      "id": "desktop_image_position",
      "label": "Desktop image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },

    {
      "type": "select",
      "id": "desktop_content_width",
      "label": "Desktop content width",
      "options": [
        {
          "value": "0.8fr",
          "label": "45%"
        },
        {
          "value": "0.9fr",
          "label": "47%"
        },
        {
          "value": "1fr",
          "label": "50%"
        },
        {
          "value": "1.1fr",
          "label": "52%"
        },
        {
          "value": "1.2fr",
          "label": "55%"
        }
      ],
      "default": "1fr"
    },

    {
      "type": "select",
      "id": "desktop_image_width",
      "label": "Desktop image width",
      "options": [
        {
          "value": "0.8fr",
          "label": "45%"
        },
        {
          "value": "0.9fr",
          "label": "47%"
        },
        {
          "value": "1fr",
          "label": "50%"
        },
        {
          "value": "1.1fr",
          "label": "52%"
        },
        {
          "value": "1.2fr",
          "label": "55%"
        }
      ],
      "default": "0.9fr"
    },

    {
      "type": "select",
      "id": "desktop_image_ratio",
      "label": "Desktop image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1 Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5 Portrait"
        },
        {
          "value": "3 / 4",
          "label": "3:4 Portrait"
        },
        {
          "value": "4 / 3",
          "label": "4:3 Landscape"
        },
        {
          "value": "16 / 10",
          "label": "16:10 Landscape"
        },
        {
          "value": "16 / 9",
          "label": "16:9 Landscape"
        }
      ],
      "default": "4 / 5"
    },

    {
      "type": "header",
      "content": "Desktop image position"
    },

    {
      "type": "range",
      "id": "desktop_image_position_x",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "desktop_image_position_y",
      "label": "Vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Desktop image radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "header",
      "content": "Mobile image"
    },

    {
      "type": "select",
      "id": "mobile_image_ratio",
      "label": "Mobile image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "1:1 Square"
        },
        {
          "value": "4 / 5",
          "label": "4:5 Portrait"
        },
        {
          "value": "3 / 4",
          "label": "3:4 Portrait"
        },
        {
          "value": "16 / 10",
          "label": "16:10 Landscape"
        },
        {
          "value": "16 / 9",
          "label": "16:9 Landscape"
        }
      ],
      "default": "16 / 10"
    },

    {
      "type": "header",
      "content": "Mobile image position"
    },

    {
      "type": "range",
      "id": "mobile_image_position_x",
      "label": "Horizontal position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },

    {
      "type": "range",
      "id": "mobile_image_position_y",
      "label": "Vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 25
    },

    {
      "type": "range",
      "id": "mobile_image_border_radius",
      "label": "Mobile image radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Ko wai au"
    },

    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Kia ora, I'm Dr Jessica</p>"
    },

    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A Registered Clinical Psychologist committed to creating Māori wellbeing resources for everyday people, to help you whakapiki your hauora.</p><p>I make aspects of Te Ao Māori easily accessible for those who need it.</p>"
    },

    {
      "type": "text",
      "id": "signature",
      "label": "Signature line"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Link label",
      "default": "Pānui atu · Read more"
    },

    {
      "type": "url",
      "id": "button_link",
      "label": "Link URL"
    },

    {
      "type": "header",
      "content": "Colours"
    },

    {
      "type": "color",
      "id": "background_color",
      "label": "Section background colour",
      "default": "#1d3323"
    },

    {
      "type": "header",
      "content": "Desktop layout"
    },

    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Image and content gap",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },

    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },

    {
      "type": "header",
      "content": "Heading"
    },

    {
      "type": "range",
      "id": "heading_max_size",
      "label": "Maximum heading size",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 38
    },

    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading bottom spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },

    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "text_margin_bottom",
      "label": "Text bottom spacing",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },

    {
      "type": "header",
      "content": "Signature"
    },

    {
      "type": "range",
      "id": "signature_margin_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 24
    },

    {
      "type": "header",
      "content": "Mobile"
    },

    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Image/content gap",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 32
    },

    {
      "type": "range",
      "id": "small_mobile_gap",
      "label": "Small mobile gap",
      "min": 0,
      "max": 50,
      "step": 1, 
      "unit": "px",
      "default": 24
    },

    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 38
    },

    {
      "type": "range",
      "id": "mobile_text_font_size",
      "label": "Mobile text font size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 11
    },

    {
      "type": "range",
      "id": "mobile_content_padding_top",
      "label": "Mobile content top padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 22
    },

    {
      "type": "range",
      "id": "mobile_content_padding_horizontal",
      "label": "Mobile content side padding",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 16
    },

    {
      "type": "range",
      "id": "mobile_content_padding_bottom",
      "label": "Mobile content bottom padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 0
    },

    {
      "type": "header",
      "content": "Section spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },

    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },

    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }

  ],

  "presets": [
    {
      "name": "Pūkenga About"
    }
  ]
}
{% endschema %}
