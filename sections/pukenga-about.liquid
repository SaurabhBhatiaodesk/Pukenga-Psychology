<section
  class="pukenga-section pukenga-about"
  style="
    --about-bg: {{ section.settings.background_color }};
    --about-desktop-top: {{ section.settings.padding_top }}px;
    --about-desktop-bottom: {{ section.settings.padding_bottom }}px;
    --about-mobile-top: {{ section.settings.mobile_padding_top }}px;
    --about-mobile-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="section">
    <div class="pukenga-container pukenga-about__grid">

      <div class="pukenga-about__content">

        {%- if section.settings.eyebrow != blank -%}
          <p class="pukenga-eyebrow pukenga-about__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="pukenga-heading pukenga-about__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="pukenga-body pukenga-about__text">
            {{ section.settings.text }}
          </div>
        {%- endif -%}

        {%- if section.settings.signature != blank -%}
          <p class="pukenga-about__signature">
            {{ section.settings.signature | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="pukenga-link pukenga-about__link"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}

      </div>


      <div class="pukenga-about__media">

        {%- if section.settings.image != blank -%}

          <img
            class="pukenga-about__image pukenga-about__image--desktop"
            src="{{ section.settings.image | image_url: width: 1400 }}"
            srcset="
              {{ section.settings.image | image_url: width: 600 }} 600w,
              {{ section.settings.image | image_url: width: 900 }} 900w,
              {{ section.settings.image | image_url: width: 1200 }} 1200w,
              {{ section.settings.image | image_url: width: 1400 }} 1400w
            "
            sizes="(min-width: 990px) 50vw, 100vw"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >

        {%- endif -%}


        {%- if section.settings.mobile_image != blank -%}

          <img
            class="pukenga-about__image pukenga-about__image--mobile"
            src="{{ section.settings.mobile_image | image_url: width: 1000 }}"
            srcset="
              {{ section.settings.mobile_image | image_url: width: 500 }} 500w,
              {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
              {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w
            "
            sizes="100vw"
            width="{{ section.settings.mobile_image.width }}"
            height="{{ section.settings.mobile_image.height }}"
            alt="{{ section.settings.mobile_image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >

        {%- elsif section.settings.image != blank -%}

          <img
            class="pukenga-about__image pukenga-about__image--mobile"
            src="{{ section.settings.image | image_url: width: 1000 }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            loading="lazy"
          >

        {%- endif -%}

      </div>

    </div>
  </div>
</section>


<style>

  .pukenga-about {
    width: 100%;
    background: var(--about-bg);

    padding-top: var(--about-desktop-top);
    padding-bottom: var(--about-desktop-bottom);
  }


  .pukenga-about__grid {
    display: flex;
    flex-direction: row;

    gap: {{ section.settings.desktop_gap }}px;

    align-items: {{ section.settings.vertical_alignment }};
  }


  /* DEFAULT:
     CONTENT LEFT
     IMAGE RIGHT
  */

  .pukenga-about__content {
    flex: {{ section.settings.desktop_content_width }};
    order: 1;
    min-width: 0;
  }

  .pukenga-about__media {
    flex: {{ section.settings.desktop_image_width }};
    order: 2;
    min-width: 0;

    overflow: hidden;

    border-radius:
      {{ section.settings.image_border_radius }}px;
  }


  /* REVERSE:
     IMAGE LEFT
     CONTENT RIGHT
  */

  {% if section.settings.desktop_column_reverse %}

    .pukenga-about__content {
      order: 2;
    }

    .pukenga-about__media {
      order: 1;
    }

  {% endif %}


  .pukenga-about__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }


  .pukenga-about__image--desktop {
    display: block;

    aspect-ratio:
      {{ section.settings.desktop_image_ratio }};

    object-position:
      {{ section.settings.desktop_image_position_x }}%
      {{ section.settings.desktop_image_position_y }}%;
  }


  .pukenga-about__image--mobile {
    display: none;
  }


  .pukenga-about__heading {
    font-size:
      {{ section.settings.heading_max_size }}px;

    margin-bottom:
      {{ section.settings.heading_margin_bottom }}px;
  }


  .pukenga-about__text {
    font-size: 15.5px;
    line-height: 1.75;

    opacity: 0.85;

    color: #ece5d4;

    margin-bottom:
      {{ section.settings.text_margin_bottom }}px;
  }


  .pukenga-about__signature {
    font-family:
      var(--pukenga-font-heading, 'Spectral', serif);

    font-style: italic;

    color:
      var(--pukenga-gold, #e0b784);

    margin:
      0 0 {{ section.settings.signature_margin_bottom }}px;
  }


  .pukenga-about__link {
    display: inline-block;
  }


  @media screen and (max-width: 989px) {

    .pukenga-about {
      padding-top: var(--about-mobile-top);
      padding-bottom: var(--about-mobile-bottom);
    }


    .pukenga-about__grid {
      display: flex;
      flex-direction: column;

      gap:
        {{ section.settings.mobile_gap }}px;
    }


    .pukenga-about__media {
      order: 1;

      width: 100%;

      border-radius:
        {{ section.settings.mobile_image_border_radius }}px;
    }


    .pukenga-about__content {
      order: 2;

      width: 100%;

      padding: 44px 26px;
    }


    .pukenga-about__image--desktop {
      display: none;
    }


    .pukenga-about__image--mobile {
      display: block;

      width: 100%;
      height: auto;

      aspect-ratio:
        {{ section.settings.mobile_image_ratio }};

      object-fit: cover;

      object-position:
        {{ section.settings.mobile_image_position_x }}%
        {{ section.settings.mobile_image_position_y }}%;
    }

  }


  @media screen and (max-width: 749px) {

    .pukenga-about {
      padding-top: var(--about-mobile-top);
      padding-bottom: var(--about-mobile-bottom);
    }


    .pukenga-about__grid {
      gap:
        {{ section.settings.small_mobile_gap }}px;
    }


    .pukenga-about__content {
      padding:
        44px 26px;
    }


    .pukenga-about__heading {
      font-size:
        {{ section.settings.mobile_heading_size }}px;

      line-height: 1.12;
    }

  }

</style>


{% schema %}
{
