        },
        {
          "value": "0.9",
          "label": "47%"
        },
        {
          "value": "1",
          "label": "50%"
        },
        {
          "value": "1.1",
          "label": "52%"
        },
        {
          "value": "1.2",
          "label": "55%"
        }
      ],
      "default": "1"
    },

    {
      "type": "select",
      "id": "desktop_image_width",
      "label": "Desktop image width",
      "options": [
        {
          "value": "0.8",
          "label": "45%"
        },
        {
          "value": "0.9",
          "label": "47%"
        },
        {
          "value": "1",
          "label": "50%"
        },
        {
          "value": "1.1",
          "label": "52%"
        },
        {
          "value": "1.2",
          "label": "55%"
