<div class="pukenga-product-rating" {{ block.shopify_attributes }}>

  <div class="pukenga-product-rating__price-wrapper">

    <span class="pukenga-product-rating__price">
      {{ product.price | money }}
    </span>

  </div>


  <div class="pukenga-product-rating__reviews">

    <div
      class="yotpo-widget-instance pukenga-product-rating__yotpo"
      data-yotpo-instance-id="{{ block.settings.yotpo_instance_id }}"
      data-yotpo-product-id="{{ product.id }}"
      data-yotpo-cart-product-id="{{ product.id }}"
      data-yotpo-name="{{ product.title | escape }}"
      data-yotpo-url="{{ shop.url }}{{ product.url }}"
      data-yotpo-image-url="{{ product.featured_image | product_img_url: 'large' | prepend: 'https:' | replace: '?', '%3F' | replace: '&', '%26' }}"
      data-yotpo-price="{{ product.price | divided_by: 100.00 }}"
      data-yotpo-currency="{{ shop.currency }}"
      data-yotpo-description="{{ product.description | escape }}"
      data-yotpo-section-id="{{ template.name }}">
    </div>

    <span
      class="pukenga-product-rating__count"
      data-pukenga-rating-count
      hidden
    ></span>

  </div>

</div>


<style>

.pukenga-product-rating {

  display:flex;
  align-items:center;
  gap:18px;

}


.pukenga-product-rating__price-wrapper {

  display:flex;
  align-items:center;

}


.pukenga-product-rating__price {

  color:{{ block.settings.price_color }};
  font-size:{{ block.settings.price_size }}px;
  font-weight:400;
  line-height:1;

}


.pukenga-product-rating__reviews {

  display:flex;
  align-items:center;
  min-height:22px;
  gap:5px;

}

.pukenga-product-rating__count {

  color:{{ block.settings.count_color }};
  font-size:{{ block.settings.count_size }}px;
  line-height:1;
  white-space:nowrap;

}

.pukenga-product-rating__count:not([hidden]) {

  display:inline-flex;
  align-items:center;

}


@media screen and (max-width:749px){

  .pukenga-product-rating {

    gap:12px;

  }


  .pukenga-product-rating__price {

    font-size:{{ block.settings.mobile_price_size }}px;

  }


  .pukenga-product-rating__count {

    font-size:{{ block.settings.mobile_count_size }}px;

  }

}

</style>

<script>
  (function () {
    const root = document.currentScript.previousElementSibling.previousElementSibling;
    const wrapper = root && root.classList.contains('pukenga-product-rating')
      ? root
      : document.querySelector('.pukenga-product-rating');

    if (!wrapper) return;

    const countEl = wrapper.querySelector('[data-pukenga-rating-count]');
    if (!countEl) return;

    function findReviewCount() {
      const pageText = (document.body && document.body.innerText ? document.body.innerText : '')
        .replace(/\s+/g, ' ')
        .trim();

      const bodyMatch = pageText.match(/based on\s+(\d+)\s+reviews?/i);
      if (bodyMatch && Number(bodyMatch[1]) > 0) {
        return Number(bodyMatch[1]);
      }

      const nodes = document.querySelectorAll('[class*="yotpo"], [data-yotpo-instance-id]');

      for (const node of nodes) {
        if (wrapper.contains(node)) continue;

        const text = (node.textContent || '').replace(/\s+/g, ' ').trim();
        const match = text.match(/based on\s+(\d+)\s+reviews?/i) || text.match(/\((\d+)\s+reviews?\)/i);

        if (match && Number(match[1]) > 0) {
          return Number(match[1]);
        }
      }

      return 0;
    }

    function syncReviewCount() {
      const total = findReviewCount();
      if (!total) return;

      countEl.textContent = '(' + total + ' reviews)';
      countEl.hidden = false;
    }

    syncReviewCount();

    const observer = new MutationObserver(syncReviewCount);
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      characterData: true
    });

    setTimeout(syncReviewCount, 1200);
    setTimeout(syncReviewCount, 3000);

    let attempts = 0;
    const interval = setInterval(function () {
      attempts += 1;
      syncReviewCount();

      if (!countEl.hidden || attempts >= 24) {
        clearInterval(interval);
      }
    }, 500);
  })();
</script>


{% schema %}
{
  "name": "Product Price Review",
  "settings": [

    {
      "type": "text",
      "id": "yotpo_instance_id",
      "label": "Yotpo Rating Instance ID",
      "default": "379774"
    },


    {
      "type": "range",
      "id": "price_size",
      "label": "Desktop price size",
      "min":18,
      "max":60,
      "step":2,
      "unit":"px",
      "default":32
    },


    {
      "type":"range",
      "id":"mobile_price_size",
      "label":"Mobile price size",
      "min":16,
      "max":40,
      "step":2,
      "unit":"px",
      "default":24
    },


    {
      "type":"color",
      "id":"price_color",
      "label":"Price color",
      "default":"#d98b4e"
    },


    {
      "type":"range",
      "id":"count_size",
      "label":"Desktop review count size",
      "min":10,
      "max":24,
      "step":1,
      "unit":"px",
      "default":14
    },


    {
      "type":"range",
      "id":"mobile_count_size",
      "label":"Mobile review count size",
      "min":10,
      "max":22,
      "step":1,
      "unit":"px",
      "default":13
    },


    {
      "type":"color",
      "id":"count_color",
      "label":"Review count color",
      "default":"#f2ecdc"
    }

  ],


  "presets":[
    {
      "name":"Product Price Review"
    }
  ]
}
{% endschema %}
