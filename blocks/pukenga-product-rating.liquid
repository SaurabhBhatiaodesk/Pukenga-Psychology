<div class="pukenga-product-rating" {{ block.shopify_attributes }}>

  <div class="pukenga-product-rating__price-wrapper">

    <span class="pukenga-product-rating__price">
      {{ product.price | money }}
    </span>
    {% if product.compare_at_price > product.price %}
      <span class="pukenga-product-rating__compare-price">
        {{ product.compare_at_price | money }}
      </span>
    {% endif %}

  </div>


  <div class="pukenga-product-rating__reviews">

    <div 
      class="yotpo-widget-instance" 
      data-yotpo-instance-id="{{ block.settings.yotpo_instance_id }}"
      data-yotpo-product-id="{{ product.id }}"
      data-yotpo-section-id="{{ template.name }}">
    </div>

  </div>


</div>



<style>

.pukenga-product-rating {

  display:flex;
  align-items:center;
  gap:18px;

}


.pukenga-product-rating__price-wrapper {

  display:flex;
  align-items:center;
  gap:10px;

}


.pukenga-product-rating__price {

  color:{{ block.settings.price_color }};
  font-size:{{ block.settings.price_size }}px;
  font-weight:400;

}


.pukenga-product-rating__compare-price {

  color:{{ block.settings.compare_price_color }};
  font-size:{{ block.settings.compare_price_size }}px;
  text-decoration:line-through;
  opacity:0.6;

}


.pukenga-product-rating__reviews {

  display:flex;
  align-items:center;

}


/* Yotpo adjustment */

.yotpo-widget-instance {

  display:flex;
  align-items:center;

}



@media screen and (max-width:749px){

  .pukenga-product-rating {

    gap:12px;

  }


  .pukenga-product-rating__price {

    font-size:{{ block.settings.mobile_price_size }}px;

  }


  .pukenga-product-rating__compare-price {

    font-size:{{ block.settings.mobile_compare_price_size }}px;

  }

}

</style>



{% schema %}
{
  "name": "Product Price Review",
  "settings": [

    {
      "type": "text",
      "id": "yotpo_instance_id",
      "label": "Yotpo Instance ID",
      "default": "379774"
    },


    {
      "type": "range",
      "id": "price_size",
      "label": "Desktop price size",
      "min":18,
      "max":60,
      "step":2,
      "unit":"px",
      "default":32
    },


    {
      "type":"range",
      "id":"mobile_price_size",
      "label":"Mobile price size",
      "min":16,
      "max":40,
      "step":2,
      "unit":"px",
      "default":24
    },


    {
      "type":"range",
      "id":"compare_price_size",
      "label":"Desktop compare price size",
      "min":12,
      "max":40,
      "step":2,
      "unit":"px",
      "default":20
    },


    {
      "type":"range",
      "id":"mobile_compare_price_size",
      "label":"Mobile compare price size",
      "min":10,
      "max":30,
      "step":2,
      "unit":"px",
      "default":16
    },


    {
      "type":"color",
      "id":"price_color",
      "label":"Price color",
      "default":"#d98b4e"
    },


    {
      "type":"color",
      "id":"compare_price_color",
      "label":"Compare price color",
      "default":"#f2ecdc"
    }

  ],


  "presets":[
    {
      "name":"Product Price Review"
    }
  ]
}
{% endschema %}