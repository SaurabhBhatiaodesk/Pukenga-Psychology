<div
  id="pukenga-product-rating-{{ block.id }}"
  class="pukenga-product-rating"
  {{ block.shopify_attributes }}
>

  <div class="pukenga-product-rating__price-wrapper">

    <span class="pukenga-product-rating__price">
      {{ product.price | money }}
    </span>

  </div>


  {%- if block.settings.show_yotpo_widget -%}
    <div class="pukenga-product-rating__reviews">

      <div
        class="yotpo-widget-instance pukenga-product-rating__yotpo"
        data-yotpo-instance-id="{{ block.settings.yotpo_instance_id }}"
        data-yotpo-product-id="{{ product.id }}"
        data-yotpo-cart-product-id="{{ product.id }}"
        data-yotpo-name="{{ product.title | escape }}"
        data-yotpo-url="{{ shop.url }}{{ product.url }}"
        {% if product.featured_image != blank %}
        data-yotpo-image-url="{{ product.featured_image | image_url: width: 600 }}"
        {% endif %}
        data-yotpo-description="{{ product.description | strip_html | escape }}"
        data-yotpo-section-id="{{ template.name }}">
      </div>

      {%- if block.settings.show_count_fallback -%}
        <span
          class="pukenga-product-rating__count"
          data-yotpo-review-count
          data-yotpo-app-key="{{ block.settings.yotpo_app_key | escape }}"
          data-yotpo-product-id="{{ product.id }}"
          hidden
        ></span>
      {%- endif -%}

    </div>
  {%- endif -%}


</div>



<style>

.pukenga-product-rating {

  display:flex;
  align-items:center;
  gap:18px;

}


.pukenga-product-rating__price-wrapper {

  display:flex;
  align-items:center;

}


.pukenga-product-rating__price {

  color:{{ block.settings.price_color }};
  font-size:{{ block.settings.price_size }}px;
  font-weight:400;
  line-height:1;

}


.pukenga-product-rating__reviews {

  display:flex;
  align-items:center;

}


.pukenga-product-rating .pukenga-product-rating__yotpo {

  display:flex;
  align-items:center;

}



/* remove extra yotpo spacing */

.pukenga-product-rating .pukenga-product-rating__yotpo > div {

  margin:0 !important;

}

.pukenga-product-rating__count {

  color:{{ block.settings.count_color }};
  font-size:{{ block.settings.count_size }}px;
  line-height:1;
  white-space:nowrap;

}

.pukenga-product-rating__count:not([hidden]) {

  display:inline-flex;
  align-items:center;

}



@media screen and (max-width:749px){

  .pukenga-product-rating {

    gap:12px;

  }


  .pukenga-product-rating__price {

    font-size:{{ block.settings.mobile_price_size }}px;

  }

}

</style>

<script>
  (function () {
    const root = document.getElementById('pukenga-product-rating-{{ block.id }}');
    if (!root) return;

    const count = root.querySelector('[data-yotpo-review-count]');
    if (!count) return;

    const appKey = count.getAttribute('data-yotpo-app-key');
    const productId = count.getAttribute('data-yotpo-product-id');
    if (!appKey || !productId) return;

    fetch('https://api-cdn.yotpo.com/v1/widget/' + encodeURIComponent(appKey) + '/products/' + encodeURIComponent(productId) + '/reviews.json?per_page=1')
      .then(function (response) {
        if (!response.ok) throw new Error('Unable to load Yotpo review count.');
        return response.json();
      })
      .then(function (data) {
        const bottomline = data && data.response && data.response.bottomline;
        const total = bottomline && Number(bottomline.total_review);
        if (!total || total < 1) return;

        count.textContent = '(' + total + ' reviews)';
        count.hidden = false;
      })
      .catch(function () {});
  })();
</script>



{% schema %}
{
  "name": "Product Price Review",
  "settings": [

    {
      "type": "checkbox",
      "id": "show_yotpo_widget",
      "label": "Show Yotpo rating widget",
      "default": true
    },


    {
      "type": "text",
      "id": "yotpo_instance_id",
      "label": "Yotpo Instance ID",
      "default": "379774"
    },


    {
      "type": "checkbox",
      "id": "show_count_fallback",
      "label": "Show review count fallback",
      "default": true
    },


    {
      "type": "text",
      "id": "yotpo_app_key",
      "label": "Yotpo app key",
      "default": "LmBJp2Tmc8izhsGB2HM6BjseonnuA3cQqtS3I7yk"
    },


    {
      "type": "range",
      "id": "price_size",
      "label": "Desktop price size",
      "min":18,
      "max":60,
      "step":2,
      "unit":"px",
      "default":32
    },


    {
      "type":"range",
      "id":"mobile_price_size",
      "label":"Mobile price size",
      "min":16,
      "max":40,
      "step":2,
      "unit":"px",
      "default":24
    },


    {
      "type":"color",
      "id":"price_color",
      "label":"Price color",
      "default":"#d98b4e"
    },


    {
      "type":"range",
      "id":"count_size",
      "label":"Review count size",
      "min":10,
      "max":24,
      "step":1,
      "unit":"px",
      "default":13
    },


    {
      "type":"color",
      "id":"count_color",
      "label":"Review count color",
      "default":"#f2ecdc"
    }

  ],


  "presets":[
    {
      "name":"Product Price Review"
    }
  ]
}
{% endschema %}
