<div
  id="pukenga-product-rating-{{ block.id }}"
  class="pukenga-product-rating"
  {{ block.shopify_attributes }}
>

  <div class="pukenga-product-rating__price-wrapper">

    <span class="pukenga-product-rating__price">
      {{ product.price | money }}
    </span>

  </div>


  {%- if block.settings.show_yotpo_widget -%}
    <div class="pukenga-product-rating__reviews">

      <div
        class="yotpo-widget-instance"
        data-yotpo-instance-id="379775"
        data-yotpo-product-id="{{ product.id }}"
        data-yotpo-name="{{ product.title | escape }}"
        data-yotpo-url="{{ shop.url }}{{ product.url }}"
        data-yotpo-image-url="{{ product.featured_image | product_img_url: 'large' | prepend: 'https:' | replace: '?', '%3F' | replace: '&', '%26' }}"
        data-yotpo-price="{{ product.price | divided_by: 100.00 }}"
        data-yotpo-currency="{{ shop.currency }}"
        data-yotpo-description="{{ product.description | escape }}">
      </div>

    </div>
  {%- endif -%}


</div>



<style>

.pukenga-product-rating {

  display:flex;
  align-items:center;
  gap:18px;

}


.pukenga-product-rating__price-wrapper {

  display:flex;
  align-items:center;

}


.pukenga-product-rating__price {

  color:{{ block.settings.price_color }};
  font-size:{{ block.settings.price_size }}px;
  font-weight:400;
  line-height:1;

}


.pukenga-product-rating__reviews {

  display:flex;
  align-items:center;

}


@media screen and (max-width:749px){

  .pukenga-product-rating {

    gap:12px;

  }


  .pukenga-product-rating__price {

    font-size:{{ block.settings.mobile_price_size }}px;

  }

}

</style>



{% schema %}
{
  "name": "Product Price Review",
  "settings": [

    {
      "type": "checkbox",
      "id": "show_yotpo_widget",
      "label": "Show Yotpo rating widget",
      "default": true
    },

    {
      "type": "range",
      "id": "price_size",
      "label": "Desktop price size",
      "min":18,
      "max":60,
      "step":2,
      "unit":"px",
      "default":32
    },


    {
      "type":"range",
      "id":"mobile_price_size",
      "label":"Mobile price size",
      "min":16,
      "max":40,
      "step":2,
      "unit":"px",
      "default":24
    },


    {
      "type":"color",
      "id":"price_color",
      "label":"Price color",
      "default":"#d98b4e"
    }

  ],


  "presets":[
    {
      "name":"Product Price Review"
    }
  ]
}
{% endschema %}
