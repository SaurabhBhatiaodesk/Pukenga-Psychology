<div
  id="pukenga-product-rating-{{ block.id }}"
  class="pukenga-product-rating"
  {{ block.shopify_attributes }}
>

  <div class="pukenga-product-rating__price-wrapper">

    <span class="pukenga-product-rating__price">
      {{ product.price | money }}
    </span>

  </div>


  {%- if block.settings.show_yotpo_widget -%}
    <div class="pukenga-product-rating__reviews">

      <div
        class="yotpo-widget-instance pukenga-product-rating__yotpo"
        data-yotpo-instance-id="{{ block.settings.yotpo_instance_id }}"
        data-yotpo-product-id="{{ product.id }}"
        data-yotpo-cart-product-id="{{ product.id }}"
        data-yotpo-name="{{ product.title | escape }}"
        data-yotpo-url="{{ shop.url }}{{ product.url }}"
        {% if product.featured_image != blank %}
        data-yotpo-image-url="{{ product.featured_image | image_url: width: 600 }}"
        {% endif %}
        data-yotpo-description="{{ product.description | strip_html | escape }}"
        data-yotpo-section-id="{{ template.name }}">
      </div>

    </div>
  {%- endif -%}


</div>



<style>

.pukenga-product-rating {

  display:flex;
  align-items:center;
  gap:18px;

}


.pukenga-product-rating__price-wrapper {

  display:flex;
  align-items:center;

}


.pukenga-product-rating__price {

  color:{{ block.settings.price_color }};
  font-size:{{ block.settings.price_size }}px;
  font-weight:400;
  line-height:1;

}


.pukenga-product-rating__reviews {

  display:flex;
  align-items:center;

}


.pukenga-product-rating .pukenga-product-rating__yotpo {

  display:flex;
  align-items:center;

}



/* remove extra yotpo spacing */

.pukenga-product-rating .pukenga-product-rating__yotpo > div {

  margin:0 !important;

}

@media screen and (max-width:749px){

  .pukenga-product-rating {

    gap:12px;

  }


  .pukenga-product-rating__price {

    font-size:{{ block.settings.mobile_price_size }}px;

  }

}

</style>



{% schema %}
{
  "name": "Product Price Review",
  "settings": [

    {
      "type": "checkbox",
      "id": "show_yotpo_widget",
      "label": "Show Yotpo rating widget",
      "default": true
    },


    {
      "type": "text",
      "id": "yotpo_instance_id",
      "label": "Yotpo Instance ID",
      "default": "379774"
    },


    {
      "type": "range",
      "id": "price_size",
      "label": "Desktop price size",
      "min":18,
      "max":60,
      "step":2,
      "unit":"px",
      "default":32
    },


    {
      "type":"range",
      "id":"mobile_price_size",
      "label":"Mobile price size",
      "min":16,
      "max":40,
      "step":2,
      "unit":"px",
      "default":24
    },


    {
      "type":"color",
      "id":"price_color",
      "label":"Price color",
      "default":"#d98b4e"
    }

  ],


  "presets":[
    {
      "name":"Product Price Review"
    }
  ]
}
{% endschema %}
