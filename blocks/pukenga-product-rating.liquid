<div
  id="pukenga-product-rating-{{ block.id }}"
  class="pukenga-product-rating"
  {{ block.shopify_attributes }}
>

  <!-- =========================================
       PRICE
  ========================================== -->
  <div class="pukenga-product-rating__price-wrapper">
    <span class="pukenga-product-rating__price">
      {{ product.price | money }}
    </span>
  </div>


  <!-- =========================================
       RATING
  ========================================== -->
  <div class="pukenga-product-rating__reviews">

    <!-- YOTPO STAR RATING -->
    <div
      class="yotpo-widget-instance pukenga-product-rating__yotpo"
      data-yotpo-instance-id="{{ block.settings.yotpo_instance_id }}"
      data-yotpo-product-id="{{ product.id }}"
      data-yotpo-cart-product-id="{{ product.id }}"
      data-yotpo-section-id="{{ template.name }}"
    ></div>


    <!-- CUSTOM REVIEW COUNT -->
    <span
      class="pukenga-product-rating__count"
      data-pukenga-review-count
      hidden
    ></span>

  </div>


  <!-- =========================================
       HIDDEN MAIN YOTPO REVIEWS WIDGET

       This stays in DOM so we can read the
       real "Based on X reviews" count.
  ========================================== -->

  {% if block.settings.yotpo_reviews_instance_id != blank %}
    <div class="pukenga-hidden-yotpo-reviews" aria-hidden="true">

      <div
        class="yotpo-widget-instance"
        data-yotpo-instance-id="{{ block.settings.yotpo_reviews_instance_id }}"
        data-yotpo-product-id="{{ product.id }}"
        data-yotpo-cart-product-id="{{ product.id }}"
        data-yotpo-section-id="{{ template.name }}"
        data-pukenga-main-reviews
      ></div>

    </div>
  {% endif %}

</div>


<style>

  /* ==========================================
     WRAPPER
  ========================================== */

  #pukenga-product-rating-{{ block.id }} {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: {{ block.settings.desktop_gap }}px;
    position: relative;
  }


  /* ==========================================
     PRICE
  ========================================== */

  #pukenga-product-rating-{{ block.id }}
  .pukenga-product-rating__price-wrapper {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }


  #pukenga-product-rating-{{ block.id }}
  .pukenga-product-rating__price {
    color: {{ block.settings.price_color }};
    font-size: {{ block.settings.price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    line-height: 1;
  }


  /* ==========================================
     REVIEWS
  ========================================== */

  #pukenga-product-rating-{{ block.id }}
  .pukenga-product-rating__reviews {
    display: flex;
    align-items: center;
    gap: {{ block.settings.review_gap }}px;
    min-height: 24px;
  }


  /* ==========================================
     YOTPO STARS
  ========================================== */

  #pukenga-product-rating-{{ block.id }}
  .pukenga-product-rating__yotpo {
    display: flex;
    align-items: center;
  }


  /*
    Hide Yotpo's own review count text.

    We only need the stars here because our
    custom count appears separately.
  */

  #pukenga-product-rating-{{ block.id }}
  .pukenga-product-rating__yotpo
  .yotpo-sr-bottom-line-text {
    display: none !important;
  }


  /* ==========================================
     CUSTOM REVIEW COUNT
  ========================================== */

  #pukenga-product-rating-{{ block.id }}
  .pukenga-product-rating__count {
    display: inline-flex;
    align-items: center;

    color: {{ block.settings.review_color }};

    font-size: {{ block.settings.review_size }}px;
    font-weight: 400;

    line-height: 1;
    white-space: nowrap;

    opacity: 1;
    visibility: visible;
  }


  #pukenga-product-rating-{{ block.id }}
  .pukenga-product-rating__count[hidden] {
    display: none !important;
  }


  /* ==========================================
     HIDDEN MAIN YOTPO REVIEWS

     IMPORTANT:
     Do NOT use display:none here.

     Yotpo needs this widget available so
     it can load the actual review data.
  ========================================== */

  #pukenga-product-rating-{{ block.id }}
  .pukenga-hidden-yotpo-reviews {
    position: absolute !important;

    width: 1px !important;
    height: 1px !important;

    overflow: hidden !important;

    opacity: 0 !important;
    visibility: hidden !important;

    pointer-events: none !important;

    left: -9999px !important;
    top: 0 !important;

    margin: 0 !important;
    padding: 0 !important;

    border: 0 !important;
  }


  /* ==========================================
     MOBILE
  ========================================== */

  @media screen and (max-width: 749px) {

    #pukenga-product-rating-{{ block.id }} {
      gap: {{ block.settings.mobile_gap }}px;
    }


    #pukenga-product-rating-{{ block.id }}
    .pukenga-product-rating__price {
      font-size: {{ block.settings.mobile_price_size }}px;
    }


    #pukenga-product-rating-{{ block.id }}
    .pukenga-product-rating__reviews {
      gap: {{ block.settings.mobile_review_gap }}px;
    }


    #pukenga-product-rating-{{ block.id }}
    .pukenga-product-rating__count {
      font-size: {{ block.settings.mobile_review_size }}px;
    }

  }

</style>


<script>
(function () {

  const root = document.getElementById(
    'pukenga-product-rating-{{ block.id }}'
  );

  if (!root) return;


  const starWidget = root.querySelector(
    '.pukenga-product-rating__yotpo'
  );


  const hiddenMainWidget = root.querySelector(
    '[data-pukenga-main-reviews]'
  );


  const countElement = root.querySelector(
    '[data-pukenga-review-count]'
  );


  if (!countElement) return;


  /* ==========================================
     LIQUID / METAFIELD FALLBACK
  ========================================== */

  const metafieldReviewCount =
    {{ product.metafields.yotpo.reviews_count.value | default: product.metafields.yotpo.reviews_count | default: 0 | json }};


  /* ==========================================
     NORMALIZE NUMBER
  ========================================== */

  function normalizeCount(value) {

    if (
      value === null ||
      value === undefined ||
      value === ''
    ) {
      return null;
    }


    const cleaned = String(value)
      .replace(/,/g, '')
      .replace(/[^\d]/g, '')
      .trim();


    if (!cleaned) {
      return null;
    }


    const number = parseInt(cleaned, 10);


    if (
      Number.isNaN(number) ||
      number < 0
    ) {
      return null;
    }


    return number;

  }


  /* ==========================================
     DISPLAY REVIEW COUNT
  ========================================== */

  function showReviewCount(value) {

    const number = normalizeCount(value);


    if (
      number === null ||
      number <= 0
    ) {
      return false;
    }


    countElement.textContent =
      number +
      ' ' +
      (
        number === 1
          ? 'arotakenga · review'
          : 'arotakenga · reviews'
      );


    countElement.hidden = false;


    return true;

  }


  /* ==========================================
     EXTRACT COUNT FROM TEXT
  ========================================== */

  function extractReviewCount(text) {

    if (!text) {
      return null;
    }


    /*
      Example:
      Based on 16 reviews
    */

    let match = text.match(
      /based\s+on\s+([\d,]+)\s+reviews?/i
    );


    if (match && match[1]) {
      return match[1];
    }


    /*
      Example:
      16 Reviews
      16 reviews
      16 review
    */

    match = text.match(
      /([\d,]+)\s+reviews?/i
    );


    if (match && match[1]) {
      return match[1];
    }


    /*
      Example:
      Reviews (16)
    */

    match = text.match(
      /reviews?\s*\(\s*([\d,]+)\s*\)/i
    );


    if (match && match[1]) {
      return match[1];
    }


    return null;

  }


  /* ==========================================
     1. HIDDEN MAIN REVIEWS WIDGET
  ========================================== */

  function getCountFromHiddenMainWidget() {

    if (!hiddenMainWidget) {
      return false;
    }


    const text =
      hiddenMainWidget.textContent || '';


    const count =
      extractReviewCount(text);


    if (count) {
      return showReviewCount(count);
    }


    /*
      Search children because Yotpo can render
      count inside nested elements.
    */

    const elements =
      hiddenMainWidget.querySelectorAll('*');


    for (
      let i = 0;
      i < elements.length;
      i++
    ) {

      const childText =
        elements[i].textContent || '';


      const childCount =
        extractReviewCount(childText);


      if (childCount) {
        return showReviewCount(childCount);
      }

    }


    return false;

  }


  /* ==========================================
     2. FIND EXISTING MAIN YOTPO WIDGET
        ANYWHERE ON PAGE
  ========================================== */

  function getCountFromExistingMainReviews() {

    const selectors = [

      '.yotpo-reviews-main-widget',

      '.yotpo-main-widget',

      '[id*="yotpo-reviews"]',

      '[class*="yotpo-reviews"]',

      '[data-yotpo-element-id]'

    ];


    const checked =
      new Set();


    for (
      let i = 0;
      i < selectors.length;
      i++
    ) {

      const elements =
        document.querySelectorAll(
          selectors[i]
        );


      for (
        let j = 0;
        j < elements.length;
        j++
      ) {

        const element =
          elements[j];


        /*
          Ignore this custom block.
        */

        if (
          element === root ||
          root.contains(element)
        ) {
          continue;
        }


        if (
          checked.has(element)
        ) {
          continue;
        }


        checked.add(element);


        /*
          Use textContent because it still works
          even when parent is visually hidden.
        */

        const text =
          element.textContent || '';


        const count =
          extractReviewCount(text);


        if (count) {

          if (
            showReviewCount(count)
          ) {
            return true;
          }

        }

      }

    }


    return false;

  }


  /* ==========================================
     3. STAR RATING WIDGET COUNT
  ========================================== */

  function getCountFromStarWidget() {

    if (!starWidget) {
      return false;
    }


    const selectors = [

      '.yotpo-sr-bottom-line-text',

      '[class*="bottom-line-text"]',

      '[class*="review-count"]',

      '[class*="reviews-count"]',

      '[aria-label*="review"]'

    ];


    for (
      let i = 0;
      i < selectors.length;
      i++
    ) {

      const elements =
        starWidget.querySelectorAll(
          selectors[i]
        );


      for (
        let j = 0;
        j < elements.length;
        j++
      ) {

        const element =
          elements[j];


        const text = [
          element.textContent || '',
          element.getAttribute('aria-label') || ''
        ].join(' ');


        const count =
          extractReviewCount(text);


        if (count) {

          if (
            showReviewCount(count)
          ) {
            return true;
          }

        }

      }

    }


    /*
      Last check against complete
      Star Widget text.
    */

    const widgetText =
      starWidget.textContent || '';


    const widgetCount =
      extractReviewCount(widgetText);


    if (widgetCount) {
      return showReviewCount(widgetCount);
    }


    return false;

  }


  /* ==========================================
     4. SEARCH YOTPO TEXT ANYWHERE
  ========================================== */

  function getCountFromAnyYotpoElement() {

    const elements =
      document.querySelectorAll(
        '[class*="yotpo"], [id*="yotpo"]'
      );


    for (
      let i = 0;
      i < elements.length;
      i++
    ) {

      const element =
        elements[i];


      const text =
        element.textContent || '';


      const count =
        extractReviewCount(text);


      if (count) {

        if (
          showReviewCount(count)
        ) {
          return true;
        }

      }

    }


    return false;

  }


  /* ==========================================
     5. METAFIELD FALLBACK
  ========================================== */

  function getCountFromMetafield() {

    if (!metafieldReviewCount) {
      return false;
    }


    return showReviewCount(
      metafieldReviewCount
    );

  }


  /* ==========================================
     FIND BEST REVIEW COUNT
  ========================================== */

  function findReviewCount() {

    /*
      Priority 1:
      Hidden Main Yotpo Reviews widget.
    */

    if (
      getCountFromHiddenMainWidget()
    ) {
      return true;
    }


    /*
      Priority 2:
      Any existing Reviews widget elsewhere.
    */

    if (
      getCountFromExistingMainReviews()
    ) {
      return true;
    }


    /*
      Priority 3:
      Star Rating Widget.
    */

    if (
      getCountFromStarWidget()
    ) {
      return true;
    }


    /*
      Priority 4:
      Search Yotpo DOM.
    */

    if (
      getCountFromAnyYotpoElement()
    ) {
      return true;
    }


    /*
      Priority 5:
      Shopify / Yotpo metafield fallback.
    */

    getCountFromMetafield();


    return false;

  }


  /* ==========================================
     FIRST RUN
  ========================================== */

  findReviewCount();


  /* ==========================================
     YOTPO LOADS ASYNC

     Check repeatedly for 20 seconds.
  ========================================== */

  let attempts = 0;

  const maxAttempts = 40;


  const interval =
    window.setInterval(
      function () {

        attempts++;


        findReviewCount();


        if (
          attempts >= maxAttempts
        ) {

          window.clearInterval(
            interval
          );

        }

      },
      500
    );


  /* ==========================================
     WATCH YOTPO DOM CHANGES
  ========================================== */

  let observerTimer;


  const observer =
    new MutationObserver(
      function () {

        window.clearTimeout(
          observerTimer
        );


        observerTimer =
          window.setTimeout(
            function () {

              findReviewCount();

            },
            100
          );

      }
    );


  observer.observe(
    document.body,
    {
      childList: true,
      subtree: true,
      characterData: true
    }
  );


  /* ==========================================
     STOP OBSERVER
  ========================================== */

  window.setTimeout(
    function () {

      observer.disconnect();


      window.clearTimeout(
        observerTimer
      );


      window.clearInterval(
        interval
      );

    },
    20000
  );

})();
</script>


{% schema %}
{
  "name": "Product Price Review",
  "settings": [

    {
      "type": "header",
      "content": "Yotpo"
    },

    {
      "type": "text",
      "id": "yotpo_instance_id",
      "label": "Yotpo Star Rating Instance ID",
      "default": "379774"
    },

    {
      "type": "text",
      "id": "yotpo_reviews_instance_id",
      "label": "Yotpo Main Reviews Instance ID",
      "info": "Add the instance ID of your main Yotpo Reviews widget. It will load invisibly so the real review count can still be retrieved."
    },


    {
      "type": "header",
      "content": "Price"
    },

    {
      "type": "range",
      "id": "price_size",
      "label": "Desktop price size",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },

    {
      "type": "range",
      "id": "mobile_price_size",
      "label": "Mobile price size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },

    {
      "type": "select",
      "id": "price_weight",
      "label": "Price font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },

    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#e0b784"
    },


    {
      "type": "header",
      "content": "Review count"
    },

    {
      "type": "range",
      "id": "review_size",
      "label": "Desktop review count size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },

    {
      "type": "range",
      "id": "mobile_review_size",
      "label": "Mobile review count size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },

    {
      "type": "color",
      "id": "review_color",
      "label": "Review count color",
      "default": "#e0b784"
    },


    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Price and rating gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },

    {
      "type": "range",
      "id": "review_gap",
      "label": "Stars and review count gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },

    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile price and rating gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 12
    },

    {
      "type": "range",
      "id": "mobile_review_gap",
      "label": "Mobile stars and review count gap",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 6
    }

  ],

  "presets": [
    {
      "name": "Product Price Review"
    }
  ]
}
{% endschema %}