<div class="pukenga-product-title">
  {% if product.title != blank %}
    <h1>
      {{ product.title }}
    </h1>
  {% endif %}
</div>


<style>

.pukenga-product-title {
  padding-top: {{ block.settings.padding_top }}px;
  padding-bottom: {{ block.settings.padding_bottom }}px;
}

.pukenga-product-title h1 {
  margin: 0;
  color: {{ block.settings.desktop_color }};
  font-size: {{ block.settings.desktop_title_size }}px;
  line-height: 1.2;
    font-weight: 300;
  font-family: Spectral, serif;
}


@media screen and (max-width: 749px) {

  .pukenga-product-title h1 {
    color: {{ block.settings.mobile_color }};
    font-size: {{ block.settings.mobile_title_size }}px;
  }

}

</style>


{% schema %}
{
  "name": "Custom Product Title",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_title_size",
      "label": "Desktop title size",
      "min": 18,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Mobile title size",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "desktop_color",
      "label": "Desktop title color",
      "default": "#f2ecdc"
    },
    {
      "type": "color",
      "id": "mobile_color",
      "label": "Mobile title color",
      "default": "#f2ecdc"
    }
  ],
  "presets": [
    {
      "name": "Custom Product Title"
    }
  ]
}
{% endschema %}