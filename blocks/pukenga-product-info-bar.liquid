    },
    {
      "type": "textarea",
      "id": "rule_1_tags",
      "label": "Product tags",
      "info": "Enter exact product tags separated by commas. The rule applies when any tag matches."
    },
    {
      "type": "text",
      "id": "rule_1_item_1",
      "label": "First text"
    },
    {
      "type": "text",
      "id": "rule_1_item_2",
      "label": "Second text"
    },
    {
      "type": "text",
      "id": "rule_1_item_3",
      "label": "Third text"
    },
    {
      "type": "header",
      "content": "Product tag rule 2"
    },
    {
      "type": "textarea",
