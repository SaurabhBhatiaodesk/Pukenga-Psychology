{%- assign first_product_tag = product.tags | first -%}

{% if first_product_tag != blank %}

  <div
    class="pukenga-product-tag"
    {{ block.shopify_attributes }}
  >
    <span class="pukenga-product-tag__text">
      {{ first_product_tag }}
    </span>
  </div>

{% endif %}


<style>
  .pukenga-product-tag {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .pukenga-product-tag__text {
    display: inline-block;

    margin: 0;

    color: {{ block.settings.text_color }};

    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};

    line-height: 1.3;

    letter-spacing: 0.28em;

    text-transform: uppercase;
  }


  @media screen and (max-width: 749px) {

    .pukenga-product-tag {
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
    }

    .pukenga-product-tag__text {
      font-size: {{ block.settings.mobile_font_size }}px;
    }

  }
</style>


{% schema %}
{
  "name": "Product Tag",
  "settings": [
    {
      "type": "header",
      "content": "Desktop spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 12
    },

    {
      "type": "header",
      "content": "Mobile spacing"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    },

    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop font size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#f2ecdc"
    }
  ]
}
{% endschema %}