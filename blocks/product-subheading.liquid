<div class="pukenga-seo-description">
  {% if product.metafields.global.description_tag != blank %}
    {{ product.metafields.global.description_tag.value }}
  {% endif %}
</div>

<style>

.pukenga-seo-description {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    font-size: 15.5px;
    line-height: 1.75;
    opacity: 0.85;
    margin-bottom: 0;
}
@media screen and (max-width: 749px) {
  .pukenga-seo-description{
    font-size: 14.5px;
  }
}

</style>


{% schema %}
{
  "name": "SEO Meta Description",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "SEO Meta Description"
    }
  ]
}
{% endschema %}