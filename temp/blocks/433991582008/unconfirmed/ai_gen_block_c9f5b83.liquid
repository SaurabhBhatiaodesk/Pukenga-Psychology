{% doc %}
  @prompt
    create an image with text section that has an option to put image at the left or right part, add a lets chat button that has a transparent box below the text, I cant see the button the words in the button should be visible but the button box must be transparent
    
    add padding top and button, add bottom padding, add option for bold text in heading and an option to adjust heading size
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
  }
  .ai-image-text-{{ ai_gen_id }}__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: {{ block.settings.column_gap }}px;
  }
  .ai-image-text-{{ ai_gen_id }}--image-right .ai-image-text-{{ ai_gen_id }}__media { order: 2; }
  .ai-image-text-{{ ai_gen_id }}--image-right .ai-image-text-{{ ai_gen_id }}__content { order: 1; }
  .ai-image-text-{{ ai_gen_id }}__media { min-width: 0; overflow: hidden; border-radius: {{ block.settings.image_radius }}px; }
  .ai-image-text-{{ ai_gen_id }}__media img,
  .ai-image-text-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .ai-image-text-{{ ai_gen_id }}__placeholder { position: relative; background: #e8e6df; }
  .ai-image-text-{{ ai_gen_id }}__placeholder svg { color: #52564e; }
  .ai-image-text-{{ ai_gen_id }}__empty {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    margin: 0;
    padding: 8px 12px;
    color: #242820;
    background: #f2ecdc;
    font-size: 13px;
    text-align: center;
  }
  .ai-image-text-{{ ai_gen_id }}__content { min-width: 0; padding: 24px; }
  .ai-image-text-{{ ai_gen_id }}__heading {
    margin: 0 0 16px;
    color: inherit;
    font-family: var(--font-heading--family, inherit);
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {% if block.settings.heading_bold %}700{% else %}400{% endif %};
    line-height: 1.15;
  }
  .ai-image-text-{{ ai_gen_id }}__copy { color: inherit; line-height: 1.7; }
  .ai-image-text-{{ ai_gen_id }}__copy > :first-child { margin-top: 0; }
  .ai-image-text-{{ ai_gen_id }}__copy > :last-child { margin-bottom: 0; }
  .ai-image-text-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    padding: 12px 22px;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 40px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }
  .ai-image-text-{{ ai_gen_id }}__link:focus-visible,
  .ai-image-text-{{ ai_gen_id }}__chat:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .ai-image-text-{{ ai_gen_id }}__chat {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: fit-content;
    min-height: 44px;
    margin-top: {{ block.settings.chat_spacing }}px;
    padding: {{ block.settings.chat_padding }}px {{ block.settings.chat_padding | times: 2 }}px;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: {{ block.settings.chat_radius }}px;
    background-color: transparent !important;
    color: {{ block.settings.text_color }} !important;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none !important;
    opacity: 1 !important;
    visibility: visible !important;
  }
  @media screen and (max-width: 749px) {
    .ai-image-text-{{ ai_gen_id }} { width: 100%; }
    .ai-image-text-{{ ai_gen_id }}__inner { grid-template-columns: 1fr; gap: 20px; }
    .ai-image-text-{{ ai_gen_id }}--image-right .ai-image-text-{{ ai_gen_id }}__media,
    .ai-image-text-{{ ai_gen_id }}--image-right .ai-image-text-{{ ai_gen_id }}__content { order: initial; }
    .ai-image-text-{{ ai_gen_id }}__content { padding: 8px 0; }
    .ai-image-text-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | times: 0.75 }}px; }
  }
{% endstyle %}

<div class="ai-image-text-{{ ai_gen_id }}{% if block.settings.image_position == 'right' %} ai-image-text-{{ ai_gen_id }}--image-right{% endif %}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-{{ ai_gen_id }}__inner">
    <div class="ai-image-text-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
      {% else %}
        <div class="ai-image-text-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <p class="ai-image-text-{{ ai_gen_id }}__empty">Add an image to complete this section.</p>
        </div>
      {% endif %}
    </div>
    <div class="ai-image-text-{{ ai_gen_id }}__content">
      {% if block.settings.heading != blank %}<h2 class="ai-image-text-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.text != blank %}<div class="ai-image-text-{{ ai_gen_id }}__copy">{{ block.settings.text }}</div>{% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-image-text-{{ ai_gen_id }}__link" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
      {% if block.settings.chat_label != blank %}
        <a class="ai-image-text-{{ ai_gen_id }}__chat" href="{{ block.settings.chat_link | default: '#' }}">{{ block.settings.chat_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A thoughtful approach to wellbeing" },
    { "type": "checkbox", "id": "heading_bold", "label": "Bold heading", "default": true },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share information about your service, practice, or story. Use this space to help visitors understand how you can support them.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Learn more" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Chat button" },
    { "type": "text", "id": "chat_label", "label": "Button text", "default": "Let's chat" },
    { "type": "url", "id": "chat_link", "label": "Button link" },
    { "type": "range", "id": "chat_spacing", "label": "Space above button", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "chat_padding", "label": "Button padding", "min": 4, "max": 20, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "chat_radius", "label": "Button corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 4 },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 20 },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#16281B" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#F2ECDC" }
  ],
  "presets": [{ "name": "Image with text" }],
  "tag": null,
  "class": "image-with-text-block"
}
{% endschema %}